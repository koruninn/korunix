
# KORUNIX-PYTHON-CACHE
# Python crea estos archivos al ejecutar la interfaz y sus validaciones.
# Son resultados temporales y no forman parte del código de Korunix.
__pycache__/
*.py[cod]

# KORUNIX-BUILD-OUTPUT
# Cargo y Nix generan estas rutas localmente; nunca forman parte del producto.
target/
result
result-*

/target/
