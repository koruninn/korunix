#!/usr/bin/env bash
set -euo pipefail

# Korunix utiliza este script como entrada humana de mantenimiento mientras la
# interfaz gráfica todavía no existe. La GUI futura deberá utilizar el mismo
# modelo y las mismas operaciones, no crear un segundo sistema paralelo.

ROOT="$(
  cd "$(dirname "${BASH_SOURCE[0]}")/.."
  pwd
)"

SYSTEM_PROFILE="/nix/var/nix/profiles/system"

cd "$ROOT"

error() {
  printf "ERROR: %s\n" "$*" >&2
  exit 1
}

aviso() {
  printf "AVISO: %s\n" "$*" >&2
}

hosts_disponibles() {
  local archivo

  for archivo in hosts/*.nix; do
    [[ -e "$archivo" ]] || continue
    basename "$archivo" .nix
  done
}

resolver_host() {
  local solicitado="${KORUNIX_HOST:-}"
  local actual
  local hosts=()

  if [[ -n "$solicitado" ]]; then
    [[ -f "hosts/${solicitado}.nix" ]] \
      || error "No existe hosts/${solicitado}.nix."

    printf "%s\n" "$solicitado"
    return
  fi

  actual="$(hostname 2>/dev/null || true)"

  if [[ -n "$actual" && -f "hosts/${actual}.nix" ]]; then
    printf "%s\n" "$actual"
    return
  fi

  mapfile -t hosts < <(hosts_disponibles)

  if [[ "${#hosts[@]}" -eq 1 ]]; then
    printf "%s\n" "${hosts[0]}"
    return
  fi

  error "No pude decidir qué host usar. Define KORUNIX_HOST. Disponibles: ${hosts[*]:-ninguno}."
}

HOST="$(resolver_host)"

confirmar() {
  local mensaje="$1"
  local respuesta

  [[ -t 0 ]] || error "Esta operación necesita confirmación interactiva."

  printf "%s [s/N] " "$mensaje"
  read -r respuesta

  case "$respuesta" in
    s|S|si|Si|SI|sí|Sí|SÍ)
      return 0
      ;;
    *)
      echo "Operación cancelada."
      return 1
      ;;
  esac
}

estructura() {
  find . \
    -mindepth 1 \
    -maxdepth 3 \
    ! -path "./.git" \
    ! -path "./.git/*" \
    -print \
    | sort
}

validar_estructura() {
  local rutas_antiguas=(
    "hosts/korunix/configuration.nix"
    "users/koru/home.nix"
    "modules/nixos"
    "modules/home"
    "modules/korunix"
    "config/niri.nix"
    "config/fastfetch.nix"
    "config/spicetify.nix"
    "config/noctalia/noctalia.nix"
    "config/noctalia/settings"
  )
  local ruta

  for ruta in "${rutas_antiguas[@]}"; do
    [[ ! -e "$ruta" ]] \
      || error "Quedó una ruta retirada por la arquitectura nueva: $ruta"
  done

  if grep -RInE \
    --include="*.nix" \
    --include="*.sh" \
    --include="justfile" \
    "home-manager|homeConfigurations|home-legacy" \
    flake.nix hosts hardware modules users config scripts justfile \
    >/tmp/korunix-home-manager-restos.txt 2>/dev/null; then

    cat /tmp/korunix-home-manager-restos.txt
    error "Quedaron referencias ejecutables a Home Manager."
  fi

  local host_id

  while IFS= read -r host_id; do
    [[ -f "hardware/${host_id}.nix" ]] \
      || error "Falta hardware/${host_id}.nix."
  done < <(hosts_disponibles)
}

validar() {
  local host_id

  echo
  echo "=== Estructura ==="
  validar_estructura
  echo "✓ estructura"

  echo
  echo "=== Git ==="
  git diff --check
  git diff --cached --check
  echo "✓ diferencias"

  echo
  echo "=== Flake ==="
  nix flake check --no-build --show-trace

  echo
  echo "=== Hosts ==="

  while IFS= read -r host_id; do
    printf "• %s: " "$host_id"

    nix eval \
      ".#nixosConfigurations.${host_id}.config.system.build.toplevel.drvPath" \
      --raw

    echo
  done < <(hosts_disponibles)

  echo
  echo "=== Modelo Korunix · ${HOST} ==="
  nix eval ".#nixosConfigurations.${HOST}.config.korunix" --json
  echo

  echo
  echo "✓ VALIDACIÓN COMPLETA"
}

formatear() {
  mapfile -d "" archivos < <(
    find . \
      -path "./.git" -prune -o \
      -type f -name "*.nix" -print0
  )

  if [[ "${#archivos[@]}" -gt 0 ]]; then
    nix fmt "${archivos[@]}"
  fi
}

ruta_actual() {
  readlink -f /run/current-system 2>/dev/null || true
}

ruta_predeterminada() {
  readlink -f "$SYSTEM_PROFILE" 2>/dev/null || true
}

generacion_predeterminada() {
  local referencia

  referencia="$(readlink "$SYSTEM_PROFILE" 2>/dev/null || true)"

  if [[ "$referencia" =~ system-([0-9]+)-link$ ]]; then
    printf "%s\n" "${BASH_REMATCH[1]}"
  fi
}

numeros_generaciones() {
  local enlace
  local nombre

  for enlace in "${SYSTEM_PROFILE}"-*-link; do
    [[ -e "$enlace" ]] || continue

    nombre="$(basename "$enlace")"

    if [[ "$nombre" =~ ^system-([0-9]+)-link$ ]]; then
      printf "%s\n" "${BASH_REMATCH[1]}"
    fi
  done | sort -n
}

ruta_generacion() {
  local generacion="$1"

  readlink -f "${SYSTEM_PROFILE}-${generacion}-link" 2>/dev/null || true
}


generacion_de_ruta() {
  local buscada="$1"
  local predeterminada
  local generacion
  local ruta
  local ultima=""

  # Varias generaciones pueden apuntar al mismo sistema exacto. Si la
  # predeterminada coincide con el sistema que está ejecutándose, ese es el
  # número más humano y menos ambiguo que debemos mostrar.
  predeterminada="$(generacion_predeterminada)"

  if [[ -n "$predeterminada" ]]; then
    ruta="$(ruta_generacion "$predeterminada")"

    if [[ -n "$ruta" && "$ruta" == "$buscada" ]]; then
      printf "%s
" "$predeterminada"
      return
    fi
  fi

  # Si la generación predeterminada no coincide, elegimos la coincidencia más
  # reciente en lugar de atribuir el sistema a una generación antigua idéntica.
  while IFS= read -r generacion; do
    ruta="$(ruta_generacion "$generacion")"

    if [[ -n "$ruta" && "$ruta" == "$buscada" ]]; then
      ultima="$generacion"
    fi
  done < <(numeros_generaciones)

  [[ -n "$ultima" ]] && printf "%s
" "$ultima"
}

mostrar_generaciones() {
  local limite="${1:-0}"
  local actual
  local predeterminada
  local generacion_actual
  local generacion
  local enlace
  local ruta
  local fecha
  local estado
  local inicio=0
  local generaciones=()

  actual="$(ruta_actual)"
  predeterminada="$(generacion_predeterminada)"
  generacion_actual="$(generacion_de_ruta "$actual")"

  mapfile -t generaciones < <(numeros_generaciones)

  if [[ "$limite" -gt 0 && "${#generaciones[@]}" -gt "$limite" ]]; then
    inicio=$((${#generaciones[@]} - limite))
    generaciones=("${generaciones[@]:$inicio}")
  fi

  printf "%-6s %-19s %-28s\n" "ID" "FECHA" "ESTADO"
  printf "%-6s %-19s %-28s\n" "----" "-------------------" "----------------------------"

  for generacion in "${generaciones[@]}"; do
    enlace="${SYSTEM_PROFILE}-${generacion}-link"
    ruta="$(ruta_generacion "$generacion")"
    fecha="$(stat -c "%y" "$enlace" 2>/dev/null | cut -d"." -f1)"
    estado=""

    if [[ "$generacion" == "$generacion_actual" ]]; then
      estado="ACTUAL"
    fi

    if [[ "$generacion" == "$predeterminada" ]]; then
      if [[ -n "$estado" ]]; then
        estado="${estado}, PREDETERMINADO"
      else
        estado="PREDETERMINADO"
      fi
    fi

    [[ -n "$estado" ]] || estado="disponible"

    printf "%-6s %-19s %-28s\n" \
      "$generacion" \
      "$fecha" \
      "$estado"

    # La ruta no se imprime normalmente para mantener la vista humana. Sigue
    # disponible mediante el enlace system-N-link cuando haga falta diagnosticar.
    : "$ruta"
  done
}


# Lee un valor DMI sin saltos ni espacios residuales. En equipos sin DMI,
# como determinadas máquinas ARM, devuelve vacío y la detección degrada
# limpiamente en lugar de inventar información.
# Devuelve el UID mínimo configurado para cuentas humanas. Korunix no decide que
# todo UID alto sea una persona: después se filtran homes y shells técnicos.
uid_minimo() {
  local valor=1000
  local linea

  if [[ -r /etc/login.defs ]]; then
    while IFS= read -r linea; do
      if [[ "$linea" =~ ^[[:space:]]*UID_MIN[[:space:]]+([0-9]+) ]]; then
        valor="${BASH_REMATCH[1]}"
        break
      fi
    done < /etc/login.defs
  fi

  printf '%s\n' "$valor"
}

es_cuenta_tecnica() {
  local home="$1"
  local shell="$2"

  [[ "$home" == "/var/empty" ]] && return 0
  [[ "$home" == /run/gdm/* ]] && return 0
  [[ "$shell" == *nologin ]] && return 0
  [[ "$shell" == *false ]] && return 0

  return 1
}

cuenta_humana_existente() {
  local cuenta="$1"
  local entrada
  local uid
  local home
  local shell
  local minimo

  entrada="$(getent passwd "$cuenta" 2>/dev/null || true)"
  [[ -n "$entrada" ]] || return 1

  IFS=: read -r _ _ uid _ _ home shell <<<"$entrada"

  [[ "$uid" =~ ^[0-9]+$ ]] || return 1

  minimo="$(uid_minimo)"

  (( uid >= minimo && uid < 65534 )) || return 1

  if es_cuenta_tecnica "$home" "$shell"; then
    return 1
  fi

  return 0
}

perfil_por_cuenta() {
  local buscada="$1"
  local perfil
  local id_usuario
  local cuenta
  local perfiles=()

  shopt -s nullglob
  perfiles=(users/*.nix)

  for perfil in "${perfiles[@]}"; do
    id_usuario="$(basename "$perfil" .nix)"

    cuenta="$(
      nix eval \
        --impure \
        --raw \
        --expr "
          let u = import ./$perfil;
          in u.accountName or \"$id_usuario\"
        "
    )"

    if [[ "$cuenta" == "$buscada" ]]; then
      printf '%s\n' "$id_usuario"
      return
    fi
  done
}

perfil_asignado_al_host() {
  local id_usuario="$1"

  nix eval \
    ".#nixosConfigurations.${HOST}.config.korunix.users" \
    --json \
    | jq -e \
        --arg id "$id_usuario" \
        'index($id) != null' \
        >/dev/null
}

usuarios_detectados_json() {
  local jq_bin
  local tmpdir
  local perfiles_tmp
  local cuentas_tmp
  local host_users_json
  local mutable_users
  local perfil
  local id_usuario
  local base
  local cuenta
  local asignado
  local existe
  local grupos_declarados
  local perfiles_json
  local cuentas_json
  local minimo
  local entrada
  local uid
  local nombre
  local home
  local shell
  local grupos_texto
  local grupos_json
  local administrador
  local perfil_json
  local perfil_id
  local estado
  local detectados_admin
  local declarados_admin

  jq_bin="$(command -v jq 2>/dev/null || true)"

  [[ -n "$jq_bin" ]] \
    || error "jq no está disponible para construir el modelo de usuarios."

  tmpdir="$(mktemp -d)"
  perfiles_tmp="$tmpdir/perfiles.jsonl"
  cuentas_tmp="$tmpdir/cuentas.jsonl"

  : > "$perfiles_tmp"
  : > "$cuentas_tmp"

  host_users_json="$(
    nix eval \
      ".#nixosConfigurations.${HOST}.config.korunix.users" \
      --json
  )"

  mutable_users="$(
    nix eval \
      ".#nixosConfigurations.${HOST}.config.users.mutableUsers" \
      --json
  )"

  shopt -s nullglob
  local archivos=(users/*.nix)

  for perfil in "${archivos[@]}"; do
    id_usuario="$(basename "$perfil" .nix)"

    base="$(
      nix eval \
        --impure \
        --json \
        --expr "
          let
            u = import ./$perfil;
          in {
            id = \"$id_usuario\";
            accountName = u.accountName or \"$id_usuario\";
            fullName = u.fullName or \"\";
            homeDirectory = u.homeDirectory or \"\";
            language = u.language or null;
            administrator = u.administrator or false;
            capabilities = u.capabilities or [];
            preservedGroups = u.preservedGroups or [];
            hasAvatar = (u.avatar or null) != null;
          }
        "
    )"

    cuenta="$("$jq_bin" -r '.accountName' <<<"$base")"

    asignado=false
    if "$jq_bin" -e \
        --arg id "$id_usuario" \
        'index($id) != null' \
        <<<"$host_users_json" \
        >/dev/null
    then
      asignado=true
    fi

    existe=false
    if getent passwd "$cuenta" >/dev/null 2>&1; then
      existe=true
    fi

    grupos_declarados='[]'

    if [[ "$asignado" == true ]]; then
      grupos_declarados="$(
        nix eval \
          ".#nixosConfigurations.${HOST}.config.users.users.\"${cuenta}\".extraGroups" \
          --json \
          2>/dev/null \
          || printf '[]'
      )"
    fi

    "$jq_bin" -c \
      --argjson assignedToHost "$asignado" \
      --argjson accountExists "$existe" \
      --argjson declaredGroups "$grupos_declarados" \
      '
        . + {
          assignedToHost: $assignedToHost,
          accountExists: $accountExists,
          declaredGroups: $declaredGroups
        }
      ' \
      <<<"$base" \
      >> "$perfiles_tmp"
  done

  perfiles_json="$("$jq_bin" -s '.' "$perfiles_tmp")"

  minimo="$(uid_minimo)"

  while IFS=: read -r cuenta _ uid _ nombre home shell; do
    [[ "$uid" =~ ^[0-9]+$ ]] || continue
    (( uid >= minimo && uid < 65534 )) || continue

    if es_cuenta_tecnica "$home" "$shell"; then
      continue
    fi

    nombre="${nombre%%,*}"
    [[ -n "$nombre" ]] || nombre="$cuenta"

    grupos_texto="$(id -nG "$cuenta" 2>/dev/null || true)"

    grupos_json="$(
      "$jq_bin" -Rn \
        --arg groups "$grupos_texto" \
        '$groups | split(" ") | map(select(length > 0)) | unique'
    )"

    administrador=false

    if "$jq_bin" -e 'index("wheel") != null' \
        <<<"$grupos_json" \
        >/dev/null
    then
      administrador=true
    fi

    perfil_json="$(
      "$jq_bin" -c \
        --arg account "$cuenta" \
        'map(select(.accountName == $account)) | first // null' \
        <<<"$perfiles_json"
    )"

    perfil_id=""
    estado="adoptable"

    if [[ "$perfil_json" != "null" ]]; then
      perfil_id="$("$jq_bin" -r '.id' <<<"$perfil_json")"

      if "$jq_bin" -e '.assignedToHost' \
          <<<"$perfil_json" \
          >/dev/null
      then
        estado="adopted"
      else
        estado="profile-available"
      fi
    fi

    "$jq_bin" -c -n \
      --arg accountName "$cuenta" \
      --arg displayName "$nombre" \
      --argjson uid "$uid" \
      --arg home "$home" \
      --arg shell "$shell" \
      --argjson administrator "$administrador" \
      --argjson groups "$grupos_json" \
      --arg profileId "$perfil_id" \
      --arg status "$estado" \
      '{
        accountName: $accountName,
        displayName: $displayName,
        uid: $uid,
        home: $home,
        shell: $shell,
        administrator: $administrator,
        groups: $groups,
        profileId:
          if $profileId == ""
          then null
          else $profileId
          end,
        status: $status
      }' \
      >> "$cuentas_tmp"
  done < <(getent passwd)

  cuentas_json="$("$jq_bin" -s '.' "$cuentas_tmp")"

  detectados_admin="$(
    "$jq_bin" \
      '[.[] | select(.administrator)] | length' \
      <<<"$cuentas_json"
  )"

  declarados_admin="$(
    "$jq_bin" \
      '[.[] | select(.assignedToHost and .administrator)] | length' \
      <<<"$perfiles_json"
  )"

  "$jq_bin" -n \
    --argjson schemaVersion 1 \
    --arg hostId "$HOST" \
    --arg detectedAt "$(date --iso-8601=seconds)" \
    --argjson accounts "$cuentas_json" \
    --argjson profiles "$perfiles_json" \
    --argjson hostUserIds "$host_users_json" \
    --argjson mutableUsers "$mutable_users" \
    --argjson detectedAdministrators "$detectados_admin" \
    --argjson declaredAdministrators "$declarados_admin" \
    '{
      schemaVersion: $schemaVersion,
      hostId: $hostId,
      detectedAt: $detectedAt,

      accounts: $accounts,
      profiles: $profiles,

      summary: {
        humanAccounts: ($accounts | length),
        adoptedAccounts:
          ($accounts | map(select(.status == "adopted")) | length),
        adoptableAccounts:
          ($accounts | map(select(.status == "adoptable")) | length),
        detectedAdministrators: $detectedAdministrators,
        declaredAdministrators: $declaredAdministrators
      },

      hostUserIds: $hostUserIds,

      policy: {
        mutableUsers: $mutableUsers,
        preserveExistingPasswords: true,
        repositoryStoresPasswords: false,
        newPasswordMethod: "system-passwd",
        androidAccessModel: "systemd-uaccess"
      }
    }'

  rm -rf "$tmpdir"
}

mostrar_usuarios() {
  local modo="${1:-}"
  local datos
  local cuenta
  local nombre
  local estado
  local administrador
  local etiqueta
  local rol

  case "$modo" in
    "")
      ;;
    --json)
      usuarios_detectados_json
      return
      ;;
    *)
      error "Uso: scripts/korunix users [--json|adopt|create|password]."
      ;;
  esac

  datos="$(usuarios_detectados_json)"

  echo "=== Personas detectadas ==="

  while IFS=$'\t' read -r cuenta nombre estado administrador; do
    case "$estado" in
      adopted)
        etiqueta="Administrada por Korunix"
        ;;
      profile-available)
        etiqueta="Perfil disponible para este equipo"
        ;;
      adoptable)
        etiqueta="Se puede adoptar"
        ;;
      *)
        etiqueta="$estado"
        ;;
    esac

    if [[ "$administrador" == true ]]; then
      rol="Administrador"
    else
      rol="Usuario estándar"
    fi

    echo "• $nombre — $cuenta"
    echo "  $rol · $etiqueta"
  done < <(
    jq -r '
      .accounts[]
      | [
          .accountName,
          .displayName,
          .status,
          (.administrator | tostring)
        ]
      | @tsv
    ' <<<"$datos"
  )

  echo
  echo "=== Perfiles asignados a este equipo ==="

  jq -r '
    .profiles[]
    | select(.assignedToHost)
    | (
        "• "
        + .fullName
        + " — "
        + .accountName
        + "\n  Capacidades: "
        + (
            if (.capabilities | length) == 0
            then "ninguna"
            else (.capabilities | join(", "))
            end
          )
        + "\n  Grupos derivados: "
        + (
            if (.declaredGroups | length) == 0
            then "ninguno"
            else (.declaredGroups | join(", "))
            end
          )
        + (
            if .accountExists
            then ""
            else "\n  Estado: pendiente de creación"
            end
          )
      )
  ' <<<"$datos"

  echo
  echo "=== Capacidades del sistema ==="

  if jq -e '
      .profiles
      | any(.assignedToHost and (.capabilities | index("android") != null))
    ' <<<"$datos" >/dev/null
  then
    echo "Android: android-tools + acceso automático de systemd (uaccess)"
    echo "No necesita un grupo adbusers."
  fi

  echo
  echo "=== Seguridad administrativa ==="
  echo "Administradores reales: $(jq -r '.summary.detectedAdministrators' <<<"$datos")"
  echo "Administradores declarados: $(jq -r '.summary.declaredAdministrators' <<<"$datos")"

  if jq -e \
      '.summary.detectedAdministrators >= 1
       and .summary.declaredAdministrators >= 1' \
      <<<"$datos" \
      >/dev/null
  then
    echo "✓ existe una ruta administrativa funcional y declarada"
  else
    echo "AVISO: la seguridad administrativa necesita atención"
  fi

  echo
  echo "=== Credenciales ==="
  echo "Las contraseñas existentes se preservan."
  echo "Las contraseñas nuevas se entregan directamente al sistema mediante passwd."
  echo "Korunix no guarda contraseñas ni hashes en el repositorio."
}

validar_nombre_cuenta() {
  local cuenta="$1"

  [[ "$cuenta" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] \
    || error "La cuenta debe usar minúsculas, números, _ o -, empezar por letra/_ y tener como máximo 32 caracteres."
}

nix_string() {
  local valor="$1"

  jq -Rn \
    --arg valor "$valor" \
    '$valor'
}

agregar_perfil_al_host() {
  local id_usuario="$1"
  local archivo="hosts/${HOST}.nix"
  local tmp

  [[ -f "$archivo" ]] \
    || error "No existe $archivo."

  tmp="$(mktemp)"

  if ! awk -v id="$id_usuario" '
      /^[[:space:]]*users[[:space:]]*=[[:space:]]*\[/ && !dentro {
        dentro = 1
        print
        next
      }

      dentro && /^[[:space:]]*\];/ && !insertado {
        print "    \"" id "\""
        insertado = 1
        dentro = 0
      }

      {
        print
      }

      END {
        if (!insertado) {
          exit 42
        }
      }
    ' "$archivo" > "$tmp"
  then
    rm -f "$tmp"
    error "No pude añadir el perfil a $archivo."
  fi

  chmod --reference="$archivo" "$tmp"
  mv "$tmp" "$archivo"
}

escribir_perfil_nuevo() {
  local archivo="$1"
  local cuenta="$2"
  local nombre="$3"
  local home="$4"
  local idioma="$5"
  local administrador="$6"

  cat > "$archivo" <<EOF_PROFILE
{
  # Identidad humana. La contraseña no vive aquí: la cuenta se crea inicialmente
  # sin una credencial exportable y el secreto se entrega directamente a passwd.
  accountName = $(nix_string "$cuenta");
  fullName = $(nix_string "$nombre");
  homeDirectory = $(nix_string "$home");
  language = $(nix_string "$idioma");

  administrator = $administrador;

  # Las capacidades se eligen por intención humana, no como una lista de grupos.
  capabilities = [];
}
EOF_PROFILE
}

escribir_perfil_adoptado() {
  local archivo="$1"
  local cuenta="$2"
  local nombre="$3"
  local home="$4"
  local idioma="$5"
  local administrador="$6"
  shift 6

  local grupos=("$@")
  local grupo

  {
    cat <<EOF_PROFILE
{
  # Esta identidad ya existía antes de ser administrada por Korunix. Su
  # contraseña actual se conserva y nunca se copia al repositorio.
  accountName = $(nix_string "$cuenta");
  fullName = $(nix_string "$nombre");
  homeDirectory = $(nix_string "$home");
  language = $(nix_string "$idioma");

  administrator = $administrador;

  # Korunix no adivina intenciones humanas a partir de grupos existentes.
  capabilities = [];

  # Estos grupos se encontraron durante la adopción y se conservan para no
  # retirar permisos que otra herramienta o configuración pudiera necesitar.
  # La interfaz normal no los presenta como decisiones primarias.
  preservedGroups = [
EOF_PROFILE

    for grupo in "${grupos[@]}"; do
      printf '    %s\n' "$(nix_string "$grupo")"
    done

    cat <<'EOF_PROFILE'
  ];
}
EOF_PROFILE
  } > "$archivo"
}

validar_y_construir_identidad() {
  (
    validar

    nix build \
      ".#nixosConfigurations.${HOST}.config.system.build.toplevel" \
      --no-link
  )
}

adoptar_usuario() {
  local cuenta="${1:-}"
  local perfil_id
  local perfil
  local host_file
  local backup_host
  local perfil_creado=false
  local entrada
  local nombre
  local home
  local administrador=false
  local idioma
  local grupo
  local grupos_preservados=()

  [[ -n "$cuenta" ]] \
    || error "Uso: scripts/korunix users adopt <cuenta>."

  validar_nombre_cuenta "$cuenta"

  [[ -z "$(git status --porcelain)" ]] \
    || error "La adopción necesita un repositorio limpio para poder revertirse con seguridad."

  cuenta_humana_existente "$cuenta" \
    || error "$cuenta no es una cuenta humana interactiva detectable."

  perfil_id="$(perfil_por_cuenta "$cuenta")"

  if [[ -n "$perfil_id" ]] && perfil_asignado_al_host "$perfil_id"; then
    error "$cuenta ya está administrada por este host."
  fi

  entrada="$(getent passwd "$cuenta")"
  IFS=: read -r _ _ _ _ nombre home _ <<<"$entrada"
  nombre="${nombre%%,*}"
  [[ -n "$nombre" ]] || nombre="$cuenta"

  if id -nG "$cuenta" \
      | tr ' ' '\n' \
      | grep -qx wheel
  then
    administrador=true
  fi

  idioma="$(
    nix eval \
      ".#nixosConfigurations.${HOST}.config.korunix.localization.language" \
      --raw
  )"

  if [[ -z "$perfil_id" ]]; then
    perfil_id="$cuenta"
    perfil="users/${perfil_id}.nix"

    [[ ! -e "$perfil" ]] \
      || error "$perfil ya existe y no corresponde inequívocamente a $cuenta."

    for grupo in $(id -nG "$cuenta"); do
      case "$grupo" in
        users|wheel|networkmanager)
          ;;
        *)
          grupos_preservados+=("$grupo")
          ;;
      esac
    done
  else
    perfil="users/${perfil_id}.nix"
  fi

  echo "Cuenta existente: $cuenta"
  echo "Perfil Korunix: $perfil_id"
  echo "Contraseña: se conservará sin leerla ni modificarla"
  echo "Shell al aplicar Korunix: Fish"

  confirmar "¿Preparar la adopción de $cuenta?" \
    || return 0

  host_file="hosts/${HOST}.nix"
  backup_host="$(mktemp)"
  cp -a "$host_file" "$backup_host"

  if [[ ! -e "$perfil" ]]; then
    escribir_perfil_adoptado \
      "$perfil" \
      "$cuenta" \
      "$nombre" \
      "$home" \
      "$idioma" \
      "$administrador" \
      "${grupos_preservados[@]}"

    git add "$perfil"
    perfil_creado=true
  fi

  agregar_perfil_al_host "$perfil_id"

  if ! validar_y_construir_identidad; then
    echo "La adopción no pasó validación. Restaurando configuración..." >&2

    cp -a "$backup_host" "$host_file"

    if [[ "$perfil_creado" == true ]]; then
      git reset -q -- "$perfil" 2>/dev/null || true
      rm -f "$perfil"
    fi

    rm -f "$backup_host"
    error "La adopción fue revertida antes de aplicar el sistema."
  fi

  rm -f "$backup_host"

  echo
  echo "✓ adopción preparada y construida"
  echo "✓ la contraseña existente no fue consultada ni modificada"
  echo
  echo "Todavía no se modificó el sistema."
  echo "Revisa la previsualización y usa scripts/korunix apply cuando quieras activarla."

  git status --short
}

crear_usuario() {
  local cuenta
  local nombre
  local rol
  local administrador=false
  local idioma
  local home
  local perfil
  local host_file
  local backup_host

  [[ -t 0 ]] \
    || error "La creación de una persona necesita una terminal interactiva."

  [[ -z "$(git status --porcelain)" ]] \
    || error "La creación necesita un repositorio limpio para poder revertirse con seguridad."

  printf "Nombre de cuenta UNIX: "
  read -r cuenta

  validar_nombre_cuenta "$cuenta"

  if getent passwd "$cuenta" >/dev/null 2>&1; then
    error "$cuenta ya existe. Usa: scripts/korunix users adopt $cuenta"
  fi

  perfil="users/${cuenta}.nix"

  [[ ! -e "$perfil" ]] \
    || error "$perfil ya existe. No voy a sobrescribir una identidad portable."

  printf "Nombre visible: "
  read -r nombre
  [[ -n "$nombre" ]] || nombre="$cuenta"

  echo "Rol:"
  echo "  a = Administrador"
  echo "  e = Usuario estándar"
  printf "Elegir [e]: "
  read -r rol

  case "$rol" in
    a|A)
      administrador=true
      ;;
    ""|e|E)
      administrador=false
      ;;
    *)
      error "Rol no reconocido."
      ;;
  esac

  idioma="$(
    nix eval \
      ".#nixosConfigurations.${HOST}.config.korunix.localization.language" \
      --raw
  )"

  home="/home/${cuenta}"

  echo
  echo "Cuenta: $cuenta"
  echo "Nombre: $nombre"

  if [[ "$administrador" == true ]]; then
    echo "Rol: Administrador"
  else
    echo "Rol: Usuario estándar"
  fi

  echo "Home: $home"
  echo "Contraseña: se establecerá después mediante passwd y nunca entrará en Git"

  confirmar "¿Preparar esta cuenta?" \
    || return 0

  host_file="hosts/${HOST}.nix"
  backup_host="$(mktemp)"
  cp -a "$host_file" "$backup_host"

  escribir_perfil_nuevo \
    "$perfil" \
    "$cuenta" \
    "$nombre" \
    "$home" \
    "$idioma" \
    "$administrador"

  # Los flakes basados en Git solo ven archivos nuevos registrados en el índice.
  # Esto prepara el archivo para evaluación; todavía NO crea ningún commit.
  git add "$perfil"

  agregar_perfil_al_host "$cuenta"

  if ! validar_y_construir_identidad; then
    echo "La cuenta propuesta no pasó validación. Restaurando..." >&2

    cp -a "$backup_host" "$host_file"
    git reset -q -- "$perfil" 2>/dev/null || true
    rm -f "$perfil"
    rm -f "$backup_host"

    error "La creación fue revertida antes de aplicar el sistema."
  fi

  rm -f "$backup_host"

  echo
  echo "✓ identidad preparada y construida"
  echo "✓ todavía no existe ninguna contraseña en Git ni en el Nix store"
  echo
  echo "Siguiente flujo:"
  echo "  1. scripts/korunix preview"
  echo "  2. scripts/korunix apply"
  echo "  3. scripts/korunix users password $cuenta"
  echo
  echo "La cuenta no podrá iniciar sesión mediante contraseña hasta completar el paso 3."

  git status --short
}

cambiar_password_usuario() {
  local cuenta="${1:-}"
  local perfil_id

  [[ -n "$cuenta" ]] \
    || error "Uso: scripts/korunix users password <cuenta>."

  validar_nombre_cuenta "$cuenta"

  cuenta_humana_existente "$cuenta" \
    || error "$cuenta no existe como cuenta humana interactiva."

  perfil_id="$(perfil_por_cuenta "$cuenta")"

  [[ -n "$perfil_id" ]] \
    || error "$cuenta no tiene un perfil Korunix."

  perfil_asignado_al_host "$perfil_id" \
    || error "El perfil $perfil_id no pertenece a este host."

  echo "Korunix entregará el control directamente a passwd."
  echo "La contraseña no pasa por variables, archivos del repo ni argumentos."

  confirmar "¿Cambiar la contraseña de $cuenta?" \
    || return 0

  sudo passwd "$cuenta"

  echo
  echo "✓ contraseña administrada por el sistema"
  echo "✓ Korunix no almacenó la contraseña ni su hash"
}

operacion_usuarios() {
  local accion="${1:-}"

  case "$accion" in
    "")
      mostrar_usuarios
      ;;
    --json)
      mostrar_usuarios --json
      ;;
    adopt)
      adoptar_usuario "${2:-}"
      ;;
    create)
      crear_usuario
      ;;
    password)
      cambiar_password_usuario "${2:-}"
      ;;
    *)
      error "Uso: scripts/korunix users [--json|adopt <cuenta>|create|password <cuenta>]."
      ;;
  esac
}

valor_dmi() {
  local campo="$1"
  local archivo="/sys/class/dmi/id/${campo}"

  [[ -r "$archivo" ]] || return 0

  tr -d '\000' <"$archivo" \
    | sed -E 's/[[:space:]]+$//'
}

tipo_equipo_detectado() {
  local chasis

  chasis="$(valor_dmi chassis_type)"

  # Los números siguen SMBIOS. Una batería cualquiera no participa en esta
  # decisión porque ratones y teclados también pueden exponer Battery.
  case "$chasis" in
    3|4|5|6|7|15|16|24)
      echo "desktop"
      ;;
    8|9|10|14|30|31|32)
      echo "laptop"
      ;;
    13)
      echo "all-in-one"
      ;;
    17|23)
      echo "server"
      ;;
    *)
      echo "unknown"
      ;;
  esac
}

hardware_detectado_json() {
  local jq_bin
  local arch_kernel
  local arch_real
  local arch_declarada
  local firmware_real
  local firmware_declarado
  local coincide_arch=false
  local coincide_firmware=false
  local virtualizacion
  local virtualizado=false
  local fabricante
  local modelo
  local placa_fabricante
  local placa_modelo
  local chasis
  local tipo_equipo
  local cpu_modelo
  local cpu_fabricante
  local cpu_logicos
  local microcode
  local memoria_kib
  local memoria_bytes
  local bateria_sistema=false
  local fuente
  local tipo_fuente
  local scope_fuente
  local graficos_texto=""
  local graficos_json
  local drivers_texto=""
  local drivers_json
  local red_texto=""
  local red_json
  local almacenamiento_json

  jq_bin="$(command -v jq 2>/dev/null || true)"

  [[ -n "$jq_bin" ]] \
    || error "jq no está disponible. Aplica primero la generación que integra la capa de hardware."

  arch_kernel="$(uname -m)"

  case "$arch_kernel" in
    x86_64)
      arch_real="x86_64-linux"
      ;;
    aarch64|arm64)
      arch_real="aarch64-linux"
      ;;
    *)
      arch_real="${arch_kernel}-linux"
      ;;
  esac

  if [[ -d /sys/firmware/efi ]]; then
    firmware_real="uefi"
  else
    firmware_real="bios"
  fi

  arch_declarada="$(
    nix eval \
      ".#nixosConfigurations.${HOST}.config.nixpkgs.hostPlatform.system" \
      --raw \
      2>/dev/null \
      || true
  )"

  firmware_declarado="$(
    nix eval \
      ".#nixosConfigurations.${HOST}.config.korunix.hardware.firmware" \
      --raw \
      2>/dev/null \
      || true
  )"

  [[ "$arch_real" == "$arch_declarada" ]] && coincide_arch=true
  [[ "$firmware_real" == "$firmware_declarado" ]] && coincide_firmware=true

  virtualizacion="$(
    systemd-detect-virt 2>/dev/null \
      || true
  )"

  if [[ -z "$virtualizacion" || "$virtualizacion" == "none" ]]; then
    virtualizacion="physical"
  else
    virtualizado=true
  fi

  fabricante="$(valor_dmi sys_vendor)"
  modelo="$(valor_dmi product_name)"
  placa_fabricante="$(valor_dmi board_vendor)"
  placa_modelo="$(valor_dmi board_name)"
  chasis="$(valor_dmi chassis_type)"
  tipo_equipo="$(tipo_equipo_detectado)"

  [[ -n "$fabricante" ]] || fabricante="desconocido"
  [[ -n "$modelo" ]] || modelo="desconocido"
  [[ -n "$placa_fabricante" ]] || placa_fabricante="desconocido"
  [[ -n "$placa_modelo" ]] || placa_modelo="desconocido"

  cpu_modelo="$(
    awk -F ':' '
      /^model name/ || /^Processor/ || /^Hardware/ {
        valor = $2
        sub(/^[[:space:]]+/, "", valor)
        print valor
        exit
      }
    ' /proc/cpuinfo 2>/dev/null \
      || true
  )"

  cpu_fabricante="$(
    awk -F ':' '
      /^vendor_id/ {
        valor = $2
        sub(/^[[:space:]]+/, "", valor)
        print valor
        exit
      }
    ' /proc/cpuinfo 2>/dev/null \
      || true
  )"

  cpu_logicos="$(
    awk '
      /^processor[[:space:]]*:/ {
        total++
      }

      END {
        print total + 0
      }
    ' /proc/cpuinfo
  )"

  microcode="$(
    awk -F ':' '
      /^microcode/ {
        valor = $2
        sub(/^[[:space:]]+/, "", valor)
        print valor
        exit
      }
    ' /proc/cpuinfo 2>/dev/null \
      || true
  )"

  [[ -n "$cpu_modelo" ]] || cpu_modelo="desconocido"
  [[ -n "$cpu_fabricante" ]] || cpu_fabricante="desconocido"
  [[ -n "$microcode" ]] || microcode="desconocido"

  memoria_kib="$(
    awk '
      /^MemTotal:/ {
        print $2
        exit
      }
    ' /proc/meminfo
  )"

  memoria_bytes=$((memoria_kib * 1024))

  # Solo una batería de sistema puede reforzar la detección de un portátil.
  # Las baterías con scope=Device pertenecen a periféricos.
  for fuente in /sys/class/power_supply/*; do
    [[ -e "$fuente" ]] || continue

    tipo_fuente="$(cat "$fuente/type" 2>/dev/null || true)"
    scope_fuente="$(cat "$fuente/scope" 2>/dev/null || true)"

    if [[ "$tipo_fuente" == "Battery" && "$scope_fuente" == "System" ]]; then
      bateria_sistema=true
      break
    fi
  done

  if command -v lspci >/dev/null 2>&1; then
    graficos_texto="$(
      lspci -nn 2>/dev/null \
        | grep -E '\[03(00|02|80)\]' \
        || true
    )"

    red_texto="$(
      lspci -nn 2>/dev/null \
        | grep -E '\[02(00|80)\]' \
        || true
    )"
  fi

  if command -v lsmod >/dev/null 2>&1; then
    drivers_texto="$(
      lsmod \
        | awk '
            /^(amdgpu|nvidia|nouveau|i915|xe)[[:space:]]/ {
              print $1
            }
          ' \
        || true
    )"
  fi

  graficos_json="$(
    printf '%s\n' "$graficos_texto" \
      | sed -E 's/^[^[:space:]]+[[:space:]]+//' \
      | "$jq_bin" -R -s '
          split("\n")
          | map(select(length > 0))
        '
  )"

  drivers_json="$(
    printf '%s\n' "$drivers_texto" \
      | "$jq_bin" -R -s '
          split("\n")
          | map(select(length > 0))
          | unique
        '
  )"

  red_json="$(
    printf '%s\n' "$red_texto" \
      | sed -E 's/^[^[:space:]]+[[:space:]]+//' \
      | "$jq_bin" -R -s '
          split("\n")
          | map(select(length > 0))
        '
  )"

  if command -v lsblk >/dev/null 2>&1; then
    almacenamiento_json="$(
      lsblk \
        -J \
        -b \
        -e 7 \
        -o NAME,PATH,TYPE,SIZE,FSTYPE,MOUNTPOINTS,MODEL,TRAN,ROTA,RM
    )"
  else
    almacenamiento_json='{"blockdevices":[]}'
  fi

  "$jq_bin" -n \
    --argjson schemaVersion 1 \
    --arg hostId "$HOST" \
    --arg detectedAt "$(date --iso-8601=seconds)" \
    --arg machineType "$tipo_equipo" \
    --arg chassisType "$chasis" \
    --arg vendor "$fabricante" \
    --arg model "$modelo" \
    --arg boardVendor "$placa_fabricante" \
    --arg boardModel "$placa_modelo" \
    --argjson systemBattery "$bateria_sistema" \
    --arg architectureDetected "$arch_real" \
    --arg architectureDeclared "$arch_declarada" \
    --argjson architectureMatches "$coincide_arch" \
    --arg firmwareDetected "$firmware_real" \
    --arg firmwareDeclared "$firmware_declarado" \
    --argjson firmwareMatches "$coincide_firmware" \
    --arg virtualization "$virtualizacion" \
    --argjson virtualized "$virtualizado" \
    --arg cpuModel "$cpu_modelo" \
    --arg cpuVendor "$cpu_fabricante" \
    --argjson cpuLogical "$cpu_logicos" \
    --arg microcode "$microcode" \
    --argjson memoryBytes "$memoria_bytes" \
    --argjson graphics "$graficos_json" \
    --argjson graphicsDrivers "$drivers_json" \
    --argjson network "$red_json" \
    --argjson storage "$almacenamiento_json" \
    '{
      schemaVersion: $schemaVersion,
      hostId: $hostId,
      detectedAt: $detectedAt,

      machine: {
        type: $machineType,
        chassisType: $chassisType,
        vendor: $vendor,
        model: $model,
        boardVendor: $boardVendor,
        boardModel: $boardModel,
        systemBattery: $systemBattery
      },

      platform: {
        detected: $architectureDetected,
        declared: $architectureDeclared,
        matches: $architectureMatches
      },

      firmware: {
        detected: $firmwareDetected,
        declared: $firmwareDeclared,
        matches: $firmwareMatches
      },

      virtualization: {
        kind: $virtualization,
        virtualized: $virtualized
      },

      cpu: {
        model: $cpuModel,
        vendor: $cpuVendor,
        logicalProcessors: $cpuLogical,
        microcode: $microcode
      },

      memory: {
        bytes: $memoryBytes
      },

      graphics: $graphics,
      graphicsDrivers: $graphicsDrivers,
      network: $network,
      storage: $storage
    }'
}

mostrar_hardware() {
  local modo="${1:-}"
  local jq_bin
  local datos
  local tipo
  local tipo_humano
  local memoria

  case "$modo" in
    "")
      ;;
    --json)
      hardware_detectado_json
      return
      ;;
    *)
      error "Uso: scripts/korunix hardware [--json]."
      ;;
  esac

  jq_bin="$(command -v jq 2>/dev/null || true)"

  [[ -n "$jq_bin" ]] \
    || error "jq no está disponible. Aplica primero la generación que integra la capa de hardware."

  datos="$(hardware_detectado_json)"
  tipo="$("$jq_bin" -r '.machine.type' <<<"$datos")"

  case "$tipo" in
    desktop)
      tipo_humano="Sobremesa"
      ;;
    laptop)
      tipo_humano="Portátil"
      ;;
    all-in-one)
      tipo_humano="Todo en uno"
      ;;
    server)
      tipo_humano="Servidor"
      ;;
    *)
      tipo_humano="Tipo no determinado"
      ;;
  esac

  memoria="$(
    "$jq_bin" -r '.memory.bytes' <<<"$datos" \
      | awk '{ printf "%.1f GiB", $1 / 1073741824 }'
  )"

  echo "=== Hardware detectado ==="
  echo "Host Korunix: $HOST"
  echo "Tipo de equipo: $tipo_humano"
  echo "Fabricante: $("$jq_bin" -r '.machine.vendor' <<<"$datos")"
  echo "Modelo: $("$jq_bin" -r '.machine.model' <<<"$datos")"

  echo
  echo "=== Plataforma ==="
  echo "Arquitectura: $("$jq_bin" -r '.platform.detected' <<<"$datos")"

  case "$("$jq_bin" -r '.firmware.detected' <<<"$datos")" in
    uefi)
      echo "Firmware: UEFI"
      ;;
    bios)
      echo "Firmware: BIOS / Legacy"
      ;;
  esac

  if "$jq_bin" -e '.virtualization.virtualized' <<<"$datos" >/dev/null; then
    echo "Entorno: virtualizado ($("$jq_bin" -r '.virtualization.kind' <<<"$datos"))"
  else
    echo "Entorno: máquina física"
  fi

  echo
  echo "=== Procesador y memoria ==="
  echo "CPU: $("$jq_bin" -r '.cpu.model' <<<"$datos")"
  echo "Procesadores lógicos: $("$jq_bin" -r '.cpu.logicalProcessors' <<<"$datos")"
  echo "Microcódigo: $("$jq_bin" -r '.cpu.microcode' <<<"$datos")"
  echo "Memoria: $memoria"

  echo
  echo "=== Gráficos ==="

  if [[ "$("$jq_bin" -r '.graphics | length' <<<"$datos")" -eq 0 ]]; then
    echo "No se pudo identificar un adaptador gráfico."
  else
    "$jq_bin" -r '.graphics[] | "• " + .' <<<"$datos"
  fi

  if [[ "$("$jq_bin" -r '.graphicsDrivers | length' <<<"$datos")" -gt 0 ]]; then
    echo "Controladores cargados: $("$jq_bin" -r '.graphicsDrivers | join(", ")' <<<"$datos")"
  fi

  echo
  echo "=== Almacenamiento ==="

  "$jq_bin" -r '
    .storage.blockdevices[]?
    | select(.type == "disk")
    | (
        "• "
        + .name
        + ": "
        + (((.size / 1073741824 * 10 | round) / 10) | tostring)
        + " GiB · "
        + ((.model // "sin modelo") | gsub("\\s+$"; ""))
        + " · "
        + (.tran // "bus desconocido")
      )
  ' <<<"$datos"

  echo
  echo "=== Red ==="

  if [[ "$("$jq_bin" -r '.network | length' <<<"$datos")" -eq 0 ]]; then
    echo "No se identificaron adaptadores PCI de red."
  else
    "$jq_bin" -r '.network[] | "• " + .' <<<"$datos"
  fi

  echo
  echo "=== Coherencia con Korunix ==="

  if "$jq_bin" -e '.platform.matches' <<<"$datos" >/dev/null; then
    echo "✓ la arquitectura detectada coincide con la declarada"
  else
    echo "AVISO: la arquitectura detectada y la declarada no coinciden"
    echo "Detectada: $("$jq_bin" -r '.platform.detected' <<<"$datos")"
    echo "Declarada: $("$jq_bin" -r '.platform.declared' <<<"$datos")"
  fi

  if "$jq_bin" -e '.firmware.matches' <<<"$datos" >/dev/null; then
    echo "✓ el firmware detectado coincide con el adoptado"
  else
    echo "AVISO: el firmware detectado y el adoptado no coinciden"
    echo "Detectado: $("$jq_bin" -r '.firmware.detected' <<<"$datos")"
    echo "Adoptado: $("$jq_bin" -r '.firmware.declared' <<<"$datos")"
  fi

  echo
  echo "Detección local. No se consultó Internet ni se modificó el sistema."
}

mostrar_arranque() {
  local modo="BIOS / Legacy"
  local estado_boot=""
  local cargador=""
  local secure="desconocido"

  if [[ -d /sys/firmware/efi ]]; then
    modo="UEFI"
  fi

  if command -v bootctl >/dev/null 2>&1; then
    estado_boot="$(bootctl status --no-pager 2>/dev/null || true)"

    cargador="$(
      awk '
        /^[[:space:]]*Product:/ {
          sub(/^[[:space:]]*Product:[[:space:]]*/, "")
          print
          exit
        }
      ' <<<"$estado_boot"
    )"

    secure="$(
      awk '
        /^[[:space:]]*Secure Boot:/ {
          sub(/^[[:space:]]*Secure Boot:[[:space:]]*/, "")
          print
          exit
        }
      ' <<<"$estado_boot"
    )"
  fi

  echo
  echo "=== Arranque y firmware ==="
  echo "Firmware: $modo"
  echo "Cargador actual: ${cargador:-desconocido}"

  case "$secure" in
    enabled*)
      echo "Arranque seguro: activado"
      ;;
    disabled*)
      echo "Arranque seguro: desactivado"
      ;;
    *)
      echo "Arranque seguro: $secure"
      ;;
  esac

  if command -v fwupdmgr >/dev/null 2>&1; then
    echo "Actualizaciones de firmware: integradas"
  else
    echo "Actualizaciones de firmware: todavía no integradas en el sistema en uso"
  fi
}

estado() {
  local actual
  local predeterminada
  local generacion_actual
  local generacion_default

  actual="$(ruta_actual)"
  predeterminada="$(ruta_predeterminada)"
  generacion_actual="$(generacion_de_ruta "$actual")"
  generacion_default="$(generacion_predeterminada)"

  echo "=== Repositorio ==="
  git status --short --branch

  echo
  echo "=== Equipo ==="
  echo "Host Korunix: $HOST"

  mostrar_arranque

  echo
  echo "=== Sistema ==="
  echo "Punto actual (ID): ${generacion_actual:-desconocido}"
  echo "Punto predeterminado (ID): ${generacion_default:-desconocido}"
  echo "Sistema en uso: ${actual:-desconocido}"
  echo "Sistema predeterminado: ${predeterminada:-desconocido}"

  if [[ -n "$actual" && -n "$predeterminada" && "$actual" != "$predeterminada" ]]; then
    echo
    echo "AVISO: el sistema en uso y el preparado para el próximo arranque son distintos."
    echo "No se cambió la sesión actual."
  fi

  echo
  echo "=== Puntos de recuperación recientes ==="
  mostrar_generaciones 5

  echo
  echo "Estado consultado localmente. No se buscó nada en Internet."
}

construir_candidato() {
  local candidato

  echo "Construyendo la generación candidata de ${HOST}..." >&2

  candidato="$(
    nix build \
      ".#nixosConfigurations.${HOST}.config.system.build.toplevel" \
      --no-link \
      --print-out-paths \
      --show-trace \
      | tail -n 1
  )"

  [[ -n "$candidato" ]] \
    || error "Nix no devolvió la ruta de la generación candidata."

  printf "%s\n" "$candidato"
}

mostrar_diferencias() {
  local anterior="$1"
  local candidato="$2"

  echo
  echo "=== Diferencias de paquetes y cierres ==="

  if [[ -z "$anterior" || ! -e "$anterior" ]]; then
    aviso "No pude encontrar el sistema actualmente en uso para compararlo."
    return
  fi

  if ! nix store diff-closures "$anterior" "$candidato"; then
    aviso "Nix no pudo producir el resumen de diferencias de closures."
  fi
}


mostrar_activacion_seca() {
  local candidato="$1"

  echo
  echo "=== Cambios de servicios y activación ==="

  if [[ ! -x "$candidato/bin/switch-to-configuration" ]]; then
    error "La generación candidata no contiene switch-to-configuration."
  fi

  echo "NixOS necesita permiso administrativo para calcular el cambio real de servicios."
  echo "Esta autorización no activa la generación ni modifica el sistema."

  # dry-activate necesita observar el estado real de systemd como root. Se
  # obtiene la autorización una vez y se reutiliza si después se decide aplicar.
  sudo -v

  if ! sudo "$candidato/bin/switch-to-configuration" dry-activate; then
    error "No se pudo calcular de forma segura el plan de activación."
  fi
}

mostrar_reinicio() {
  local anterior="$1"
  local candidato="$2"
  local kernel_anterior
  local kernel_nuevo

  echo
  echo "=== Reinicio ==="

  kernel_anterior="$(readlink -f "$anterior/kernel" 2>/dev/null || true)"
  kernel_nuevo="$(readlink -f "$candidato/kernel" 2>/dev/null || true)"

  if [[ -n "$kernel_anterior" && -n "$kernel_nuevo" ]]; then
    if [[ "$kernel_anterior" != "$kernel_nuevo" ]]; then
      echo "El kernel cambia. Conviene reiniciar después de aplicar."
    else
      echo "No detecto un cambio de kernel."
    fi
  else
    echo "No pude determinar si cambia el kernel."
  fi
}

previsualizar() {
  local actual
  local candidato

  actual="$(ruta_actual)"
  candidato="$(construir_candidato)"

  echo
  echo "=== Generación candidata ==="
  echo "$candidato"

  mostrar_diferencias "$actual" "$candidato"
  mostrar_activacion_seca "$candidato"
  mostrar_reinicio "$actual" "$candidato"

  echo
  echo "✓ PREVISUALIZACIÓN COMPLETA"
  echo "No se aplicó ninguna generación."
}

construir() {
  local candidato

  candidato="$(construir_candidato)"

  echo
  echo "✓ CONSTRUCCIÓN COMPLETA"
  echo "$candidato"
}

verificar_sistema() {
  local esperado="${1:-}"
  local actual
  local predeterminado

  actual="$(ruta_actual)"
  predeterminado="$(ruta_predeterminada)"

  echo
  echo "=== Verificación posterior ==="
  echo "Sistema en uso: $actual"
  echo "Sistema predeterminado: $predeterminado"

  if [[ -n "$esperado" && "$actual" != "$esperado" ]]; then
    aviso "La generación en uso no coincide con la que esperaba Korunix."
  fi

  echo
  echo "=== Servicios de sistema fallidos ==="
  systemctl --failed --no-pager || true

  echo
  echo "=== Servicios de usuario fallidos ==="
  systemctl --user --failed --no-pager || true
}

aplicar() {
  local actual
  local candidato

  echo "Korunix comprobará, construirá y previsualizará antes de aplicar."
  validar

  actual="$(ruta_actual)"
  candidato="$(construir_candidato)"

  echo
  echo "=== Generación candidata ==="
  echo "$candidato"

  mostrar_diferencias "$actual" "$candidato"
  mostrar_activacion_seca "$candidato"
  mostrar_reinicio "$actual" "$candidato"

  echo
  echo "Hasta aquí no se modificó el sistema."

  confirmar "¿Aplicar esta generación ahora?" || return 0

  echo
  echo "La autorización administrativa obtenida durante la previsualización se reutilizará ahora."

  sudo nixos-rebuild switch --flake ".#${HOST}"

  verificar_sistema "$candidato"

  echo
  echo "✓ GENERACIÓN APLICADA"
}

actualizar() {
  local copia
  local entradas=("$@")

  if ! git diff --quiet -- flake.lock \
    || ! git diff --cached --quiet -- flake.lock; then

    error "flake.lock ya tiene cambios locales. Guárdalos o reviértelos antes de actualizar."
  fi

  copia="$(mktemp)"
  cp flake.lock "$copia"

  if [[ "${#entradas[@]}" -eq 0 ]]; then
    echo "Buscando actualizaciones para todas las fuentes de Korunix..."
  else
    echo "Buscando actualizaciones únicamente para: ${entradas[*]}"
  fi

  if nix flake update "${entradas[@]}" && validar; then
    rm -f "$copia"

    echo
    echo "=== Cambios de flake.lock ==="
    git diff --stat -- flake.lock

    echo
    echo "✓ ACTUALIZACIÓN PREPARADA"
    echo "flake.lock cambió y pasó la validación."
    echo "El sistema todavía no fue construido ni aplicado."
    echo "Usa scripts/korunix preview para revisar el resultado."
    return
  fi

  cp "$copia" flake.lock
  rm -f "$copia"

  echo >&2
  echo "La actualización no pasó la validación." >&2
  echo "Korunix restauró el flake.lock anterior." >&2
  exit 1
}

entrada_boot_para_generacion() {
  local generacion="$1"

  sudo bootctl list --no-pager 2>/dev/null \
    | awk -v generacion="$generacion" '
        /^[[:space:]]*id:/ {
          linea = $0
          sub(/^[[:space:]]*id:[[:space:]]*/, "", linea)
          id = linea
        }

        /^[[:space:]]*version:/ {
          linea = $0
          sub(/^[[:space:]]*version:[[:space:]]*/, "", linea)

          if (linea ~ ("^Generation " generacion "([[:space:]]|$)")) {
            print id
            exit
          }
        }
      '
}

rollback_generacion() {
  local generacion="${1:-}"
  local enlace
  local objetivo
  local actual
  local predeterminada
  local entrada

  [[ "$generacion" =~ ^[0-9]+$ ]] \
    || error "Indica el ID de un punto de recuperación, por ejemplo: rollback 35."

  enlace="${SYSTEM_PROFILE}-${generacion}-link"

  [[ -e "$enlace" ]] \
    || error "El punto de recuperación ${generacion} no existe."

  [[ -d /sys/firmware/efi ]] \
    || error "La recuperación programada todavía necesita una implementación específica para BIOS/Legacy."

  command -v bootctl >/dev/null 2>&1 \
    || error "bootctl no está disponible en este sistema."

  objetivo="$(readlink -f "$enlace")"
  actual="$(ruta_actual)"
  predeterminada="$(generacion_predeterminada)"

  echo "=== Preparar un punto de recuperación ==="
  echo "Punto actual (ID): $(generacion_de_ruta "$actual")"
  echo "Punto predeterminado (ID): ${predeterminada:-desconocido}"
  echo "Punto elegido (ID): $generacion"
  echo "Sistema elegido: $objetivo"

  mostrar_diferencias "$actual" "$objetivo"
  mostrar_reinicio "$actual" "$objetivo"

  echo
  echo "Korunix NO activará este sistema durante la sesión actual."
  echo "Tampoco reemplazará permanentemente el punto predeterminado."
  echo "Solo pedirá a systemd-boot usarlo una vez en el próximo arranque."
  echo "Después, el arranque normal vuelve a su estado predeterminado."

  confirmar "¿Usar el punto ${generacion} una vez en el próximo arranque?" \
    || return 0

  sudo -v

  sudo bootctl is-installed >/dev/null 2>&1 \
    || error "systemd-boot no está instalado en la ESP."

  entrada="$(entrada_boot_para_generacion "$generacion")"

  [[ -n "$entrada" ]] \
    || error "El punto ${generacion} no tiene una entrada disponible en systemd-boot."

  sudo bootctl set-oneshot "$entrada"

  echo
  echo "✓ PUNTO DE RECUPERACIÓN ${generacion} PROGRAMADO"
  echo "No se activó en caliente."
  echo "No se cambió el perfil permanente."
  echo "Entrada para el siguiente arranque: $entrada"
}

BORRAR_GENERACIONES=()
CONSERVAR_GENERACIONES=()

preparar_plan_limpieza() {
  local modo="$1"
  local actual
  local generacion_actual
  local predeterminada
  local generacion
  local inicio
  local generaciones=()
  local -A protegidas=()

  BORRAR_GENERACIONES=()
  CONSERVAR_GENERACIONES=()

  actual="$(ruta_actual)"
  generacion_actual="$(generacion_de_ruta "$actual")"
  predeterminada="$(generacion_predeterminada)"

  [[ -n "$generacion_actual" ]] \
    || error "La generación que está ejecutándose no aparece en el perfil del sistema. Korunix no limpiará nada."

  [[ -n "$predeterminada" ]] \
    || error "No pude determinar la generación predeterminada. Korunix no limpiará nada."

  mapfile -t generaciones < <(numeros_generaciones)

  protegidas["$generacion_actual"]=1
  protegidas["$predeterminada"]=1

  case "$modo" in
    tres)
      inicio=$((${#generaciones[@]} - 3))
      (( inicio < 0 )) && inicio=0

      for generacion in "${generaciones[@]:$inicio}"; do
        protegidas["$generacion"]=1
      done
      ;;

    todas)
      ;;

    *)
      error "Modo de limpieza desconocido: $modo"
      ;;
  esac

  for generacion in "${generaciones[@]}"; do
    if [[ -n "${protegidas[$generacion]:-}" ]]; then
      CONSERVAR_GENERACIONES+=("$generacion")
    else
      BORRAR_GENERACIONES+=("$generacion")
    fi
  done
}

mostrar_plan_limpieza() {
  local modo="$1"

  preparar_plan_limpieza "$modo"

  echo "=== Plan de limpieza ==="

  if [[ "${#CONSERVAR_GENERACIONES[@]}" -gt 0 ]]; then
    echo "Se conservarán: ${CONSERVAR_GENERACIONES[*]}"
  fi

  if [[ "${#BORRAR_GENERACIONES[@]}" -gt 0 ]]; then
    echo "Se retirarían: ${BORRAR_GENERACIONES[*]}"
  else
    echo "No hay generaciones que retirar."
  fi

  echo
  echo "La generación en uso y la predeterminada están siempre protegidas."
}

limpiar() {
  local modo="$1"
  local generacion

  mostrar_plan_limpieza "$modo"

  if [[ "${#BORRAR_GENERACIONES[@]}" -eq 0 ]]; then
    echo
    echo "✓ No hay nada que limpiar."
    return
  fi

  echo

  if [[ "$modo" == "todas" ]]; then
    local palabra

    [[ -t 0 ]] \
      || error "clean-all necesita confirmación interactiva."

    echo "Esta limpieza conserva únicamente las generaciones protegidas."
    printf "Escribe BORRAR para continuar: "
    read -r palabra

    if [[ "$palabra" != "BORRAR" ]]; then
      echo "Operación cancelada."
      return
    fi
  else
    confirmar "¿Retirar esas generaciones?" || return 0
  fi

  sudo -v

  # Las generaciones se retiran por número para que Korunix controle exactamente
  # cuáles desaparecen en lugar de delegar la política a un atajo opaco de Nix.
  for generacion in "${BORRAR_GENERACIONES[@]}"; do
    sudo nix-env \
      --profile "$SYSTEM_PROFILE" \
      --delete-generations "$generacion"
  done

  echo
  echo "Recogiendo objetos que ya no tengan ninguna referencia..."
  sudo nix-collect-garbage

  echo
  echo "Optimizando el almacén de Nix..."
  sudo nix store optimise

  echo
  echo "✓ LIMPIEZA TERMINADA"

  mostrar_generaciones
}

case "${1:-}" in
  users)
    operacion_usuarios "${2:-}" "${3:-}"
    ;;

  hardware)
    mostrar_hardware "${2:-}"
    ;;

  status)
    estado
    ;;

  structure)
    estructura
    ;;

  validate)
    validar
    ;;

  format)
    formatear
    ;;

  recovery|generations)
    mostrar_generaciones
    ;;

  preview)
    previsualizar
    ;;

  build)
    construir
    ;;

  apply)
    aplicar
    ;;

  update)
    shift
    actualizar "$@"
    ;;

  rollback)
    rollback_generacion "${2:-}"
    ;;

  clean-preview)
    mostrar_plan_limpieza tres
    ;;

  clean-all-preview)
    mostrar_plan_limpieza todas
    ;;

  clean)
    limpiar tres
    ;;

  clean-all)
    limpiar todas
    ;;

  "")
    cat <<'USAGE'
Korunix

Estado y comprobación:
  scripts/korunix users
      Mostrar las personas reales, perfiles Korunix y estado de adopción.

  scripts/korunix users --json
      Exponer el mismo modelo de identidad en JSON para la GUI futura.

  scripts/korunix users adopt <cuenta>
      Preparar declarativamente una cuenta existente sin tocar su contraseña.

  scripts/korunix users create
      Preparar interactivamente una cuenta nueva y su rol.

  scripts/korunix users password <cuenta>
      Entregar el cambio de contraseña directamente a passwd sin guardar secretos.

  scripts/korunix hardware
      Detectar localmente el hardware y comprobar que los hechos adoptados por
      Korunix siguen coincidiendo con la máquina real.

  scripts/korunix hardware --json
      Exponer el mismo modelo de hardware en JSON para interfaces y automatización.

  scripts/korunix status
      Ver el estado local del repositorio y del sistema sin usar Internet.

  scripts/korunix recovery
      Mostrar los puntos de recuperación disponibles y su estado.

  scripts/korunix generations
      Alias técnico de recovery para compatibilidad con el flujo anterior.

  scripts/korunix validate
      Comprobar estructura, Git, flake y todos los hosts sin aplicar.

Preparar y aplicar:
  scripts/korunix preview
      Construir y enseñar qué cambiaría sin activar nada. La inspección real de
      servicios pide autorización administrativa, pero no modifica el sistema.

  scripts/korunix build
      Construir la generación completa sin activarla.

  scripts/korunix apply
      Validar, construir, previsualizar, confirmar, aplicar y verificar.

Actualizaciones:
  scripts/korunix update
      Actualizar todas las fuentes del flake y validar el resultado.

  scripts/korunix update noctalia
      Actualizar únicamente una entrada concreta.

  scripts/korunix update nixpkgs noctalia
      Actualizar varias entradas concretas.

Recuperación:
  scripts/korunix rollback 34
      Preparar el punto 34 para usarlo una vez en el próximo arranque.

Limpieza:
  scripts/korunix clean-preview
      Enseñar qué retiraría la limpieza normal sin borrar nada.

  scripts/korunix clean
      Conservar al menos los tres puntos de recuperación más recientes y proteger siempre
      la generación en uso y la predeterminada.

  scripts/korunix clean-all-preview
      Enseñar qué retiraría la limpieza agresiva sin borrar nada.

  scripts/korunix clean-all
      Borrar todas las generaciones no protegidas tras una confirmación fuerte.

Desarrollo:
  scripts/korunix structure
      Mostrar la estructura del repositorio.

  scripts/korunix format
      Formatear archivos Nix con el formatter declarado por el flake.

Si existen varios hosts y el nombre actual no coincide con uno de ellos:
  KORUNIX_HOST=mi-equipo scripts/korunix status
USAGE
    ;;

  *)
    error "Acción desconocida: $1"
    ;;
esac
