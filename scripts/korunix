#!/usr/bin/env bash
set -euo pipefail

# Korunix utiliza este script como entrada humana de mantenimiento mientras la
# interfaz gráfica todavía no existe. La GUI futura deberá utilizar el mismo
# modelo y las mismas operaciones, no crear un segundo sistema paralelo.

ROOT="$(
  cd "$(dirname "${BASH_SOURCE[0]}")/.."
  pwd
)"

SYSTEM_PROFILE="/nix/var/nix/profiles/system"

cd "$ROOT"

error() {
  printf "ERROR: %s\n" "$*" >&2
  exit 1
}

aviso() {
  printf "AVISO: %s\n" "$*" >&2
}

hosts_disponibles() {
  local archivo

  for archivo in equipos/*.nix; do
    [[ -e "$archivo" ]] || continue
    [[ "$archivo" == *-detectado.nix ]] && continue
    basename "$archivo" .nix
  done
}

resolver_host() {
  local solicitado="${KORUNIX_HOST:-}"
  local actual
  local hosts=()

  if [[ -n "$solicitado" ]]; then
    [[ -f "equipos/${solicitado}.nix" ]] \
      || error "No existe equipos/${solicitado}.nix."

    printf "%s\n" "$solicitado"
    return
  fi

  actual="$(hostname 2>/dev/null || true)"

  if [[ -n "$actual" && -f "equipos/${actual}.nix" ]]; then
    printf "%s\n" "$actual"
    return
  fi

  mapfile -t hosts < <(hosts_disponibles)

  if [[ "${#hosts[@]}" -eq 1 ]]; then
    printf "%s\n" "${hosts[0]}"
    return
  fi

  error "No pude decidir qué host usar. Define KORUNIX_HOST. Disponibles: ${hosts[*]:-ninguno}."
}

# Bootstrap debe funcionar antes de que exista equipos/<id>.nix.
# Todos los demás comandos conservan la resolución estricta del host.
if [[ "${1:-}" == "bootstrap" ]]; then
  HOST=""
else
  HOST="$(resolver_host)"
fi

confirmar() {
  local mensaje="$1"
  local respuesta

  [[ -t 0 ]] || error "Esta operación necesita confirmación interactiva."

  printf "%s [s/N] " "$mensaje"
  read -r respuesta

  case "$respuesta" in
    s|S|si|Si|SI|sí|Sí|SÍ)
      return 0
      ;;
    *)
      echo "Operación cancelada."
      return 1
      ;;
  esac
}

estructura() {
  find . \
    -mindepth 1 \
    -maxdepth 3 \
    ! -path "./.git" \
    ! -path "./.git/*" \
    -print \
    | sort
}

validar_estructura() {
  local canales_modelo
  local rutas_antiguas=(
    "hosts"
    "hardware"
    "users"
    "modules"
    "catalog"
    "hosts/korunix/configuration.nix"
    "users/koru/home.nix"
    "modules/nixos"
    "modules/home"
    "modules/korunix"
    "config/niri.nix"
    "config/fastfetch.nix"
    "config/spicetify.nix"
    "config/noctalia/noctalia.nix"
    "config/noctalia/settings"
  )
  local ruta

  for ruta in "${rutas_antiguas[@]}"; do
    [[ ! -e "$ruta" ]] \
      || error "Quedó una ruta retirada por la arquitectura nueva: $ruta"
  done

  if grep -RInE \
    --include="*.nix" \
    --include="*.sh" \
    --include="justfile" \
    "home-manager|homeConfigurations|home-legacy" \
    flake.nix hosts hardware modules users config scripts justfile \
    >/tmp/korunix-home-manager-restos.txt 2>/dev/null; then

    cat /tmp/korunix-home-manager-restos.txt
    error "Quedaron referencias ejecutables a Home Manager."
  fi

  local host_id

  while IFS= read -r host_id; do
    [[ -f "equipos/${host_id}-detectado.nix" ]] \
      || error "Falta equipos/${host_id}-detectado.nix."

    grep -Eq '^[[:space:]]+channel = "(stable|unstable)";$' "equipos/${host_id}.nix" \
      || error "El host ${host_id} debe declarar channel = \"stable\" o \"unstable\"."
  done < <(hosts_disponibles)

  [[ -f nvidia-open-pci-ids.txt ]] \
    || error "Falta nvidia-open-pci-ids.txt."

  grep -Fq 'graphics = lib.mkOption {' sistema/equipo.nix \
    || error "Falta el modelo declarativo de adaptadores gráficos."

  grep -Fq 'open = nvidiaOpenSupported;' sistema/equipo.nix \
    || error "NVIDIA no deriva el módulo abierto desde el hardware adoptado."

  grep -Fq "graphicsDevices: \$graphicsDevices" scripts/korunix \
    || error "El detector no expone las GPU como datos estructurados."

  [[ -f canales.nix ]] \
    || error "Falta canales.nix."

  [[ -f predeterminados.nix ]] \
    || error "Falta predeterminados.nix."

  grep -Fq 'productDefaults = import ../predeterminados.nix;' sistema/aplicaciones.nix \
    || error "Aplicaciones no consumen predeterminados.nix."

  grep -Fq 'productDefaults = import ../predeterminados.nix;' sistema/servicios.nix \
    || error "Servicios no consumen predeterminados.nix."

  grep -Fq 'productDefaults = import ../predeterminados.nix;' sistema/escritorio.nix \
    || error "Escritorio no consume predeterminados.nix."

  grep -Eq '^bootstrap_localization_json\(\)[[:space:]]*\{' scripts/korunix \
    || error "Falta el lector declarativo de localización del bootstrap."

  grep -Eq '^[[:space:]]*localization=.*bootstrap_localization_json' scripts/korunix \
    || error "Bootstrap no consume el lector declarativo de localización."

  grep -Fq "configurationSha256: \$configurationSha256" < <(
    sed -n \
      '/^bootstrap_plan_json() {/,/^bootstrap_adopt_preflight_json() {/p' \
      scripts/korunix
  ) || error "El plan de bootstrap no congela configuration.nix."

  grep -Fq "channelsSha256: \$channelsSha256" < <(
    sed -n \
      '/^bootstrap_plan_json() {/,/^bootstrap_adopt_preflight_json() {/p' \
      scripts/korunix
  ) || error "El plan de bootstrap no congela canales.nix."

  grep -Eq '^bootstrap_adopt_preflight_json\(\)[[:space:]]*\{' scripts/korunix \
    || error "Falta el preflight interno de bootstrap --adopt."

  grep -Eq '^bootstrap_adopt_lock_acquire\(\)[[:space:]]*\{' scripts/korunix \
    || error "Falta el bloqueo exclusivo de bootstrap --adopt."

  grep -Eq '^bootstrap_adopt_stage_json\(\)[[:space:]]*\{' scripts/korunix \
    || error "Falta el materializador interno de bootstrap --adopt."

  if sed -n \
      '/^bootstrap_adopt_stage_json() {/,/^mostrar_bootstrap_plan() {/p' \
      scripts/korunix |
    grep -Eq '(^|[[:space:]])nix[[:space:]]+build([[:space:]]|$)'
  then
    error "El staging de bootstrap no debe ejecutar nix build."
  fi

  grep -Fq "\"path:\${stage}#nixosConfigurations.\${host_id}.config.system.build.toplevel.drvPath\"" < <(
    sed -n \
      '/^bootstrap_adopt_stage_json() {/,/^mostrar_bootstrap_plan() {/p' \
      scripts/korunix
  ) || error "El staging no evalúa la derivación mediante path:."

  grep -Eq '^bootstrap_adopt_finalize_json\(\)[[:space:]]*\(' scripts/korunix \
    || error "Falta el finalizador transaccional de bootstrap."

  grep -Fq 'bootstrap_finalize_expected_sha() {' scripts/korunix \
    || error "El finalizador no verifica hashes de candidatos."

  grep -Fq 'bootstrap_finalize_rollback() {' scripts/korunix \
    || error "El finalizador no contiene rollback."

  grep -Fq 'bootstrap_finalize_failpoint() {' scripts/korunix \
    || error "El finalizador no conserva sus puntos de prueba."

  bootstrap_finalize_block="$(
    sed -n \
      '/^bootstrap_adopt_finalize_json() (/,/^mostrar_bootstrap_plan() {/p' \
      scripts/korunix
  )"

  if grep -Eq \
      '(^|[[:space:]])nix[[:space:]]+build([[:space:]]|$)' \
      <<<"$bootstrap_finalize_block"
  then
    error "El finalizador de bootstrap no debe ejecutar nix build."
  fi

  unset bootstrap_finalize_block

  grep -Eq '^bootstrap_adopt_publico\(\)[[:space:]]*\{' scripts/korunix \
    || error "Falta la interfaz de bootstrap --adopt."

  grep -Fq '    --adopt)' scripts/korunix \
    || error "El dispatcher no expone bootstrap --adopt."

  grep -Fq 'scripts/korunix bootstrap --adopt --yes' scripts/korunix \
    || error "La ayuda no documenta bootstrap --adopt --yes."

  bootstrap_public_block="$(
    sed -n \
      '/^bootstrap_adopt_publico() {/,/^gestionar_bootstrap() {/p' \
      scripts/korunix
  )"

  grep -Fq 'bootstrap_adopt_lock_acquire' <<<"$bootstrap_public_block" \
    || error "bootstrap --adopt no adquiere el lock."

  grep -Fq 'bootstrap_adopt_preflight_json' <<<"$bootstrap_public_block" \
    || error "bootstrap --adopt no ejecuta preflight."

  grep -Fq 'bootstrap_adopt_stage_json' <<<"$bootstrap_public_block" \
    || error "bootstrap --adopt no usa staging."

  grep -Fq 'bootstrap_adopt_finalize_json' <<<"$bootstrap_public_block" \
    || error "bootstrap --adopt no finaliza transaccionalmente."

  if grep -Eq \
      '(^|[[:space:]])(nix[[:space:]]+build|nixos-rebuild|git[[:space:]]+commit|git[[:space:]]+push)([[:space:]]|$)' \
      <<<"$bootstrap_public_block"
  then
    error "bootstrap --adopt contiene una operación pública prohibida."
  fi

  unset bootstrap_public_block

  grep -Fq 'bootstrap_product_defaults_json() {' scripts/korunix \
    || error "Bootstrap no consume los defaults únicos."

  grep -Fq '__bootstrap-plan)' scripts/users \
    || error "El motor de usuarios no expone el plan interno de bootstrap."

  grep -Fq "\"\$ROOT/scripts/users\" __bootstrap-plan" scripts/korunix \
    || error "Bootstrap no consume el motor único de usuarios."

  if grep -Eq '^bootstrap_usuarios_json\(\)[[:space:]]*\{' scripts/korunix; then
    error "Bootstrap conserva definido un detector de usuarios duplicado."
  fi

  [[ ! -e packages/fetch.nix ]] \
    || error "Fetch no necesita una receta local: debe resolverse entre las fuentes de nixpkgs."

  grep -Fq 'pkgsUnstable ? null' sistema/base.nix \
    || error "El módulo base no acepta el conjunto inestable opcional."

  grep -Fq 'if pkgs ? fetch' sistema/base.nix \
    || error "Fetch no prefiere el paquete de la base elegida."

  grep -Fq 'then pkgsUnstable.fetch' sistema/base.nix \
    || error "Fetch no puede recurrir puntualmente a nixpkgs inestable."

  grep -Fq 'systemdBootHasBootCounting =' sistema/arranque.nix \
    || error "El arranque no detecta si NixOS ofrece bootCounting."

  grep -Fq 'lib.hasAttrByPath' sistema/arranque.nix \
    || error "La compatibilidad de systemd-boot no consulta el árbol real de opciones."

  grep -Fq 'lib.optionalAttrs systemdBootHasBootCounting' sistema/arranque.nix \
    || error "bootCounting no es opcional según las capacidades de NixOS."

  canales_modelo="$(canales_json)"

  jq -e '
    .schemaVersion == 1
    and .default == "stable"
    and .channels.stable.nixpkgs_ref == "nixos-26.05"
    and .channels.stable.aagl_ref == "release-26.05"
    and .channels.stable.label_en == "Stable"
    and .channels.stable.label_hu == "Stabil"
    and .channels.unstable.nixpkgs_ref == "nixos-unstable"
    and .channels.unstable.aagl_ref == "main"
    and .channels.unstable.label_en == "Unstable"
    and .channels.unstable.label_hu == "Instabil"
  ' <<<"$canales_modelo" >/dev/null \
    || error "La fuente Nix de canales no cumple el modelo esperado."

  grep -Fq 'nixpkgsStable.url = "nixpkgs/nixos-26.05";' flake.nix \
    || error "Falta la fuente estable de NixOS 26.05."

  grep -Fq 'url = "github:ezKEa/aagl-gtk-on-nix/release-26.05";' flake.nix \
    || error "Falta la rama AAGL correspondiente a NixOS 26.05."

  grep -Fq 'channel = host.korunix.channel or "stable";' flake.nix \
    || error "El flake no resuelve el canal individual de cada host."

  grep -Fq 'selectedNixpkgs.lib.nixosSystem' flake.nix \
    || error "La base NixOS no procede del canal elegido."

  grep -Fq 'selectedAagl.nixosModules.default' flake.nix \
    || error "AAGL no sigue el canal elegido."

  grep -Fq "pkgsStable = inputs.nixpkgsStable.legacyPackages.\${system};" flake.nix \
    || error "specialArgs no dispone del conjunto estable."

  grep -Fq "pkgsUnstable = inputs.nixpkgs.legacyPackages.\${system};" flake.nix \
    || error "specialArgs no dispone del conjunto inestable."

  grep -Fq 'inherit pkgsStable pkgsUnstable;' flake.nix \
    || error "Los módulos no reciben ambos conjuntos de paquetes."

  grep -Fq 'type = lib.types.enum ["stable" "unstable"];' sistema/base.nix \
    || error "El modelo Nix no restringe los canales conocidos."

  if grep -RInE \
    '^[[:space:]]*stateVersion[[:space:]]*=[[:space:]]*"(stable|unstable)";' \
    equipos
  then
    error "stateVersion no puede utilizarse como selector de canal."
  fi

  grep -Fq 'DCONF_PROFILE "noctalia"' config/niri.kdl \
    || error "Niri no entrega a sus aplicaciones el perfil visual de Noctalia."

  grep -Fq 'hl.env("DCONF_PROFILE", "noctalia")' config/hyprland.lua \
    || error "Hyprland no entrega a sus aplicaciones el perfil visual de Noctalia."

  grep -Fq 'Print { spawn "noctalia" "msg" "screenshot-region"; }' config/niri.kdl \
    || error "Niri no delega la captura de región a Noctalia."

  grep -Fq 'Ctrl+Print { spawn "noctalia" "msg" "screenshot-fullscreen"; }' config/niri.kdl \
    || error "Niri no delega la captura del monitor activo a Noctalia."

  grep -Fq 'Shift+Print { spawn "noctalia" "msg" "screenshot-fullscreen" "all"; }' config/niri.kdl \
    || error "Niri no delega la captura de todos los monitores a Noctalia."

  grep -Fq 'include optional=true "~/.config/niri/korunix-screenshots.kdl"' config/niri.kdl \
    || error "Niri no carga el destino XDG de capturas de cada persona."

  ! grep -Fq 'Print { screenshot; }' config/niri.kdl \
    || error "Niri todavía usa su capturador interno y omite la ruta XDG de Korunix."

  ! grep -Fq 'Ctrl+Print { screenshot-screen; }' config/niri.kdl \
    || error "Niri todavía usa su capturador de pantalla interno."

  [[ "$(grep -Fc '@KORUNIX_SCREENSHOTS@' config/noctalia/config.toml)" -eq 1 ]] \
    || error "La plantilla de Noctalia necesita exactamente un destino XDG de capturas."

  grep -Fq '[shell.screenshot]' config/noctalia/config.toml \
    || error "Noctalia no contiene la política global de capturas."

  grep -Fq 'directory = "@KORUNIX_SCREENSHOTS@"' config/noctalia/config.toml \
    || error "Noctalia no recibe el directorio XDG de capturas de cada persona."

  grep -Fq 'filename_pattern = "@KORUNIX_SCREENSHOT_PATTERN@"' config/noctalia/config.toml \
    || error "Noctalia no recibe un nombre de captura localizado."

  grep -Fq 'screenshot_pattern="Captura de pantalla del %Y-%m-%d %H-%M-%S"' sistema/personas.nix \
    || error "Falta el nombre localizado de las capturas en español."

  grep -Fq "niri_screenshots_target=\"\$niri_dir/korunix-screenshots.kdl\"" sistema/personas.nix \
    || error "Korunix no genera la configuración personal del capturador de Niri."

  grep -Fq 'screenshot-path "' sistema/personas.nix \
    || error "Niri no recibe una ruta nativa dentro del directorio XDG de capturas."

  grep -Fq 'merge_noctalia_policy() {' sistema/personas.nix \
    || error "Korunix no contiene la fusión selectiva de Noctalia."

  grep -Fq "noctalia_settings_target=\"\$noctalia_state_home/noctalia/settings.toml\"" sistema/personas.nix \
    || error "Korunix no localiza la capa efectiva guardada por Noctalia."

  grep -Fq "merge_noctalia_policy \"\$noctalia_settings_target\"" sistema/personas.nix \
    || error "Korunix no fusiona la política en settings.toml."

  grep -Fq "merge_noctalia_policy \"\$noctalia_target\"" sistema/personas.nix \
    || error "Korunix no conserva la fusión de config.toml."

  grep -Eq '^preparar_usuario_actual_despues_de_aplicar\(\) \{$' scripts/korunix \
    || error "Korunix no contiene la preparación personal posterior a una aplicación."

  grep -Eq '^  preparar_usuario_actual_despues_de_aplicar$' scripts/korunix \
    || error "Korunix no ejecuta la preparación personal después de aplicar."

  grep -Fq "patch_autostart_package \"\$package\" \"X-Cinnamon\"" sistema/escritorio.nix \
    || error "Los indicadores auxiliares de Cinnamon no están aislados de Noctalia."

  ! grep -Fq '[notification.filter.korunix-system-failure-' config/noctalia/config.toml \
    || error "La plantilla de Noctalia todavía contiene filtros heredados del notificador de Cinnamon."

  grep -Fq 'legacy_filters = (' sistema/personas.nix \
    || error "Falta la migración de los filtros heredados de Noctalia."

  grep -Fq '"korunix-system-failure-en",' sistema/personas.nix \
    || error "La migración no limpia el antiguo filtro en inglés."

  grep -Fq '"korunix-system-failure-es",' sistema/personas.nix \
    || error "La migración no limpia el antiguo filtro en español."

  grep -Fq 'environment.DCONF_PROFILE = "noctalia";' sistema/escritorio.nix \
    || error "El servicio de Noctalia no usa su perfil dconf aislado."

  grep -Fq 'user-db:noctalia' sistema/escritorio.nix \
    || error "Noctalia no tiene una base dconf separada de Cinnamon."

  grep -Fq 'theme="Hatter-Slate"' sistema/escritorio.nix \
    || error "Falta Hatter Slate como variante predeterminada de Noctalia."

  grep -Fq 'theme="Hatter-Green"' sistema/escritorio.nix \
    || error "Falta Hatter Green para la paleta Everforest."

  grep -Fq 'msg color-scheme-get' sistema/escritorio.nix \
    || error "La variante Hatter no consulta la paleta efectiva de Noctalia."

  grep -Fq '"community everforest")' sistema/escritorio.nix \
    || error "Everforest no selecciona exclusivamente Hatter Green."

  grep -Fq 'systemd.user.paths.korunix-noctalia-icon-theme-sync' sistema/escritorio.nix \
    || error "Los iconos Hatter no reaccionan a los cambios de paleta."

  grep -Fq '%h/.config/noctalia/settings.toml' sistema/escritorio.nix \
    || error "Los iconos Hatter no observan los cambios guardados por la GUI."

  grep -Fq 'korunix-xdg-desktop-portal-gtk' sistema/escritorio.nix \
    || error "El portal GTK no selecciona el perfil visual por sesión."

  grep -Fq 'korunix-xdg-desktop-portal-gnome' sistema/escritorio.nix \
    || error "El portal GNOME no selecciona el perfil visual por sesión."

  grep -Fq 'theme = comfyTheme;' sistema/aplicaciones.nix \
    || error "Spotify no usa Comfy desde spicetify-nix."

  grep -Fq 'colorScheme = "Comfy";' sistema/aplicaciones.nix \
    || error "Spotify no declara el esquema base de Comfy."

  ! grep -Fq 'spicePkgs.themes.defaultDynamic' sistema/aplicaciones.nix \
    || error "Spotify todavía usa DefaultDynamic en vez de Comfy."

  grep -Fq 'korunix-spotify-theme-sync' sistema/aplicaciones.nix \
    || error "Falta el adaptador de la paleta Noctalia para Spotify."

  grep -Fq 'noctalia-palette.js' sistema/aplicaciones.nix \
    || error "Spotify no puede recargar en vivo la paleta de Noctalia."

  grep -Fq 'systemd.user.paths.korunix-spicetify-palette-sync' sistema/aplicaciones.nix \
    || error "Spotify no observa los cambios de la paleta de Noctalia."

  grep -Fq '# @KORUNIX_SPOTIFY_TEMPLATE@' config/noctalia/config.toml \
    || error "Falta el punto de inserción de la plantilla Spotify."

  ! grep -F 'community_ids' config/noctalia/config.toml | grep -Fq '"spicetify"' \
    || error "La plantilla comunitaria de Spicetify duplicaría la integración Korunix."

  [[ -f config/noctalia/themes/spicetify/color.ini ]] \
    || error "Falta la plantilla Material 3 para Spotify."
}

validar_ciclo_cambios() {
  local preview_block
  local build_block
  local apply_block

  for funcion in \
    ciclo_cambio_lineas_json \
    ciclo_cambio_impacto_json \
    ciclo_cambio_diferencias_texto \
    ciclo_cambio_activacion_texto \
    ciclo_cambio_preparar \
    ciclo_cambio_json \
    mostrar_ciclo_cambio_humano
  do
    grep -Eq \
      "^${funcion}\\(\\)[[:space:]]*\\{" \
      scripts/korunix \
      || error "Falta el motor común de C.1: ${funcion}."
  done

  preview_block="$(
    sed -n \
      '/^previsualizar() {/,/^construir() {/p' \
      scripts/korunix
  )"

  build_block="$(
    sed -n \
      '/^construir() {/,/^verificar_sistema() {/p' \
      scripts/korunix
  )"

  apply_block="$(
    sed -n \
      '/^aplicar() {/,/^actualizar() {/p' \
      scripts/korunix
  )"

  grep -Fq \
    'ciclo_cambio_preparar preview' \
    <<<"$preview_block" \
    || error "preview no consume el motor común."

  grep -Fq \
    'ciclo_cambio_preparar build' \
    <<<"$build_block" \
    || error "build no consume el motor común."

  grep -Fq \
    'ciclo_cambio_preparar preview' \
    <<<"$apply_block" \
    || error "apply no consume el motor común."

  if grep -Fq \
      'construir_candidato' \
      <<<"$preview_block"
  then
    error "preview conserva un constructor paralelo."
  fi

  if grep -Fq \
      'construir_candidato' \
      <<<"$build_block"
  then
    error "build conserva un constructor paralelo."
  fi

  if grep -Fq \
      'construir_candidato' \
      <<<"$apply_block"
  then
    error "apply conserva un constructor paralelo."
  fi

  grep -Fq \
    'sudo nixos-rebuild' \
    <<<"$apply_block" \
    || error "apply perdió la activación real de NixOS."

  grep -Fq \
    'apply --yes --json' \
    scripts/korunix \
    || error "La ayuda no documenta la interfaz JSON de apply."

  grep -Fq \
    'previsualizar "$@"' \
    scripts/korunix \
    || error "preview sigue descartando argumentos."

  grep -Fq \
    'construir "$@"' \
    scripts/korunix \
    || error "build sigue descartando argumentos."

  grep -Fq \
    'aplicar "$@"' \
    scripts/korunix \
    || error "apply sigue descartando argumentos."

  grep -Fq \
    'apply --json necesita --yes' \
    <<<"$apply_block" \
    || error "La salida JSON de apply no exige confirmación externa."
}

validar_actualizaciones() {
  local update_block

  for funcion in \
    actualizacion_entradas_json \
    actualizacion_plan_json \
    mostrar_plan_actualizacion \
    actualizacion_resultado_json \
    actualizacion_restaurar_pendiente
  do
    grep -Eq \
      "^${funcion}\\(\\)[[:space:]]*\\{" \
      scripts/korunix \
      || error "Falta el contrato C.2: ${funcion}."
  done

  update_block="$(
    sed -n \
      '/^actualizar() {/,/^entrada_boot_para_generacion() {/p' \
      scripts/korunix
  )"

  grep -Fq \
    'actualizacion_plan_json' \
    <<<"$update_block" \
    || error "update no consume el plan C.2."

  grep -Fq \
    'nix flake update' \
    <<<"$update_block" \
    || error "update perdió nix flake update."

  grep -Fq \
    'actualizacion_restaurar_pendiente' \
    <<<"$update_block" \
    || error "update no restaura flake.lock ante fallo."

  grep -Fq \
    'validar' \
    <<<"$update_block" \
    || error "update no valida el resultado."

  grep -Fq \
    'update --plan --json' \
    scripts/korunix \
    || error "Falta el plan JSON público de update."

  grep -Fq \
    'actualizar "$@"' \
    scripts/korunix \
    || error "El dispatcher no propaga argumentos de update."

  grep -Eq \
    '^mostrar_plan_canal_json\(\)[[:space:]]*\{' \
    scripts/korunix \
    || error "Falta el contrato estructurado de canales."

  grep -Eq \
    '^ciclo_cambio_json\(\)[[:space:]]*\{' \
    scripts/korunix \
    || error "Falta C.1 para calcular el impacto posterior."

  [[ -r canales.nix ]] \
    || error "Falta canales.nix."
}

validar_recuperacion() {
  local rollback_block

  for funcion in \
    recuperacion_bootloader \
    recuperacion_generaciones_json \
    recuperacion_plan_json \
    mostrar_plan_recuperacion \
    recuperacion_resultado_json \
    grub_entrada_desde_config \
    recuperacion_archivo_grub \
    recuperacion_programar_systemd_boot \
    recuperacion_programar_grub
  do
    grep -Eq \
      "^${funcion}\\(\\)[[:space:]]*\\{" \
      scripts/korunix \
      || error "Falta el contrato C.3: ${funcion}."
  done

  rollback_block="$(
    sed -n \
      '/^rollback_generacion() {/,/^mostrar_plan_limpieza() {/p' \
      scripts/korunix
  )"

  grep -Fq \
    'recuperacion_plan_json' \
    <<<"$rollback_block" \
    || error "rollback no consume el plan C.3."

  grep -Fq \
    'recuperacion_programar_systemd_boot' \
    <<<"$rollback_block" \
    || error "rollback perdió systemd-boot."

  grep -Fq \
    'recuperacion_programar_grub' \
    <<<"$rollback_block" \
    || error "rollback no implementa GRUB."

  grep -Fq \
    'rollback --list --json' \
    scripts/korunix \
    || error "Falta el listado JSON de recuperación."

  grep -Fq \
    'rollback <id> --plan --json' \
    scripts/korunix \
    || error "Falta el plan JSON de recuperación."

  grep -Fq \
    'rollback_generacion "$@"' \
    scripts/korunix \
    || error "El dispatcher no propaga argumentos de rollback."

  grep -Fq \
    'bootctl set-oneshot' \
    scripts/korunix \
    || error "Falta el arranque único de systemd-boot."

  grep -Fq \
    'grub-reboot' \
    scripts/korunix \
    || error "Falta el arranque único de GRUB."
}

validar_limpieza_almacenamiento() {
  local rollback_block
  local storage_block

  for funcion in \
    recuperacion_estado_directorio \
    recuperacion_guardar_proteccion \
    limpieza_generacion_recuperacion_programada \
    limpieza_plan_json \
    mostrar_plan_limpieza_humano \
    limpieza_resultado_json \
    limpieza_privilegiada \
    operacion_progreso \
    almacenamiento_lista_json \
    almacenamiento_disco_padre \
    almacenamiento_plan_json \
    mostrar_plan_almacenamiento_humano \
    almacenamiento_progreso \
    almacenamiento_resultado_json \
    almacenamiento_expulsar \
    gestionar_almacenamiento
  do
    grep -Eq \
      "^${funcion}\\(\\)[[:space:]]*\\{" \
      scripts/korunix \
      || error "Falta el contrato C.4: ${funcion}."
  done

  rollback_block="$(
    sed -n \
      '/^rollback_generacion() {/,/^recuperacion_estado_directorio() {/p' \
      scripts/korunix
  )"

  grep -Fq \
    'recuperacion_guardar_proteccion' \
    <<<"$rollback_block" \
    || error "La recuperación preparada no queda protegida frente a la limpieza."

  grep -Fq \
    'clean-preview --json' \
    scripts/korunix \
    || error "Falta el plan JSON de limpieza normal."

  grep -Fq \
    'clean-all-preview --json' \
    scripts/korunix \
    || error "Falta el plan JSON de limpieza agresiva."

  grep -Fq \
    'storage --list --json' \
    scripts/korunix \
    || error "Falta el inventario estructurado de almacenamiento."

  grep -Fq \
    'storage eject <dispositivo> --plan --json' \
    scripts/korunix \
    || error "Falta el plan estructurado de expulsión."

  grep -Fq \
    'gestionar_almacenamiento "$@"' \
    scripts/korunix \
    || error "El dispatcher no expone almacenamiento."

  storage_block="$(
    sed -n \
      '/^almacenamiento_lista_json() {/,/^preparar_plan_limpieza() {/p' \
      scripts/korunix
  )"

  grep -Fq \
    'sync -f' \
    <<<"$storage_block" \
    || error "El modo pesado no usa sincronización por sistema de archivos."

  grep -Fq \
    'udisksctl unmount' \
    <<<"$storage_block" \
    || error "La expulsión no desmonta mediante UDisks."

  grep -Fq \
    'udisksctl power-off' \
    <<<"$storage_block" \
    || error "La expulsión no apaga mediante UDisks."

  if grep -Eq \
    '^[[:space:]]*sync[[:space:]]*$' \
    <<<"$storage_block"
  then
    error "C.4 introdujo un sync global."
  fi
}

validar_firmware_privilegios() {
  local sudo_block

  for funcion in \
    privilegio_binario \
    privilegio_backend \
    privilegio_ejecutar \
    sudo \
    privilegios_json \
    firmware_fwupd_json \
    firmware_dispositivos_json \
    firmware_actualizaciones_json \
    firmware_plan_json \
    firmware_refresh \
    firmware_update \
    gestionar_firmware
  do
    grep -Eq \
      "^${funcion}\\(\\)[[:space:]]*\\{" \
      scripts/korunix \
      || error "Falta el contrato C.5: ${funcion}()."
  done

  grep -Fq \
    'security.polkit.enable = true;' \
    sistema/equipo.nix \
    || error "Polkit no está habilitado declarativamente."

  grep -Fq \
    'services.fwupd.enable = true;' \
    sistema/equipo.nix \
    || error "fwupd dejó de estar habilitado."

  grep -Fq \
    'systemd.services.fwupd-refresh.enable = false;' \
    sistema/equipo.nix \
    || error "El refresco automático de fwupd volvió a activarse."

  sudo_block="$(
    sed -n \
      '/^sudo() {/,/^privilegios_json() {/p' \
      scripts/korunix
  )"

  grep -Fq \
    "privilegio_ejecutar \"\$@\"" \
    <<<"$sudo_block" \
    || error "Las llamadas históricas a sudo no cruzan la frontera C.5."

  grep -Fq \
    'firmware devices --json' \
    scripts/korunix \
    || error "Falta el inventario JSON de firmware."

  grep -Fq \
    'firmware updates --json' \
    scripts/korunix \
    || error "Falta la consulta JSON de actualizaciones de firmware."

  grep -Fq \
    'firmware refresh --plan --json' \
    scripts/korunix \
    || error "Falta el plan de refresco de firmware."

  grep -Fq \
    'firmware update <device-id> --plan --json' \
    scripts/korunix \
    || error "Falta el plan de actualización de firmware."

  grep -Fq \
    'privileges --json' \
    scripts/korunix \
    || error "Falta el modelo de privilegios para interfaces superiores."
}

validar_multimedia() {
  local media_block

  for funcion in \
    media_bin \
    media_wpctl_nodes_json \
    media_audio_json \
    media_audio_set_default \
    media_audio_set_volume \
    media_audio_set_mute \
    media_audio_set_profile \
    media_audio_set_port \
    media_speaker_test \
    media_mic_meter \
    media_mic_test \
    media_camera_list_json \
    media_camera_plan_json \
    media_camera_preview \
    media_status_json \
    gestionar_media
  do
    grep -Eq \
      "^${funcion}\\(\\)[[:space:]]*\\{" \
      scripts/korunix \
      || error "Falta el contrato C.6: ${funcion}."
  done

  grep -Fq \
    'services.pipewire' \
    sistema/equipo.nix \
    || error "PipeWire no está declarado para el centro multimedia."

  grep -Fq \
    'wireplumber.enable = true;' \
    sistema/equipo.nix \
    || error "WirePlumber no está declarado."

  for paquete in \
    pkgs.pipewire \
    pkgs.wireplumber \
    pkgs.pulseaudio \
    pkgs.v4l-utils \
    pkgs.ffmpeg \
    pkgs.python3
  do
    grep -Fq \
      "$paquete" \
      sistema/equipo.nix \
      || error "Falta la herramienta multimedia declarativa: ${paquete}."
  done

  grep -Fq \
    'media status --json' \
    scripts/korunix \
    || error "Falta el estado multimedia estructurado."

  grep -Fq \
    'media audio test-output' \
    scripts/korunix \
    || error "Falta la prueba de salida de audio."

  grep -Fq \
    'media mic meter' \
    scripts/korunix \
    || error "Falta el medidor de micrófono."

  grep -Fq \
    'media mic test' \
    scripts/korunix \
    || error "Falta la grabación temporal de micrófono."

  grep -Fq \
    'media camera preview' \
    scripts/korunix \
    || error "Falta la previsualización de cámara."

  media_block="$(
    sed -n \
      '/^media_bin() {/,/^ruta_actual() {/p' \
      scripts/korunix
  )"

  grep -Fq 'set-default' <<<"$media_block" \
    || error "Falta selección explícita de dispositivo predeterminado."

  grep -Fq 'set-volume' <<<"$media_block" \
    || error "Falta control de volumen."

  grep -Fq 'set-mute' <<<"$media_block" \
    || error "Falta control de silencio."

  grep -Fq 'set-card-profile' <<<"$media_block" \
    || error "Falta selección de perfil de audio."

  grep -Fq 'set-sink-port' <<<"$media_block" \
    || error "Falta selección de puerto de salida."

  grep -Fq 'set-source-port' <<<"$media_block" \
    || error "Falta selección de puerto de entrada."

  if grep -Eq 'pw-loopback|pw-link' <<<"$media_block"; then
    error "El centro multimedia no debe monitorizar directamente el micrófono hacia altavoces."
  fi
}

validar() {
  local host_id

  echo
  echo "=== Estructura ==="
  validar_estructura

  echo
  echo "=== Ciclo de cambios ==="
  validar_ciclo_cambios
  echo "✓ ciclo de cambios"

  echo
  echo "=== Actualizaciones y migraciones ==="
  validar_actualizaciones
  echo "✓ actualizaciones y migraciones"

  echo
  echo "=== Recuperación y rollback ==="
  validar_recuperacion
  echo "✓ recuperación y rollback"

  echo
  echo "=== Limpieza y almacenamiento ==="
  validar_limpieza_almacenamiento
  echo "✓ limpieza y almacenamiento"

  echo
  echo "=== Firmware y privilegios ==="
  validar_firmware_privilegios
  echo "✓ firmware y privilegios"

  echo
  echo "=== Dispositivos multimedia ==="
  validar_multimedia
  echo "✓ dispositivos multimedia"
  echo "✓ estructura"

  echo
  echo "=== Git ==="
  git diff --check
  git diff --cached --check
  echo "✓ diferencias"

  echo
  echo "=== Flake ==="
  nix flake check --no-build --show-trace

  echo
  echo "=== Hosts ==="

  while IFS= read -r host_id; do
    printf "• %s: " "$host_id"

    nix eval \
      ".#nixosConfigurations.${host_id}.config.system.build.toplevel.drvPath" \
      --raw

    echo
  done < <(hosts_disponibles)

  echo
  echo "=== Modelo Korunix · ${HOST} ==="
  nix eval ".#nixosConfigurations.${HOST}.config.korunix" --json
  echo

  echo
  echo "✓ VALIDACIÓN COMPLETA"
}

formatear() {
  mapfile -d "" archivos < <(
    find . \
      -path "./.git" -prune -o \
      -type f -name "*.nix" -print0
  )

  if [[ "${#archivos[@]}" -gt 0 ]]; then
    nix fmt "${archivos[@]}"
  fi
}

# ---------------------------------------------------------------------------
# C.5 · Firmware y frontera de privilegios
# ---------------------------------------------------------------------------

privilegio_binario() {
  local programa="$1"
  local system_bin
  local ruta=""

  if [[ "$programa" == /nix/store/*/bin/switch-to-configuration ]]; then
    [[ -x "$programa" ]] \
      || error "La generación candidata no contiene un activador ejecutable."

    printf '%s\n' "$programa"
    return
  fi

  case "$programa" in
    true|test|cat|systemctl|nixos-rebuild|bootctl|grub-reboot|grub-editenv|nix-env|nix-collect-garbage|nix)
      ;;
    *)
      error "Korunix rechazó un programa privilegiado no permitido: $programa"
      ;;
  esac

  if [[ "${KORUNIX_TEST_MODE:-0}" == "1" \
    && -n "${KORUNIX_SYSTEM_BIN_DIR:-}" ]]
  then
    ruta="${KORUNIX_SYSTEM_BIN_DIR}/${programa}"
  else
    system_bin="/run/current-system/sw/bin"
    ruta="${system_bin}/${programa}"

    if [[ ! -x "$ruta" ]]; then
      ruta="$(type -P "$programa" 2>/dev/null || true)"
    fi

    case "$ruta" in
      /run/current-system/sw/bin/*|/run/wrappers/bin/*|/nix/store/*)
        ;;
      *)
        error "Korunix no confía en la ruta administrativa resuelta para $programa."
        ;;
    esac
  fi

  [[ -x "$ruta" ]] \
    || error "El componente administrativo no está disponible: $ruta"

  printf '%s\n' "$ruta"
}

privilegio_backend() {
  local pkexec_path=""
  local sudo_path=""

  if [[ "${KORUNIX_TEST_MODE:-0}" == "1" ]]; then
    pkexec_path="${KORUNIX_PKEXEC:-}"
  fi

  if [[ -z "$pkexec_path" ]]; then
    pkexec_path="$(type -P pkexec 2>/dev/null || true)"
  fi

  if [[ -n "$pkexec_path" && -x "$pkexec_path" ]]; then
    printf '%s\n' polkit
    return
  fi

  sudo_path="$(type -P sudo 2>/dev/null || true)"

  if [[ -t 0 && -t 1 && -n "$sudo_path" && -x "$sudo_path" ]]; then
    printf '%s\n' terminal-sudo-fallback
    return
  fi

  printf '%s\n' unavailable
}

privilegio_ejecutar() {
  local programa="${1:-}"
  local ruta
  local backend
  local pkexec_path
  local sudo_path

  [[ -n "$programa" ]] \
    || error "Falta la operación privilegiada."

  shift

  ruta="$(privilegio_binario "$programa")"
  backend="$(privilegio_backend)"

  case "$backend" in
    polkit)
      if [[ "${KORUNIX_TEST_MODE:-0}" == "1" ]]; then
        pkexec_path="${KORUNIX_PKEXEC:-}"
      else
        pkexec_path=""
      fi

      if [[ -z "$pkexec_path" ]]; then
        pkexec_path="$(type -P pkexec)"
      fi

      "$pkexec_path" \
        --disable-internal-agent \
        "$ruta" \
        "$@"
      ;;
    terminal-sudo-fallback)
      sudo_path="$(type -P sudo)"
      command "$sudo_path" "$ruta" "$@"
      ;;
    *)
      error "Polkit no está disponible. Korunix no elevará una interfaz gráfica mediante sudo."
      ;;
  esac
}

# Compatibilidad interna: los frentes C.1-C.4 ya llaman a sudo en puntos
# concretos. Desde C.5 esas llamadas ya no invocan directamente el binario
# sudo: Bash resuelve primero esta función y todas cruzan la frontera común.
sudo() {
  if [[ "${1:-}" == "-v" ]]; then
    shift
    [[ "$#" -eq 0 ]] \
      || error "La autorización previa no acepta argumentos adicionales."

    privilegio_ejecutar true
    return
  fi

  privilegio_ejecutar "$@"
}

privilegios_json() {
  local backend
  local gui_usable=false
  local terminal_fallback=false

  backend="$(privilegio_backend)"

  [[ "$backend" == "polkit" ]] \
    && gui_usable=true

  [[ "$backend" == "terminal-sudo-fallback" ]] \
    && terminal_fallback=true

  # Variables internas del filtro jq.
  # shellcheck disable=SC2016
  jq -cn \
    --arg backend "$backend" \
    --argjson guiUsable "$gui_usable" \
    --argjson terminalFallback "$terminal_fallback" \
    '{
      schemaVersion: 1,
      kind: "korunix-privilege-model",
      guiRunsAsRoot: false,
      backend: $backend,
      guiUsable: $guiUsable,
      terminalSudoFallback: $terminalFallback,
      internalPasswordAutomation: false,
      pseudoTtyAllowed: false,
      policy: {
        systemMutationsUsePolkitWhenAvailable: true,
        firmwareUsesFwupdDbusPolkit: true,
        nonPrivilegedOperationsStayUnprivileged: true
      }
    }'
}

firmware_fwupd_json() {
  local accion="$1"
  local salida=""
  local errores
  local estado=0

  command -v fwupdmgr >/dev/null 2>&1 \
    || error "fwupdmgr no está disponible."

  errores="$(mktemp "${TMPDIR:-/tmp}/korunix-fwupd.XXXXXX")"

  if salida="$(fwupdmgr "$accion" --json 2>"$errores")"; then
    estado=0
  else
    estado=$?
  fi

  if [[ -s "$errores" ]]; then
    cat "$errores" >&2
  fi

  rm -f "$errores"

  case "$estado" in
    0)
      ;;
    2)
      [[ -n "$salida" ]] \
        || salida='{"Devices":[]}'
      ;;
    *)
      error "fwupd no pudo completar ${accion}."
      ;;
  esac

  jq -e 'type == "object"' <<<"$salida" >/dev/null \
    || error "fwupd no devolvió JSON válido."

  printf '%s\n' "$salida"
}

firmware_dispositivos_json() {
  local raw

  raw="$(firmware_fwupd_json get-devices)"

  jq -c '
    {
      schemaVersion: 1,
      kind: "korunix-firmware-devices",
      backend: "fwupd",
      devices: [
        (.Devices // [])[]
        | {
            id: (.DeviceId // null),
            name: (.Name // "Dispositivo sin nombre"),
            summary: (.Summary // null),
            vendor: (.Vendor // null),
            currentVersion: (.Version // null),
            protocol: (.Protocol // null),
            flags: (.Flags // []),
            problems: (.Problems // []),
            updatable: (((.Flags // []) | index("updatable")) != null),
            supported: (((.Flags // []) | index("supported")) != null),
            needsReboot: (((.Flags // []) | index("needs-reboot")) != null),
            needsShutdown: (((.Flags // []) | index("needs-shutdown")) != null),
            requiresAcPower: (((.Flags // []) | index("require-ac")) != null)
          }
      ]
    }
  ' <<<"$raw"
}

firmware_actualizaciones_json() {
  local raw

  raw="$(firmware_fwupd_json get-updates)"

  jq -c '
    {
      schemaVersion: 1,
      kind: "korunix-firmware-updates",
      backend: "fwupd",
      metadataRefreshPerformed: false,
      devices: [
        (.Devices // [])[]
        | {
            id: (.DeviceId // null),
            name: (.Name // "Dispositivo sin nombre"),
            summary: (.Summary // null),
            vendor: (.Vendor // null),
            currentVersion: (.Version // null),
            flags: (.Flags // []),
            problems: (.Problems // []),
            needsReboot: (((.Flags // []) | index("needs-reboot")) != null),
            needsShutdown: (((.Flags // []) | index("needs-shutdown")) != null),
            requiresAcPower: (((.Flags // []) | index("require-ac")) != null),
            releases: [
              (.Releases // [])[]
              | {
                  version: (.Version // null),
                  name: (.Name // null),
                  summary: (.Summary // null),
                  description: (.Description // null),
                  urgency: (.Urgency // null),
                  releaseId: (.ReleaseId // null)
                }
            ]
          }
      ]
    }
  ' <<<"$raw"
}

firmware_plan_json() {
  local device_id="$1"
  local updates
  local target

  [[ -n "$device_id" ]] \
    || error "Falta el identificador del dispositivo."

  updates="$(firmware_actualizaciones_json)"

  # $id es una variable interna de jq.
  # shellcheck disable=SC2016
  target="$(
    jq -c \
      --arg id "$device_id" \
      '.devices[] | select(.id == $id)' \
      <<<"$updates"
  )"

  [[ -n "$target" ]] \
    || error "No hay una actualización disponible para ${device_id}."

  # Variables internas del filtro jq.
  # shellcheck disable=SC2016
  jq -cn \
    --arg hostId "$HOST" \
    --argjson device "$target" \
    '{
      schemaVersion: 1,
      kind: "korunix-firmware-update-plan",
      hostId: $hostId,
      backend: "fwupd",
      device: $device,
      targetRelease: ($device.releases[0] // null),
      effect: (
        if $device.needsShutdown
        then "shutdown"
        elif $device.needsReboot
        then "reboot"
        else "immediate"
        end
      ),
      requirements: {
        explicitUserAction: true,
        acPower: $device.requiresAcPower,
        privilegeBackend: "fwupd-dbus-polkit"
      },
      actions: {
        planWritesSystem: false,
        refreshesMetadata: false,
        installsFirmware: true,
        automaticallyReboots: false
      }
    }'
}

firmware_refresh() {
  local formato="human"
  local modo="execute"
  local confirmado=false
  local argumento
  local estado=0

  for argumento in "$@"; do
    case "$argumento" in
      --plan)
        [[ "$modo" == "execute" ]] || error "--plan está repetido."
        modo="plan"
        ;;
      --yes)
        [[ "$confirmado" == false ]] || error "--yes está repetido."
        confirmado=true
        ;;
      --json)
        [[ "$formato" == "human" ]] || error "--json está repetido."
        formato="json"
        ;;
      *)
        error "Opción de firmware refresh desconocida: $argumento"
        ;;
    esac
  done

  if [[ "$modo" == "plan" ]]; then
    [[ "$confirmado" == false ]] || error "--yes no se utiliza junto con --plan."

    if [[ "$formato" == "json" ]]; then
      jq -cn '{
        schemaVersion: 1,
        kind: "korunix-firmware-refresh-plan",
        backend: "fwupd",
        networkAccess: true,
        writesFirmwareMetadata: true,
        installsFirmware: false,
        explicitUserAction: true
      }'
    else
      echo "Korunix actualizará únicamente los metadatos de fwupd."
      echo "No se instalará firmware."
    fi

    return
  fi

  if [[ "$formato" == "json" && "$confirmado" == false ]]; then
    error "firmware refresh --json necesita --yes."
  fi

  if [[ "$confirmado" == false ]]; then
    confirmar "¿Actualizar los metadatos de firmware?" || return 0
  fi

  if [[ "$formato" == "json" ]]; then
    if fwupdmgr --assume-yes refresh >&2; then
      estado=0
    else
      estado=$?
    fi
  else
    if fwupdmgr --assume-yes refresh; then
      estado=0
    else
      estado=$?
    fi
  fi

  case "$estado" in
    0|2)
      ;;
    *)
      error "No se pudieron actualizar los metadatos de firmware."
      ;;
  esac

  if [[ "$formato" == "json" ]]; then
    jq -cn \
      --argjson exitCode "$estado" \
      '{
        schemaVersion: 1,
        kind: "korunix-firmware-refresh-result",
        completed: true,
        exitCode: $exitCode,
        firmwareInstalled: false
      }'
  else
    echo
    echo "✓ METADATOS DE FIRMWARE ACTUALIZADOS"
    echo "No se instaló firmware."
  fi
}

firmware_update() {
  local device_id="$1"
  shift

  local formato="human"
  local modo="execute"
  local confirmado=false
  local argumento
  local plan
  local estado=0

  [[ -n "$device_id" ]] \
    || error "Falta el identificador del dispositivo."

  for argumento in "$@"; do
    case "$argumento" in
      --plan)
        [[ "$modo" == "execute" ]] || error "--plan está repetido."
        modo="plan"
        ;;
      --yes)
        [[ "$confirmado" == false ]] || error "--yes está repetido."
        confirmado=true
        ;;
      --json)
        [[ "$formato" == "human" ]] || error "--json está repetido."
        formato="json"
        ;;
      *)
        error "Opción de firmware update desconocida: $argumento"
        ;;
    esac
  done

  if [[ "$modo" == "plan" && "$confirmado" == true ]]; then
    error "--yes no se utiliza junto con --plan."
  fi

  if [[ "$modo" == "execute" && "$formato" == "json" && "$confirmado" == false ]]; then
    error "firmware update --json necesita --yes."
  fi

  plan="$(firmware_plan_json "$device_id")"

  if [[ "$modo" == "plan" ]]; then
    if [[ "$formato" == "json" ]]; then
      printf '%s\n' "$plan"
    else
      echo "=== Plan de firmware ==="
      echo "Dispositivo: $(jq -r '.device.name' <<<"$plan")"
      echo "Actual: $(jq -r '.device.currentVersion // "desconocida"' <<<"$plan")"
      echo "Objetivo: $(jq -r '.targetRelease.version // "desconocida"' <<<"$plan")"
      echo "Efecto: $(jq -r '.effect' <<<"$plan")"
      echo "Korunix no reiniciará ni apagará automáticamente el equipo."
    fi
    return
  fi

  if [[ "$formato" == "human" ]]; then
    echo "=== Actualización de firmware ==="
    echo "Dispositivo: $(jq -r '.device.name' <<<"$plan")"
    echo "Objetivo: $(jq -r '.targetRelease.version // "desconocida"' <<<"$plan")"
    echo "Efecto posterior: $(jq -r '.effect' <<<"$plan")"
    echo
  fi

  if [[ "$confirmado" == false ]]; then
    confirmar "¿Instalar esta actualización de firmware?" || return 0
  fi

  if [[ "$formato" == "json" ]]; then
    if fwupdmgr --assume-yes --no-reboot-check update "$device_id" >&2; then
      estado=0
    else
      estado=$?
    fi
  else
    if fwupdmgr --assume-yes --no-reboot-check update "$device_id"; then
      estado=0
    else
      estado=$?
    fi
  fi

  case "$estado" in
    0|2)
      ;;
    *)
      error "fwupd no pudo completar la actualización solicitada."
      ;;
  esac

  if [[ "$formato" == "json" ]]; then
    # Variables internas del filtro jq.
    # shellcheck disable=SC2016
    jq -cn \
      --argjson plan "$plan" \
      --argjson exitCode "$estado" \
      '{
        schemaVersion: 1,
        kind: "korunix-firmware-update-result",
        device: $plan.device,
        targetRelease: $plan.targetRelease,
        effect: $plan.effect,
        commandCompleted: true,
        noActionNeeded: ($exitCode == 2),
        exitCode: $exitCode,
        automaticRebootPerformed: false
      }'
  else
    echo
    echo "✓ SOLICITUD DE FIRMWARE COMPLETADA"
    case "$(jq -r '.effect' <<<"$plan")" in
      reboot)
        echo "Se necesita reiniciar para completar la aplicación."
        ;;
      shutdown)
        echo "Se necesita apagar completamente el equipo para completar la aplicación."
        ;;
      *)
        echo "fwupd no indicó un reinicio o apagado obligatorio."
        ;;
    esac
    echo "Korunix no reinició ni apagó automáticamente el equipo."
  fi
}

gestionar_firmware() {
  local accion="${1:-}"
  local device_id
  local datos

  case "$accion" in
    devices)
      shift
      case "${1:-}" in
        "")
          datos="$(firmware_dispositivos_json)"
          echo "=== Firmware detectado ==="
          jq -r '
            if (.devices | length) == 0
            then "No se detectaron dispositivos administrados por fwupd."
            else
              .devices[]
              | "• " + .name
                + (if .currentVersion then " · " + .currentVersion else "" end)
                + (if .vendor then " · " + .vendor else "" end)
            end
          ' <<<"$datos"
          ;;
        --json)
          [[ "$#" -eq 1 ]] || error "Uso: firmware devices [--json]."
          firmware_dispositivos_json
          ;;
        *)
          error "Uso: firmware devices [--json]."
          ;;
      esac
      ;;
    updates)
      shift
      case "${1:-}" in
        "")
          datos="$(firmware_actualizaciones_json)"
          echo "=== Actualizaciones de firmware ==="
          jq -r '
            if (.devices | length) == 0
            then "No hay actualizaciones en los metadatos locales."
            else
              .devices[]
              | "• " + .name
                + ": " + (.currentVersion // "?")
                + " → " + (.releases[0].version // "?")
            end
          ' <<<"$datos"
          ;;
        --json)
          [[ "$#" -eq 1 ]] || error "Uso: firmware updates [--json]."
          firmware_actualizaciones_json
          ;;
        *)
          error "Uso: firmware updates [--json]."
          ;;
      esac
      ;;
    refresh)
      shift
      firmware_refresh "$@"
      ;;
    update)
      shift
      [[ "$#" -ge 1 ]] \
        || error "Uso: firmware update <device-id> [--plan] [--yes] [--json]."
      device_id="$1"
      shift
      firmware_update "$device_id" "$@"
      ;;
    -h|--help|"")
      cat <<'FIRMWARE_USAGE'
Uso:
  scripts/korunix firmware devices [--json]
  scripts/korunix firmware updates [--json]
  scripts/korunix firmware refresh --plan [--json]
  scripts/korunix firmware refresh [--yes] [--json]
  scripts/korunix firmware update <device-id> --plan [--json]
  scripts/korunix firmware update <device-id> [--yes] [--json]

Inventario, actualizaciones cacheadas y planes no modifican firmware.
refresh actualiza metadatos de fwupd después de una acción explícita.
update actúa únicamente sobre el dispositivo seleccionado.
Korunix no reinicia ni apaga automáticamente el equipo.
FIRMWARE_USAGE
      ;;
    *)
      error "Acción de firmware desconocida: $accion"
      ;;
  esac
}

# ---------------------------------------------------------------------------
# C.6 · Dispositivos multimedia
#
# El motor de audio usa PipeWire/WirePlumber. Las pruebas de micrófono y cámara
# solo se activan por una acción explícita. Probar un dispositivo nunca lo hace
# predeterminado y las grabaciones temporales se eliminan salvo petición expresa.
# ---------------------------------------------------------------------------

media_bin() {
  local programa="$1"
  local dir="${KORUNIX_MEDIA_BIN_DIR:-}"

  case "$programa" in
    wpctl|pactl|pw-play|pw-record|v4l2-ctl|ffplay|python3)
      ;;
    *)
      error "Herramienta multimedia desconocida: $programa"
      ;;
  esac

  if [[ -n "$dir" ]]; then
    [[ -x "$dir/$programa" ]] \
      || error "Falta el stub multimedia: $dir/$programa"

    printf '%s\n' "$dir/$programa"
    return
  fi

  command -v "$programa" 2>/dev/null \
    || error "No está disponible la herramienta multimedia: $programa"
}

media_wpctl_nodes_json() {
  local clase="$1"
  local wpctl_bin
  local python_bin
  local salida

  case "$clase" in
    sinks|sources)
      ;;
    *)
      error "Clase de audio desconocida: $clase"
      ;;
  esac

  wpctl_bin="$(media_bin wpctl)"
  python_bin="$(media_bin python3)"

  salida="$("$wpctl_bin" list audio "$clase")"

  KORUNIX_WPCTL_LIST="$salida" \
  KORUNIX_WPCTL_BIN="$wpctl_bin" \
  "$python_bin" <<'PY_MEDIA_WPCTL'
import json
import os
import re
import subprocess

text = os.environ.get("KORUNIX_WPCTL_LIST", "")
wpctl = os.environ["KORUNIX_WPCTL_BIN"]
items = []

for raw in text.splitlines():
    if not raw.strip():
        continue
    parts = raw.rstrip("\n").split("\t")
    if len(parts) < 3:
        continue
    first = parts[0].strip()
    default = first.startswith("*") or any(p.strip() == "*" for p in parts[3:])
    first = first.lstrip("*").strip().rstrip(".")
    if not first.isdigit():
        continue
    name = parts[1].strip()
    media_class = parts[2].strip()
    volume = None
    muted = False
    proc = subprocess.run(
        [wpctl, "get-volume", first],
        text=True,
        capture_output=True,
        check=False,
    )
    if proc.returncode == 0:
        match = re.search(r"Volume:\s*([0-9.]+)", proc.stdout)
        if match:
            volume = float(match.group(1))
        muted = "[MUTED]" in proc.stdout
    items.append(
        {
            "id": int(first),
            "name": name,
            "mediaClass": media_class,
            "default": default,
            "volume": volume,
            "muted": muted,
        }
    )

print(json.dumps(items, ensure_ascii=False, separators=(",", ":")))
PY_MEDIA_WPCTL
}

media_audio_json() {
  local pactl_bin
  local sinks
  local sources
  local cards
  local pulse_sinks
  local pulse_sources

  pactl_bin="$(media_bin pactl)"
  sinks="$(media_wpctl_nodes_json sinks)"
  sources="$(media_wpctl_nodes_json sources)"
  cards="$("$pactl_bin" -f json list cards)"
  pulse_sinks="$("$pactl_bin" -f json list sinks)"
  pulse_sources="$("$pactl_bin" -f json list sources)"

  # Variables internas de jq.
  # shellcheck disable=SC2016
  jq -cn \
    --argjson sinks "$sinks" \
    --argjson sources "$sources" \
    --argjson cards "$cards" \
    --argjson pulseSinks "$pulse_sinks" \
    --argjson pulseSources "$pulse_sources" \
    '{
      schemaVersion: 1,
      kind: "korunix-media-audio",
      backend: "pipewire-wireplumber",
      defaults: {
        sinkId: ([ $sinks[] | select(.default) | .id ][0] // null),
        sourceId: ([ $sources[] | select(.default) | .id ][0] // null)
      },
      sinks: $sinks,
      sources: $sources,
      cards: [
        $cards[]?
        | {
            index: (.index // null),
            name: (.name // null),
            driver: (.driver // null),
            properties: (.properties // {}),
            activeProfile: (
              (.active_profile // null)
              | if type == "object" then (.name // .description // null) else . end
            ),
            profiles: (
              (.profiles // {}) as $profiles
              | if ($profiles | type) == "object" then
                  $profiles
                  | to_entries
                  | map({
                      id: .key,
                      description: (.value.description // null),
                      sinks: (.value.n_sinks // 0),
                      sources: (.value.n_sources // 0),
                      priority: (.value.priority // 0),
                      available: (.value.available // null)
                    })
                elif ($profiles | type) == "array" then
                  $profiles
                  | map({
                      id: (.name // .id // null),
                      description: (.description // null),
                      sinks: (.n_sinks // 0),
                      sources: (.n_sources // 0),
                      priority: (.priority // 0),
                      available: (.available // null)
                    })
                else [] end
            ),
            ports: (
              (.ports // []) as $ports
              | if ($ports | type) == "array" then
                  $ports
                  | map({
                      name: (.name // null),
                      description: (.description // null),
                      type: (.type // null),
                      availability: (.availability // null)
                    })
                elif ($ports | type) == "object" then
                  $ports
                  | to_entries
                  | map({
                      name: .key,
                      description: (.value.description // null),
                      type: (.value.type // null),
                      availability: (.value.availability // null)
                    })
                else [] end
            )
          }
      ],
      pulse: {
        sinks: [
          $pulseSinks[]?
          | {
              index: (.index // null),
              name: (.name // null),
              description: (.description // null),
              mute: (.mute // false),
              activePort: (.active_port // null),
              ports: (.ports // [])
            }
        ],
        sources: [
          $pulseSources[]?
          | {
              index: (.index // null),
              name: (.name // null),
              description: (.description // null),
              mute: (.mute // false),
              activePort: (.active_port // null),
              ports: (.ports // [])
            }
        ]
      }
    }'
}

media_audio_set_default() {
  local clase="$1"
  local id="$2"
  local wpctl_bin

  case "$clase" in
    sink|source)
      ;;
    *)
      error "Usa sink o source para cambiar el dispositivo predeterminado."
      ;;
  esac

  [[ "$id" =~ ^[0-9]+$ ]] \
    || error "ID de audio inválido: $id"

  wpctl_bin="$(media_bin wpctl)"
  "$wpctl_bin" set-default "$id"

  jq -cn \
    --arg kind "$clase" \
    --argjson id "$id" \
    '{schemaVersion:1,kind:"korunix-media-audio-default-result",deviceKind:$kind,id:$id,changed:true}'
}

media_audio_set_volume() {
  local id="$1"
  local valor="$2"
  local wpctl_bin
  local numero

  [[ "$id" =~ ^[0-9]+$ ]] \
    || error "ID de audio inválido: $id"
  [[ "$valor" =~ ^[0-9]{1,3}%$ ]] \
    || error "El volumen debe expresarse como porcentaje entero, por ejemplo 75%."

  numero="${valor%\%}"
  (( numero >= 0 && numero <= 150 )) \
    || error "Korunix limita el volumen entre 0% y 150%."

  wpctl_bin="$(media_bin wpctl)"
  "$wpctl_bin" set-volume "$id" "$valor" --limit 1.5

  jq -cn \
    --argjson id "$id" \
    --arg volume "$valor" \
    '{schemaVersion:1,kind:"korunix-media-volume-result",id:$id,volume:$volume,changed:true}'
}

media_audio_set_mute() {
  local id="$1"
  local estado="$2"
  local wpctl_bin

  [[ "$id" =~ ^[0-9]+$ ]] \
    || error "ID de audio inválido: $id"

  case "$estado" in
    0|1|toggle)
      ;;
    *)
      error "El silencio debe ser 0, 1 o toggle."
      ;;
  esac

  wpctl_bin="$(media_bin wpctl)"
  "$wpctl_bin" set-mute "$id" "$estado"

  jq -cn \
    --argjson id "$id" \
    --arg state "$estado" \
    '{schemaVersion:1,kind:"korunix-media-mute-result",id:$id,state:$state,changed:true}'
}

media_audio_set_profile() {
  local card="$1"
  local profile="$2"
  local pactl_bin

  [[ -n "$card" && -n "$profile" ]] \
    || error "Faltan tarjeta o perfil."

  pactl_bin="$(media_bin pactl)"
  "$pactl_bin" set-card-profile "$card" "$profile"

  jq -cn \
    --arg card "$card" \
    --arg profile "$profile" \
    '{schemaVersion:1,kind:"korunix-media-profile-result",card:$card,profile:$profile,changed:true}'
}

media_audio_set_port() {
  local clase="$1"
  local objeto="$2"
  local puerto="$3"
  local pactl_bin

  [[ -n "$objeto" && -n "$puerto" ]] \
    || error "Faltan dispositivo o puerto."

  pactl_bin="$(media_bin pactl)"

  case "$clase" in
    sink)
      "$pactl_bin" set-sink-port "$objeto" "$puerto"
      ;;
    source)
      "$pactl_bin" set-source-port "$objeto" "$puerto"
      ;;
    *)
      error "Usa sink o source para cambiar un puerto."
      ;;
  esac

  jq -cn \
    --arg kind "$clase" \
    --arg object "$objeto" \
    --arg port "$puerto" \
    '{schemaVersion:1,kind:"korunix-media-port-result",deviceKind:$kind,object:$object,port:$port,changed:true}'
}

media_confirmar_prueba() {
  local formato="$1"
  local confirmado="$2"
  local mensaje="$3"

  if [[ "$formato" == "json" && "$confirmado" == false ]]; then
    error "La prueba multimedia JSON necesita --yes porque activa temporalmente un dispositivo."
  fi

  if [[ "$formato" == "human" && "$confirmado" == false ]]; then
    confirmar "$mensaje" || return 1
  fi

  return 0
}

media_speaker_test() {
  local sink="$1"
  shift

  local formato="human"
  local confirmado=false
  local canal="both"
  local segundos=2
  local argumento
  local pwplay_bin
  local python_bin

  [[ "$sink" =~ ^[0-9]+$ ]] \
    || error "ID de salida inválido: $sink"

  while [[ "$#" -gt 0 ]]; do
    argumento="$1"
    shift
    case "$argumento" in
      --channel)
        [[ "$#" -gt 0 ]] || error "Falta left, right o both."
        canal="$1"
        shift
        ;;
      --seconds)
        [[ "$#" -gt 0 ]] || error "Falta duración."
        segundos="$1"
        shift
        ;;
      --yes)
        confirmado=true
        ;;
      --json)
        formato="json"
        ;;
      *)
        error "Opción desconocida para test-output: $argumento"
        ;;
    esac
  done

  case "$canal" in
    left|right|both)
      ;;
    *)
      error "Canal de prueba inválido: $canal"
      ;;
  esac
  [[ "$segundos" =~ ^[1-5]$ ]] \
    || error "La prueba de altavoces dura entre 1 y 5 segundos."

  media_confirmar_prueba \
    "$formato" "$confirmado" \
    "¿Reproducir una prueba temporal en la salida ${sink}?" \
    || return 0

  pwplay_bin="$(media_bin pw-play)"
  python_bin="$(media_bin python3)"

  KORUNIX_MEDIA_CHANNEL="$canal" \
  KORUNIX_MEDIA_SECONDS="$segundos" \
  "$python_bin" -c '
import math, os, struct, sys
rate = 48000
seconds = int(os.environ["KORUNIX_MEDIA_SECONDS"])
channel = os.environ["KORUNIX_MEDIA_CHANNEL"]
frames = rate * seconds
out = sys.stdout.buffer
for i in range(frames):
    tone = int(32767 * 0.18 * math.sin(2 * math.pi * 440 * i / rate))
    if channel == "left":
        left, right = tone, 0
    elif channel == "right":
        left, right = 0, tone
    else:
        if i < frames // 2:
            left, right = tone, 0
        else:
            left, right = 0, tone
    out.write(struct.pack("<hh", left, right))
' | "$pwplay_bin" \
      --target "$sink" \
      --raw \
      --rate 48000 \
      --format s16 \
      --channels 2 \
      --channel-map stereo \
      --volume 0.25 \
      -

  if [[ "$formato" == "json" ]]; then
    jq -cn \
      --argjson sink "$sink" \
      --arg channel "$canal" \
      --argjson seconds "$segundos" \
      '{schemaVersion:1,kind:"korunix-media-speaker-test-result",sinkId:$sink,channel:$channel,seconds:$seconds,completed:true,changedDefault:false}'
  else
    echo "✓ Prueba de salida terminada; no cambió el dispositivo predeterminado."
  fi
}

media_mic_meter() {
  local source="$1"
  shift

  local formato="human"
  local confirmado=false
  local segundos=5
  local argumento
  local pwrecord_bin
  local python_bin
  local json_flag=false

  [[ "$source" =~ ^[0-9]+$ ]] \
    || error "ID de micrófono inválido: $source"

  while [[ "$#" -gt 0 ]]; do
    argumento="$1"
    shift
    case "$argumento" in
      --seconds)
        [[ "$#" -gt 0 ]] || error "Falta duración."
        segundos="$1"
        shift
        ;;
      --yes)
        confirmado=true
        ;;
      --json)
        formato="json"
        json_flag=true
        ;;
      *)
        error "Opción desconocida para mic meter: $argumento"
        ;;
    esac
  done

  [[ "$segundos" =~ ^([1-9]|[12][0-9]|30)$ ]] \
    || error "El medidor admite entre 1 y 30 segundos."

  media_confirmar_prueba \
    "$formato" "$confirmado" \
    "¿Activar temporalmente el micrófono ${source} para medir señal?" \
    || return 0

  pwrecord_bin="$(media_bin pw-record)"
  python_bin="$(media_bin python3)"

  "$pwrecord_bin" \
    --target "$source" \
    --raw \
    --rate 16000 \
    --format s16 \
    --channels 1 \
    --channel-map mono \
    --sample-count "$((16000 * segundos))" \
    - \
    | KORUNIX_MEDIA_METER_JSON="$json_flag" \
      KORUNIX_MEDIA_SOURCE="$source" \
      "$python_bin" -c '
import array, json, math, os, sys
json_mode = os.environ.get("KORUNIX_MEDIA_METER_JSON") == "true"
source = int(os.environ["KORUNIX_MEDIA_SOURCE"])
chunk_bytes = 3200
index = 0
while True:
    data = sys.stdin.buffer.read(chunk_bytes)
    if not data:
        break
    samples = array.array("h")
    samples.frombytes(data[: len(data) - (len(data) % 2)])
    if not samples:
        continue
    rms = math.sqrt(sum(x*x for x in samples) / len(samples)) / 32768.0
    peak = max(abs(x) for x in samples) / 32768.0
    payload = {
        "schemaVersion": 1,
        "kind": "korunix-media-mic-meter-sample",
        "sourceId": source,
        "sequence": index,
        "rms": round(rms, 6),
        "peak": round(peak, 6),
    }
    if json_mode:
        print(json.dumps(payload, separators=(",", ":")), flush=True)
    else:
        print("señal rms={:.3f} pico={:.3f}".format(payload["rms"], payload["peak"]), flush=True)
    index += 1
'
}

media_mic_test() {
  local source="$1"
  shift

  local formato="human"
  local confirmado=false
  local segundos=3
  local sink=""
  local save=""
  local argumento
  local pwrecord_bin
  local pwplay_bin

  [[ "$source" =~ ^[0-9]+$ ]] \
    || error "ID de micrófono inválido: $source"

  while [[ "$#" -gt 0 ]]; do
    argumento="$1"
    shift
    case "$argumento" in
      --seconds)
        [[ "$#" -gt 0 ]] || error "Falta duración."
        segundos="$1"
        shift
        ;;
      --sink)
        [[ "$#" -gt 0 ]] || error "Falta salida."
        sink="$1"
        shift
        ;;
      --save)
        [[ "$#" -gt 0 ]] || error "Falta ruta de destino."
        save="$1"
        shift
        ;;
      --yes)
        confirmado=true
        ;;
      --json)
        formato="json"
        ;;
      *)
        error "Opción desconocida para mic test: $argumento"
        ;;
    esac
  done

  [[ "$segundos" =~ ^([1-9]|10)$ ]] \
    || error "La grabación de prueba admite entre 1 y 10 segundos."
  if [[ -n "$sink" ]]; then
    [[ "$sink" =~ ^[0-9]+$ ]] \
      || error "ID de salida inválido: $sink"
  fi

  media_confirmar_prueba \
    "$formato" "$confirmado" \
    "¿Grabar temporalmente el micrófono ${source} y reproducir la muestra?" \
    || return 0

  pwrecord_bin="$(media_bin pw-record)"
  pwplay_bin="$(media_bin pw-play)"

  (
    set -euo pipefail
    umask 077
    runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
    if [[ ! -d "$runtime_dir" || ! -w "$runtime_dir" ]]; then
      runtime_dir="/tmp"
    fi
    local_dir="$(mktemp -d "$runtime_dir/korunix-media.XXXXXX")"
    recording="$local_dir/microfono.wav"
    trap 'rm -rf -- "$local_dir"' EXIT

    "$pwrecord_bin" \
      --target "$source" \
      --rate 48000 \
      --channels 1 \
      --sample-count "$((48000 * segundos))" \
      "$recording"

    if [[ -n "$sink" ]]; then
      "$pwplay_bin" --target "$sink" "$recording"
    else
      "$pwplay_bin" "$recording"
    fi

    saved=false
    saved_path=""
    if [[ -n "$save" ]]; then
      mkdir -p -- "$(dirname -- "$save")"
      cp -- "$recording" "$save"
      chmod 600 -- "$save"
      saved=true
      saved_path="$save"
    fi

    if [[ "$formato" == "json" ]]; then
      jq -cn \
        --argjson source "$source" \
        --arg sink "$sink" \
        --argjson seconds "$segundos" \
        --argjson saved "$saved" \
        --arg savedPath "$saved_path" \
        '{
          schemaVersion:1,
          kind:"korunix-media-mic-test-result",
          sourceId:$source,
          sinkId:(if $sink == "" then null else ($sink|tonumber) end),
          seconds:$seconds,
          completed:true,
          directMonitoring:false,
          changedDefault:false,
          saved:$saved,
          savedPath:(if $savedPath == "" then null else $savedPath end)
        }'
    else
      echo "✓ Grabación reproducida."
      if [[ "$saved" == true ]]; then
        echo "✓ Copia conservada en: $saved_path"
      else
        echo "✓ La grabación temporal fue eliminada."
      fi
      echo "✓ No se realizó monitorización directa ni se cambió el predeterminado."
    fi
  )
}

media_camera_list_json() {
  local v4l2_bin
  local python_bin
  local dispositivos=""

  v4l2_bin="$(media_bin v4l2-ctl)"
  python_bin="$(media_bin python3)"

  if [[ -n "${KORUNIX_VIDEO_DEVICES:-}" ]]; then
    dispositivos="$KORUNIX_VIDEO_DEVICES"
  else
    dispositivos="$(printf '%s\n' /dev/video* 2>/dev/null || true)"
    if [[ "$dispositivos" == "/dev/video*" ]]; then
      dispositivos=""
    fi
  fi

  KORUNIX_V4L2_BIN="$v4l2_bin" \
  KORUNIX_VIDEO_DEVICES_LIST="$dispositivos" \
  "$python_bin" <<'PY_MEDIA_CAMERA'
import json
import os
import re
import subprocess

v4l = os.environ["KORUNIX_V4L2_BIN"]
paths = [p for p in os.environ.get("KORUNIX_VIDEO_DEVICES_LIST", "").splitlines() if p]
devices = []

for path in paths:
    info_p = subprocess.run([v4l, "-d", path, "--info"], text=True, capture_output=True, check=False)
    if info_p.returncode != 0:
        continue
    fmt_p = subprocess.run([v4l, "-d", path, "--list-formats-ext"], text=True, capture_output=True, check=False)
    info = info_p.stdout
    formats_text = fmt_p.stdout if fmt_p.returncode == 0 else ""

    def field(label):
        m = re.search(rf"^\s*{re.escape(label)}\s*:\s*(.+)$", info, flags=re.MULTILINE)
        return m.group(1).strip() if m else None

    formats = []
    current_format = None
    current_mode = None
    for line in formats_text.splitlines():
        m = re.search(r"\[\d+\]:\s*'([^']+)'\s*\(([^)]*)\)", line)
        if m:
            current_format = {"pixelFormat": m.group(1), "description": m.group(2), "modes": []}
            formats.append(current_format)
            current_mode = None
            continue
        m = re.search(r"Size:\s*Discrete\s+(\d+)x(\d+)", line)
        if m and current_format is not None:
            current_mode = {"width": int(m.group(1)), "height": int(m.group(2)), "fps": []}
            current_format["modes"].append(current_mode)
            continue
        m = re.search(r"\(([0-9.]+)\s*fps\)", line)
        if m and current_mode is not None:
            value = float(m.group(1))
            if value not in current_mode["fps"]:
                current_mode["fps"].append(value)

    devices.append(
        {
            "device": path,
            "driver": field("Driver name"),
            "card": field("Card type"),
            "bus": field("Bus info"),
            "version": field("Driver version"),
            "formats": formats,
        }
    )

print(json.dumps({"schemaVersion": 1, "kind": "korunix-media-cameras", "backend": "v4l2", "devices": devices}, ensure_ascii=False, separators=(",", ":")))
PY_MEDIA_CAMERA
}

media_camera_plan_json() {
  local device="$1"
  local size="$2"
  local fps="$3"
  local cameras
  local target
  local default_width
  local default_height
  local default_fps
  local width
  local height
  local chosen_fps
  local supported

  cameras="$(media_camera_list_json)"

  target="$(
    jq -c \
      --arg device "$device" \
      '.devices[] | select(.device == $device)' \
      <<<"$cameras"
  )"

  [[ -n "$target" ]] \
    || error "La cámara no existe o no es accesible: $device"

  if [[ -n "$size" && ! "$size" =~ ^[0-9]+x[0-9]+$ ]]; then
    error "La resolución debe escribirse como ANCHOxALTO."
  fi
  if [[ -n "$fps" && ! "$fps" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
    error "FPS inválidos: $fps"
  fi

  default_width="$(jq -r '.formats[0].modes[0].width // empty' <<<"$target")"
  default_height="$(jq -r '.formats[0].modes[0].height // empty' <<<"$target")"
  default_fps="$(jq -r '.formats[0].modes[0].fps[0] // empty' <<<"$target")"

  width="$default_width"
  height="$default_height"
  chosen_fps="$default_fps"

  if [[ -n "$size" ]]; then
    width="${size%x*}"
    height="${size#*x}"
  fi
  if [[ -n "$fps" ]]; then
    chosen_fps="$fps"
  fi

  if [[ -n "$size" || -n "$fps" ]]; then
    supported="$(
      jq -r \
        --arg width "$width" \
        --arg height "$height" \
        --arg fps "$chosen_fps" \
        '[
          .formats[].modes[]?
          | select((.width|tostring) == $width and (.height|tostring) == $height)
          | if $fps == "" then true else any(.fps[]?; . == ($fps|tonumber)) end
        ] | any' \
        <<<"$target"
    )"
    [[ "$supported" == true ]] \
      || error "La cámara no anunció la resolución/FPS solicitados."
  fi

  jq -cn \
    --argjson camera "$target" \
    --arg width "$width" \
    --arg height "$height" \
    --arg fps "$chosen_fps" \
    '{
      schemaVersion:1,
      kind:"korunix-media-camera-preview-plan",
      backend:"v4l2",
      camera:$camera,
      mode:{
        width:(if $width == "" then null else ($width|tonumber) end),
        height:(if $height == "" then null else ($height|tonumber) end),
        fps:(if $fps == "" then null else ($fps|tonumber) end)
      },
      privacy:{explicitUserAction:true,backgroundCapture:false,persistsRecording:false},
      actions:{changesDefault:false,writesConfiguration:false}
    }'
}

media_camera_preview() {
  local device="$1"
  shift

  local formato="human"
  local modo="execute"
  local confirmado=false
  local size=""
  local fps=""
  local argumento
  local plan
  local width
  local height
  local chosen_fps
  local ffplay_bin
  local args=()

  while [[ "$#" -gt 0 ]]; do
    argumento="$1"
    shift
    case "$argumento" in
      --size)
        [[ "$#" -gt 0 ]] || error "Falta resolución."
        size="$1"
        shift
        ;;
      --fps)
        [[ "$#" -gt 0 ]] || error "Faltan FPS."
        fps="$1"
        shift
        ;;
      --plan)
        modo="plan"
        ;;
      --yes)
        confirmado=true
        ;;
      --json)
        formato="json"
        ;;
      *)
        error "Opción desconocida para camera preview: $argumento"
        ;;
    esac
  done

  if [[ "$modo" == "plan" && "$confirmado" == true ]]; then
    error "--yes no se utiliza junto con --plan."
  fi

  plan="$(media_camera_plan_json "$device" "$size" "$fps")"

  if [[ "$modo" == "plan" ]]; then
    if [[ "$formato" == "json" ]]; then
      printf '%s\n' "$plan"
    else
      echo "Cámara: $(jq -r '.camera.card // .camera.device' <<<"$plan")"
      echo "Resolución: $(jq -r 'if .mode.width == null then "automática" else ((.mode.width|tostring)+"x"+(.mode.height|tostring)) end' <<<"$plan")"
      echo "FPS: $(jq -r '.mode.fps // "automáticos"' <<<"$plan")"
      echo "La previsualización no cambia la cámara predeterminada ni guarda vídeo."
    fi
    return
  fi

  media_confirmar_prueba \
    "$formato" "$confirmado" \
    "¿Abrir temporalmente la cámara ${device}?" \
    || return 0

  ffplay_bin="$(media_bin ffplay)"
  width="$(jq -r '.mode.width // empty' <<<"$plan")"
  height="$(jq -r '.mode.height // empty' <<<"$plan")"
  chosen_fps="$(jq -r '.mode.fps // empty' <<<"$plan")"

  args=(-hide_banner -loglevel warning -f v4l2)
  if [[ -n "$width" && -n "$height" ]]; then
    args+=(-video_size "${width}x${height}")
  fi
  if [[ -n "$chosen_fps" ]]; then
    args+=(-framerate "$chosen_fps")
  fi
  args+=(-i "$device")

  "$ffplay_bin" "${args[@]}"

  if [[ "$formato" == "json" ]]; then
    jq -cn \
      --argjson plan "$plan" \
      '{schemaVersion:1,kind:"korunix-media-camera-preview-result",camera:$plan.camera,mode:$plan.mode,completed:true,changedDefault:false,recordingSaved:false}'
  else
    echo "✓ Previsualización cerrada; no se guardó vídeo ni cambió la predeterminada."
  fi
}

media_status_json() {
  local audio
  local cameras

  audio="$(media_audio_json)"
  cameras="$(media_camera_list_json)"

  jq -cn \
    --argjson audio "$audio" \
    --argjson cameras "$cameras" \
    '{schemaVersion:1,kind:"korunix-media-status",audio:$audio,cameras:$cameras}'
}

gestionar_media() {
  local area="${1:-}"
  local accion
  local objeto

  case "$area" in
    status)
      shift
      case "${1:-}" in
        "")
          media_status_json | jq .
          ;;
        --json)
          [[ "$#" -eq 1 ]] || error "Uso: media status [--json]."
          media_status_json
          ;;
        *)
          error "Uso: media status [--json]."
          ;;
      esac
      ;;
    audio)
      shift
      accion="${1:-}"
      shift || true
      case "$accion" in
        list)
          case "${1:-}" in
            "") media_audio_json | jq . ;;
            --json) [[ "$#" -eq 1 ]] || error "Uso: media audio list [--json]."; media_audio_json ;;
            *) error "Uso: media audio list [--json]." ;;
          esac
          ;;
        default)
          [[ "$#" -eq 2 ]] || error "Uso: media audio default <sink|source> <id>."
          media_audio_set_default "$1" "$2"
          ;;
        volume)
          [[ "$#" -eq 2 ]] || error "Uso: media audio volume <id> <porcentaje>."
          media_audio_set_volume "$1" "$2"
          ;;
        mute)
          [[ "$#" -eq 2 ]] || error "Uso: media audio mute <id> <0|1|toggle>."
          media_audio_set_mute "$1" "$2"
          ;;
        profile)
          [[ "$#" -eq 2 ]] || error "Uso: media audio profile <tarjeta> <perfil>."
          media_audio_set_profile "$1" "$2"
          ;;
        port)
          [[ "$#" -eq 3 ]] || error "Uso: media audio port <sink|source> <objeto> <puerto>."
          media_audio_set_port "$1" "$2" "$3"
          ;;
        test-output)
          [[ "$#" -ge 1 ]] || error "Uso: media audio test-output <sink-id> [--channel left|right|both] [--seconds N] [--yes] [--json]."
          objeto="$1"
          shift
          media_speaker_test "$objeto" "$@"
          ;;
        *)
          error "Acción de audio desconocida: $accion"
          ;;
      esac
      ;;
    mic)
      shift
      accion="${1:-}"
      shift || true
      case "$accion" in
        meter)
          [[ "$#" -ge 1 ]] || error "Uso: media mic meter <source-id> [--seconds N] [--yes] [--json]."
          objeto="$1"
          shift
          media_mic_meter "$objeto" "$@"
          ;;
        test)
          [[ "$#" -ge 1 ]] || error "Uso: media mic test <source-id> [--sink ID] [--seconds N] [--save RUTA] [--yes] [--json]."
          objeto="$1"
          shift
          media_mic_test "$objeto" "$@"
          ;;
        *)
          error "Acción de micrófono desconocida: $accion"
          ;;
      esac
      ;;
    camera)
      shift
      accion="${1:-}"
      shift || true
      case "$accion" in
        list)
          case "${1:-}" in
            "") media_camera_list_json | jq . ;;
            --json) [[ "$#" -eq 1 ]] || error "Uso: media camera list [--json]."; media_camera_list_json ;;
            *) error "Uso: media camera list [--json]." ;;
          esac
          ;;
        preview)
          [[ "$#" -ge 1 ]] || error "Uso: media camera preview <device> [--size WxH] [--fps N] [--plan] [--yes] [--json]."
          objeto="$1"
          shift
          media_camera_preview "$objeto" "$@"
          ;;
        *)
          error "Acción de cámara desconocida: $accion"
          ;;
      esac
      ;;
    -h|--help|"")
      cat <<'MEDIA_USAGE'
Uso:
  scripts/korunix media status --json
  scripts/korunix media audio list --json
  scripts/korunix media audio default <sink|source> <id>
  scripts/korunix media audio volume <id> <porcentaje>
  scripts/korunix media audio mute <id> <0|1|toggle>
  scripts/korunix media audio profile <tarjeta> <perfil>
  scripts/korunix media audio port <sink|source> <objeto> <puerto>
  scripts/korunix media audio test-output <sink-id> [--channel left|right|both] [--seconds N] [--yes] [--json]

  scripts/korunix media mic meter <source-id> [--seconds N] [--yes] [--json]
  scripts/korunix media mic test <source-id> [--sink ID] [--seconds N] [--save RUTA] [--yes] [--json]

  scripts/korunix media camera list --json
  scripts/korunix media camera preview <device> [--size WxH] [--fps N] --plan --json
  scripts/korunix media camera preview <device> [--size WxH] [--fps N] [--yes] [--json]

Las pruebas de salida y entrada usan el dispositivo elegido como target sin hacerlo
predeterminado. El medidor de micrófono no monitoriza directamente hacia los
altavoces. La grabación de prueba se borra salvo que se use --save. La cámara
solo se abre durante una previsualización explícita y no guarda vídeo.
MEDIA_USAGE
      ;;
    *)
      error "Área multimedia desconocida: $area"
      ;;
  esac
}

ruta_actual() {
  readlink -f /run/current-system 2>/dev/null || true
}

ruta_predeterminada() {
  readlink -f "$SYSTEM_PROFILE" 2>/dev/null || true
}

generacion_predeterminada() {
  local referencia

  referencia="$(readlink "$SYSTEM_PROFILE" 2>/dev/null || true)"

  if [[ "$referencia" =~ system-([0-9]+)-link$ ]]; then
    printf "%s\n" "${BASH_REMATCH[1]}"
  fi
}

numeros_generaciones() {
  local enlace
  local nombre

  for enlace in "${SYSTEM_PROFILE}"-*-link; do
    [[ -e "$enlace" ]] || continue

    nombre="$(basename "$enlace")"

    if [[ "$nombre" =~ ^system-([0-9]+)-link$ ]]; then
      printf "%s\n" "${BASH_REMATCH[1]}"
    fi
  done | sort -n
}

ruta_generacion() {
  local generacion="$1"

  readlink -f "${SYSTEM_PROFILE}-${generacion}-link" 2>/dev/null || true
}


generacion_de_ruta() {
  local buscada="$1"
  local predeterminada
  local generacion
  local ruta
  local ultima=""

  # Varias generaciones pueden apuntar al mismo sistema exacto. Si la
  # predeterminada coincide con el sistema que está ejecutándose, ese es el
  # número más humano y menos ambiguo que debemos mostrar.
  predeterminada="$(generacion_predeterminada)"

  if [[ -n "$predeterminada" ]]; then
    ruta="$(ruta_generacion "$predeterminada")"

    if [[ -n "$ruta" && "$ruta" == "$buscada" ]]; then
      printf "%s
" "$predeterminada"
      return
    fi
  fi

  # Si la generación predeterminada no coincide, elegimos la coincidencia más
  # reciente en lugar de atribuir el sistema a una generación antigua idéntica.
  while IFS= read -r generacion; do
    ruta="$(ruta_generacion "$generacion")"

    if [[ -n "$ruta" && "$ruta" == "$buscada" ]]; then
      ultima="$generacion"
    fi
  done < <(numeros_generaciones)

  [[ -n "$ultima" ]] && printf "%s
" "$ultima"
}

mostrar_generaciones() {
  local limite="${1:-0}"
  local actual
  local predeterminada
  local generacion_actual
  local generacion
  local enlace
  local ruta
  local fecha
  local estado
  local inicio=0
  local generaciones=()

  actual="$(ruta_actual)"
  predeterminada="$(generacion_predeterminada)"
  generacion_actual="$(generacion_de_ruta "$actual")"

  mapfile -t generaciones < <(numeros_generaciones)

  if [[ "$limite" -gt 0 && "${#generaciones[@]}" -gt "$limite" ]]; then
    inicio=$((${#generaciones[@]} - limite))
    generaciones=("${generaciones[@]:$inicio}")
  fi

  printf "%-6s %-19s %-28s\n" "ID" "FECHA" "ESTADO"
  printf "%-6s %-19s %-28s\n" "----" "-------------------" "----------------------------"

  for generacion in "${generaciones[@]}"; do
    enlace="${SYSTEM_PROFILE}-${generacion}-link"
    ruta="$(ruta_generacion "$generacion")"
    fecha="$(stat -c "%y" "$enlace" 2>/dev/null | cut -d"." -f1)"
    estado=""

    if [[ "$generacion" == "$generacion_actual" ]]; then
      estado="ACTUAL"
    fi

    if [[ "$generacion" == "$predeterminada" ]]; then
      if [[ -n "$estado" ]]; then
        estado="${estado}, PREDETERMINADO"
      else
        estado="PREDETERMINADO"
      fi
    fi

    [[ -n "$estado" ]] || estado="disponible"

    printf "%-6s %-19s %-28s\n" \
      "$generacion" \
      "$fecha" \
      "$estado"

    # La ruta no se imprime normalmente para mantener la vista humana. Sigue
    # disponible mediante el enlace system-N-link cuando haga falta diagnosticar.
    : "$ruta"
  done
}


# Lee un valor DMI sin saltos ni espacios residuales. En equipos sin DMI,
# como determinadas máquinas ARM, devuelve vacío y la detección degrada
# limpiamente en lugar de inventar información.
valor_dmi() {
  local campo="$1"
  local archivo="/sys/class/dmi/id/${campo}"

  [[ -r "$archivo" ]] || return 0

  tr -d '\000' <"$archivo" \
    | sed -E 's/[[:space:]]+$//'
}

tipo_equipo_detectado() {
  local chasis

  chasis="$(valor_dmi chassis_type)"

  # Los números siguen SMBIOS. Una batería cualquiera no participa en esta
  # decisión porque ratones y teclados también pueden exponer Battery.
  case "$chasis" in
    3|4|5|6|7|15|16|24)
      echo "desktop"
      ;;
    8|9|10|14|30|31|32)
      echo "laptop"
      ;;
    13)
      echo "all-in-one"
      ;;
    17|23)
      echo "server"
      ;;
    *)
      echo "unknown"
      ;;
  esac
}

hardware_detectado_json() {
  local modo="${1:-adopted}"
  local host_id="${2:-${HOST:-}}"
  local jq_bin
  local arch_kernel
  local arch_real
  local arch_declarada
  local firmware_real
  local firmware_declarado
  local coincide_arch=false
  local coincide_firmware=false
  local virtualizacion
  local virtualizado=false
  local fabricante
  local modelo
  local placa_fabricante
  local placa_modelo
  local chasis
  local tipo_equipo
  local cpu_modelo
  local cpu_fabricante
  local cpu_logicos
  local microcode
  local memoria_kib
  local memoria_bytes
  local bateria_sistema=false
  local fuente
  local tipo_fuente
  local scope_fuente
  local graficos_texto=""
  local graficos_json
  local drivers_texto=""
  local drivers_json
  local graficos_dispositivos_json
  local red_texto=""
  local red_json
  local almacenamiento_json

  jq_bin="$(command -v jq 2>/dev/null || true)"

  [[ -n "$jq_bin" ]] \
    || error "jq no está disponible. Aplica primero la generación que integra la capa de hardware."

  arch_kernel="$(uname -m)"

  case "$arch_kernel" in
    x86_64)
      arch_real="x86_64-linux"
      ;;
    aarch64|arm64)
      arch_real="aarch64-linux"
      ;;
    *)
      arch_real="${arch_kernel}-linux"
      ;;
  esac

  if [[ -d /sys/firmware/efi ]]; then
    firmware_real="uefi"
  else
    firmware_real="bios"
  fi

  case "$modo" in
    adopted)
      [[ -n "$host_id" ]] \
        || error "La comprobación adoptada necesita un host."

      arch_declarada="$(
        nix eval \
          ".#nixosConfigurations.${host_id}.config.nixpkgs.hostPlatform.system" \
          --raw \
          2>/dev/null \
          || true
      )"

      firmware_declarado="$(
        nix eval \
          ".#nixosConfigurations.${host_id}.config.korunix.hardware.firmware" \
          --raw \
          2>/dev/null \
          || true
      )"

      [[ "$arch_real" == "$arch_declarada" ]] \
        && coincide_arch=true

      [[ "$firmware_real" == "$firmware_declarado" ]] \
        && coincide_firmware=true
      ;;

    physical)
      # Durante la primera adopción todavía no hay un host Korunix contra el
      # cual comparar estos hechos físicos.
      arch_declarada=""
      firmware_declarado=""
      ;;

    *)
      error "Modo de detección de hardware desconocido: $modo"
      ;;
  esac

  virtualizacion="$(
    systemd-detect-virt 2>/dev/null \
      || true
  )"

  if [[ -z "$virtualizacion" || "$virtualizacion" == "none" ]]; then
    virtualizacion="physical"
  else
    virtualizado=true
  fi

  fabricante="$(valor_dmi sys_vendor)"
  modelo="$(valor_dmi product_name)"
  placa_fabricante="$(valor_dmi board_vendor)"
  placa_modelo="$(valor_dmi board_name)"
  chasis="$(valor_dmi chassis_type)"
  tipo_equipo="$(tipo_equipo_detectado)"

  [[ -n "$fabricante" ]] || fabricante="desconocido"
  [[ -n "$modelo" ]] || modelo="desconocido"
  [[ -n "$placa_fabricante" ]] || placa_fabricante="desconocido"
  [[ -n "$placa_modelo" ]] || placa_modelo="desconocido"

  cpu_modelo="$(
    awk -F ':' '
      /^model name/ || /^Processor/ || /^Hardware/ {
        valor = $2
        sub(/^[[:space:]]+/, "", valor)
        print valor
        exit
      }
    ' /proc/cpuinfo 2>/dev/null \
      || true
  )"

  cpu_fabricante="$(
    awk -F ':' '
      /^vendor_id/ {
        valor = $2
        sub(/^[[:space:]]+/, "", valor)
        print valor
        exit
      }
    ' /proc/cpuinfo 2>/dev/null \
      || true
  )"

  cpu_logicos="$(
    awk '
      /^processor[[:space:]]*:/ {
        total++
      }

      END {
        print total + 0
      }
    ' /proc/cpuinfo
  )"

  microcode="$(
    awk -F ':' '
      /^microcode/ {
        valor = $2
        sub(/^[[:space:]]+/, "", valor)
        print valor
        exit
      }
    ' /proc/cpuinfo 2>/dev/null \
      || true
  )"

  [[ -n "$cpu_modelo" ]] || cpu_modelo="desconocido"
  [[ -n "$cpu_fabricante" ]] || cpu_fabricante="desconocido"
  [[ -n "$microcode" ]] || microcode="desconocido"

  memoria_kib="$(
    awk '
      /^MemTotal:/ {
        print $2
        exit
      }
    ' /proc/meminfo
  )"

  memoria_bytes=$((memoria_kib * 1024))

  # Solo una batería de sistema puede reforzar la detección de un portátil.
  # Las baterías con scope=Device pertenecen a periféricos.
  for fuente in /sys/class/power_supply/*; do
    [[ -e "$fuente" ]] || continue

    tipo_fuente="$(cat "$fuente/type" 2>/dev/null || true)"
    scope_fuente="$(cat "$fuente/scope" 2>/dev/null || true)"

    if [[ "$tipo_fuente" == "Battery" && "$scope_fuente" == "System" ]]; then
      bateria_sistema=true
      break
    fi
  done

  if command -v lspci >/dev/null 2>&1; then
    graficos_texto="$(
      lspci -nn 2>/dev/null \
        | grep -E '\[03(00|02|80)\]' \
        || true
    )"

    red_texto="$(
      lspci -nn 2>/dev/null \
        | grep -E '\[02(00|80)\]' \
        || true
    )"
  fi

  if command -v lsmod >/dev/null 2>&1; then
    drivers_texto="$(
      lsmod \
        | awk '
            /^(amdgpu|nvidia|nouveau|i915|xe)[[:space:]]/ {
              print $1
            }
          ' \
        || true
    )"
  fi

  graficos_json="$(
    printf '%s\n' "$graficos_texto" \
      | sed -E 's/^[^[:space:]]+[[:space:]]+//' \
      | "$jq_bin" -R -s '
          split("\n")
          | map(select(length > 0))
        '
  )"

  drivers_json="$(
    printf '%s\n' "$drivers_texto" \
      | "$jq_bin" -R -s '
          split("\n")
          | map(select(length > 0))
          | unique
        '
  )"

  graficos_dispositivos_json="$(
    {
      local dispositivo
      local clase
      local direccion
      local vendor_id
      local device_id
      local subsystem_vendor_id
      local subsystem_device_id
      local vendor
      local driver
      local primary
      local nombre
      local nvidia_open
      local catalog_device
      local catalog_subvendor
      local catalog_subdevice
      local catalog_product

      for dispositivo in /sys/bus/pci/devices/*; do
        [[ -r "$dispositivo/class" ]] || continue

        clase="$(
          tr '[:lower:]' '[:upper:]' \
            <"$dispositivo/class"
        )"
        clase="${clase#0X}"

        case "$clase" in
          030000|030200|038000)
            ;;
          *)
            continue
            ;;
        esac

        direccion="$(basename "$dispositivo")"

        vendor_id="$(
          tr '[:lower:]' '[:upper:]' \
            <"$dispositivo/vendor"
        )"
        vendor_id="${vendor_id#0X}"

        device_id="$(
          tr '[:lower:]' '[:upper:]' \
            <"$dispositivo/device"
        )"
        device_id="${device_id#0X}"

        subsystem_vendor_id="$(
          cat "$dispositivo/subsystem_vendor" 2>/dev/null \
            || printf '0x0000\n'
        )"
        subsystem_vendor_id="$(
          printf '%s' "$subsystem_vendor_id" |
            tr '[:lower:]' '[:upper:]'
        )"
        subsystem_vendor_id="${subsystem_vendor_id#0X}"

        subsystem_device_id="$(
          cat "$dispositivo/subsystem_device" 2>/dev/null \
            || printf '0x0000\n'
        )"
        subsystem_device_id="$(
          printf '%s' "$subsystem_device_id" |
            tr '[:lower:]' '[:upper:]'
        )"
        subsystem_device_id="${subsystem_device_id#0X}"

        case "$vendor_id" in
          1002)
            vendor="amd"
            ;;
          8086)
            vendor="intel"
            ;;
          10DE)
            vendor="nvidia"
            ;;
          *)
            vendor="unknown"
            ;;
        esac

        if [[ -L "$dispositivo/driver" ]]; then
          driver="$(
            basename "$(
              readlink -f "$dispositivo/driver"
            )"
          )"
        else
          driver="none"
        fi

        if [[ "$(cat "$dispositivo/boot_vga" 2>/dev/null || echo 0)" == "1" ]]; then
          primary=true
        else
          primary=false
        fi

        nombre="$(
          lspci -Dnn -s "$direccion" 2>/dev/null |
            cut -d' ' -f2- \
            || true
        )"

        [[ -n "$nombre" ]] || nombre="GPU PCI ${vendor_id}:${device_id}"

        nvidia_open=false

        if [[ "$vendor" == "nvidia" \
          && -r "$ROOT/nvidia-open-pci-ids.txt" ]]
        then
          while IFS=$'\t' read -r \
            catalog_device \
            catalog_subvendor \
            catalog_subdevice \
            catalog_product
          do
            # El nombre comercial forma parte del catálogo y se lee para
            # conservar correctamente sus cuatro columnas, aunque la detección
            # solo necesita los identificadores PCI.
            : "$catalog_product"
            [[ -n "$catalog_device" ]] || continue
            [[ "$catalog_device" != \#* ]] || continue
            [[ "$catalog_device" == "$device_id" ]] || continue

            if [[ "$catalog_subvendor" == "*" \
              && "$catalog_subdevice" == "*" ]]
            then
              nvidia_open=true
              break
            fi

            if [[ "$catalog_subvendor" == "$subsystem_vendor_id" \
              && "$catalog_subdevice" == "$subsystem_device_id" ]]
            then
              nvidia_open=true
              break
            fi
          done <"$ROOT/nvidia-open-pci-ids.txt"
        fi

        # Estas variables pertenecen a jq, no a Bash.
        # shellcheck disable=SC2016
        "$jq_bin" -n \
          --arg pciAddress "$direccion" \
          --arg name "$nombre" \
          --arg vendor "$vendor" \
          --arg vendorId "$vendor_id" \
          --arg deviceId "$device_id" \
          --arg subsystemVendorId "$subsystem_vendor_id" \
          --arg subsystemDeviceId "$subsystem_device_id" \
          --arg class "$clase" \
          --arg driver "$driver" \
          --argjson primary "$primary" \
          --arg kind "unknown" \
          --argjson nvidiaOpen "$nvidia_open" \
          '{
            pciAddress: $pciAddress,
            name: $name,
            vendor: $vendor,
            vendorId: $vendorId,
            deviceId: $deviceId,
            subsystemVendorId: $subsystemVendorId,
            subsystemDeviceId: $subsystemDeviceId,
            class: $class,
            driver: $driver,
            primary: $primary,
            kind: $kind,
            nvidiaOpen: $nvidiaOpen
          }'
      done
    } | "$jq_bin" -s '.'
  )"

  red_json="$(
    printf '%s\n' "$red_texto" \
      | sed -E 's/^[^[:space:]]+[[:space:]]+//' \
      | "$jq_bin" -R -s '
          split("\n")
          | map(select(length > 0))
        '
  )"

  if command -v lsblk >/dev/null 2>&1; then
    almacenamiento_json="$(
      lsblk \
        -J \
        -b \
        -e 7 \
        -o NAME,PATH,TYPE,SIZE,FSTYPE,MOUNTPOINTS,MODEL,TRAN,ROTA,RM
    )"
  else
    almacenamiento_json='{"blockdevices":[]}'
  fi

  # Estas variables pertenecen al programa jq y no deben expandirse en Bash.
  # shellcheck disable=SC2016
  "$jq_bin" -n \
    --argjson schemaVersion 1 \
    --arg hostId "$host_id" \
    --arg detectedAt "$(date --iso-8601=seconds)" \
    --arg machineType "$tipo_equipo" \
    --arg chassisType "$chasis" \
    --arg vendor "$fabricante" \
    --arg model "$modelo" \
    --arg boardVendor "$placa_fabricante" \
    --arg boardModel "$placa_modelo" \
    --argjson systemBattery "$bateria_sistema" \
    --arg architectureDetected "$arch_real" \
    --arg architectureDeclared "$arch_declarada" \
    --argjson architectureMatches "$coincide_arch" \
    --arg firmwareDetected "$firmware_real" \
    --arg firmwareDeclared "$firmware_declarado" \
    --argjson firmwareMatches "$coincide_firmware" \
    --arg virtualization "$virtualizacion" \
    --argjson virtualized "$virtualizado" \
    --arg cpuModel "$cpu_modelo" \
    --arg cpuVendor "$cpu_fabricante" \
    --argjson cpuLogical "$cpu_logicos" \
    --arg microcode "$microcode" \
    --argjson memoryBytes "$memoria_bytes" \
    --argjson graphics "$graficos_json" \
    --argjson graphicsDrivers "$drivers_json" \
    --argjson graphicsDevices "$graficos_dispositivos_json" \
    --argjson network "$red_json" \
    --argjson storage "$almacenamiento_json" \
    '{
      schemaVersion: $schemaVersion,
      hostId: $hostId,
      detectedAt: $detectedAt,

      machine: {
        type: $machineType,
        chassisType: $chassisType,
        vendor: $vendor,
        model: $model,
        boardVendor: $boardVendor,
        boardModel: $boardModel,
        systemBattery: $systemBattery
      },

      platform: {
        detected: $architectureDetected,
        declared: $architectureDeclared,
        matches: $architectureMatches
      },

      firmware: {
        detected: $firmwareDetected,
        declared: $firmwareDeclared,
        matches: $firmwareMatches
      },

      virtualization: {
        kind: $virtualization,
        virtualized: $virtualized
      },

      cpu: {
        model: $cpuModel,
        vendor: $cpuVendor,
        logicalProcessors: $cpuLogical,
        microcode: $microcode
      },

      memory: {
        bytes: $memoryBytes
      },

      graphics: $graphics,
      graphicsDrivers: $graphicsDrivers,
      graphicsDevices: $graphicsDevices,
      network: $network,
      storage: $storage
    }'
}

valor_nix_simple() {
  local archivo="$1"
  local atributo="$2"

  sed -n -E \
    "s/^[[:space:]]*${atributo}[[:space:]]*=[[:space:]]*\"([^\"]+)\";.*$/\1/p" \
    "$archivo" \
    | head -n1
}

bootstrap_host_id() {
  local nombre="$1"
  local normalizado

  normalizado="$(
    printf '%s' "$nombre" \
      | tr '[:upper:]' '[:lower:]' \
      | sed -E \
          -e 's/[^a-z0-9-]+/-/g' \
          -e 's/^-+//' \
          -e 's/-+$//' \
          -e 's/-+/-/g'
  )"

  [[ -n "$normalizado" ]] \
    || normalizado="equipo"

  printf '%s\n' "$normalizado"
}

canales_json() {
  nix eval \
    --json \
    --file "$ROOT/canales.nix"
}

bootstrap_product_defaults_json() {
  local system="$1"
  local jq_bin
  local catalog

  jq_bin="$(command -v jq 2>/dev/null || true)"

  [[ -n "$jq_bin" ]] \
    || error "jq no está disponible."

  [[ -r "$ROOT/predeterminados.nix" ]] \
    || error "Falta predeterminados.nix."

  # Nix interpreta directamente la fuente declarativa. Bash no mantiene una
  # segunda copia de aplicaciones, servicios ni escritorio iniciales.
  catalog="$(
    nix eval \
      --json \
      --file "$ROOT/predeterminados.nix"
  )"

  # $system pertenece a jq. Se escapa para que Bash no intente expandirlo.
  if ! "$jq_bin" -e \
    --arg system "$system" \
    ".applications.bySystem[\$system] != null" \
    <<<"$catalog" \
    >/dev/null
  then
    error \
      "Korunix no tiene defaults de aplicaciones para la arquitectura ${system}."
  fi

  # Estas variables pertenecen a jq, no a Bash.
  # shellcheck disable=SC2016
  "$jq_bin" -n \
    --arg system "$system" \
    --argjson catalog "$catalog" \
    '{
      schemaVersion: $catalog.schemaVersion,
      desktop: $catalog.desktop,
      applications: (
        $catalog.applications.common
        + $catalog.applications.bySystem[$system]
      ),
      services: $catalog.services
    }'
}

bootstrap_localization_json() {
  local config_source="$1"
  local jq_bin
  local raw

  jq_bin="$(command -v jq 2>/dev/null || true)"

  [[ -n "$jq_bin" ]] \
    || error "jq no está disponible."

  [[ -r "$config_source" ]] \
    || error "Falta $config_source."

  # La primera adopción consulta las declaraciones que dejó el instalador.
  # No usa localectl: el estado activo puede pertenecer ya a una generación
  # Korunix posterior y no representa necesariamente la instalación fuente.
  #
  # Solo forzamos los atributos de localización. El resto del módulo permanece
  # perezoso y no se construye ni se aplica.
  raw="$(
    (
      cd "$ROOT"

      nix \
        --extra-experimental-features 'nix-command flakes' \
        eval \
        --impure \
        --json \
        --expr '
          let
            flake =
              builtins.getFlake
                (toString ./.);

            system =
              builtins.currentSystem;

            pkgs =
              builtins.getAttr
                system
                flake.inputs.nixpkgsStable.legacyPackages;

            lib =
              pkgs.lib;

            sourceModule =
              import /etc/nixos/configuration.nix;

            declared =
              if builtins.isFunction sourceModule
              then
                sourceModule {
                  inherit pkgs lib;

                  config = {};
                  options = {};

                  modulesPath =
                    toString flake.inputs.nixpkgsStable
                    + "/nixos/modules";
                }
              else
                sourceModule;

            get = path: fallback:
              lib.attrByPath
                path
                fallback
                declared;
          in {
            timeZone =
              get
                [ "time" "timeZone" ]
                null;

            defaultLocale =
              get
                [ "i18n" "defaultLocale" ]
                null;

            extraLocaleSettings =
              get
                [ "i18n" "extraLocaleSettings" ]
                {};

            consoleKeymap =
              get
                [ "console" "keyMap" ]
                null;

            xkb =
              get
                [ "services" "xserver" "xkb" ]
                {};
          }
        '
    )
  )"

  # Esta capa transforma las declaraciones de NixOS al contrato de Korunix.
  #
  # Para formatos no basta con mirar los overrides existentes: los campos no
  # declarados heredan i18n.defaultLocale. Por eso calculamos los nueve valores
  # efectivos y solo los representamos como un único locale cuando coinciden.
  #
  # Las variables con $ pertenecen a jq.
  # shellcheck disable=SC2016
  "$jq_bin" -c \
    --arg configSource "$config_source" \
    '
      def locale_parts:
        if type != "string"
        then null
        else
          try (
            capture(
              "^(?<language>[A-Za-z]{2,3})_(?<region>[A-Za-z]{2})(?:\\..*)?$"
            )
            | {
                language: (.language | ascii_downcase),
                region: (.region | ascii_upcase)
              }
          )
          catch null
        end;

      def csv:
        if type != "string" or . == ""
        then []
        else
          split(",")
          | map(
              gsub(
                "^[[:space:]]+|[[:space:]]+$";
                ""
              )
            )
        end;

      . as $source

      | [
          "LC_ADDRESS",
          "LC_IDENTIFICATION",
          "LC_MEASUREMENT",
          "LC_MONETARY",
          "LC_NAME",
          "LC_NUMERIC",
          "LC_PAPER",
          "LC_TELEPHONE",
          "LC_TIME"
        ] as $formatKeys

      | (
          $source.defaultLocale
          | locale_parts
        ) as $system

      | [
          $formatKeys[] as $key
          | (
              $source.extraLocaleSettings[$key]
              // $source.defaultLocale
            )
        ] as $effectiveFormatLocales

      | (
          if (
            $effectiveFormatLocales
            | any(
                . == null
                or type != "string"
              )
          )
          then
            null
          else
            (
              $effectiveFormatLocales
              | unique
            ) as $uniqueFormats

            | if ($uniqueFormats | length) == 1
              then
                (
                  $uniqueFormats[0]
                  | locale_parts
                )
              else
                null
              end
          end
        ) as $formats

      | (
          $source.xkb.layout
          // ""
          | csv
        ) as $layouts

      | (
          $source.xkb.variant
          // ""
          | csv
        ) as $variants

      | (
          if ($layouts | length) == 0
          then
            null
          else
            {
              layout: $layouts[0],

              variant:
                ($variants[0] // ""),

              additionalLayouts:
                $layouts[1:],

              additionalVariants:
                [
                  range(
                    1;
                    ($layouts | length)
                  ) as $index

                  | (
                      $variants[$index]
                      // ""
                    )
                ],

              displayNames: [],

              switchOption:
                (
                  if ($source.xkb.options | type) == "string"
                  then $source.xkb.options
                  else ""
                  end
                ),

              console:
                $source.consoleKeymap
            }
          end
        ) as $keyboard

      | {
          timeZone:
            $source.timeZone,

          locale:
            $source.defaultLocale,

          systemLanguage:
            ($system.language // null),

          region:
            ($system.region // null),

          formats:
            if $formats == null
            then null
            else {
              language: $formats.language,
              region: $formats.region
            }
            end,

          consoleKeymap:
            $source.consoleKeymap,

          keyboard:
            $keyboard,

          source: {
            configuration:
              $configSource,

            timeZone:
              "time.timeZone",

            locale:
              "i18n.defaultLocale",

            formats:
              if (
                $source.extraLocaleSettings
                | length
              ) == 0
              then
                "i18n.defaultLocale"
              else
                "i18n.defaultLocale+i18n.extraLocaleSettings"
              end,

            keyboard:
              if $keyboard == null
              then null
              else "services.xserver.xkb"
              end,

            console:
              "console.keyMap"
          },

          needsReview:
            (
              $source.timeZone == null
              or $system == null
              or $formats == null
              or $keyboard == null
              or $source.consoleKeymap == null
            )
        }
    ' \
    <<<"$raw"
}

bootstrap_plan_json() {
  local jq_bin
  local config_source="/etc/nixos/configuration.nix"
  local hardware_source="/etc/nixos/hardware-configuration.nix"
  local host_name
  local host_id
  local state_version
  local localization
  local hardware
  local usuarios
  local user_adoption
  local system
  local product_defaults
  local channel_default

  jq_bin="$(command -v jq 2>/dev/null || true)"

  [[ -n "$jq_bin" ]] \
    || error "jq no está disponible."

  [[ -r "$config_source" ]] \
    || error "Falta $config_source."

  [[ -r "$hardware_source" ]] \
    || error "Falta $hardware_source."

  host_name="$(hostname)"
  host_id="$(bootstrap_host_id "$host_name")"

  state_version="$(
    valor_nix_simple \
      "$config_source" \
      'system\.stateVersion'
  )"

  [[ -n "$state_version" ]] \
    || error "No pude leer system.stateVersion de la instalación."

  localization="$(bootstrap_localization_json "$config_source")"

  hardware="$(
    hardware_detectado_json \
      physical \
      "$host_id"
  )"

  user_adoption="$(
    "$ROOT/scripts/users" __bootstrap-plan
  )"

  usuarios="$(
    "$jq_bin" -c '
      [
        .accounts[]
        | {
            account: .accountName,
            uid: .uid,
            homeDirectory: .homeDirectory,
            shell: .shell,
            administrator: .administrator
          }
      ]
    ' <<<"$user_adoption"
  )"

  system="$(
    "$jq_bin" -r \
      '.platform.detected' \
      <<<"$hardware"
  )"

  product_defaults="$(
    bootstrap_product_defaults_json "$system"
  )"

  channel_default="$(
    canales_json |
      "$jq_bin" -r '.default'
  )"

  [[ "$channel_default" == "stable" \
    || "$channel_default" == "unstable" ]] \
    || error "El catálogo no contiene un canal predeterminado válido."

  # Estas variables pertenecen a jq, no a Bash.
  # shellcheck disable=SC2016
  "$jq_bin" -n \
    --argjson schemaVersion 1 \
    --arg hostId "$host_id" \
    --arg hostName "$host_name" \
    --arg system "$system" \
    --arg stateVersion "$state_version" \
    --arg channel "$channel_default" \
    --argjson localization "$localization" \
    --arg configSource "$config_source" \
    --arg configurationSha256 "$(
      sha256sum "$config_source" |
        cut -d' ' -f1
    )" \
    --arg hardwareSource "$hardware_source" \
    --arg hardwareSha256 "$(
      sha256sum "$hardware_source" |
        cut -d' ' -f1
    )" \
    --arg defaultsSource "predeterminados.nix" \
    --arg defaultsSha256 "$(
      sha256sum "$ROOT/predeterminados.nix" |
        cut -d' ' -f1
    )" \
    --arg channelsSource "canales.nix" \
    --arg channelsSha256 "$(
      sha256sum "$ROOT/canales.nix" |
        cut -d' ' -f1
    )" \
    --argjson hardware "$hardware" \
    --argjson users "$usuarios" \
    --argjson userAdoption "$user_adoption" \
    --argjson productDefaults "$product_defaults" \
    '{
      schemaVersion: $schemaVersion,

      source: {
        configuration: $configSource,
        configurationSha256: $configurationSha256,
        hardware: $hardwareSource,
        hardwareSha256: $hardwareSha256,
        productDefaults: $defaultsSource,
        productDefaultsSha256: $defaultsSha256,
        channels: $channelsSource,
        channelsSha256: $channelsSha256,
        reusesInstalledHardware: true,
        generatesHardware: false
      },

      host: {
        id: $hostId,
        name: $hostName,
        system: $system,
        stateVersion: $stateVersion,
        channel: $channel
      },

      localization: $localization,

      users: $users,

      userAdoption: $userAdoption,

      productDefaults: $productDefaults,

      hardware: {
        machine: $hardware.machine,
        platform: {
          detected: $hardware.platform.detected
        },
        firmware: {
          detected: $hardware.firmware.detected
        },
        graphicsDevices: $hardware.graphicsDevices
      },

      actions: {
        writesRepository: false,
        modifiesEtcNixos: false,
        buildsGeneration: false,
        appliesGeneration: false
      }
    }'
}

bootstrap_adopt_preflight_json() {
  local plan="${1:-}"
  local jq_bin
  local git_root
  local host_id
  local config_source
  local hardware_source
  local defaults_source
  local channels_source
  local expected
  local actual
  local profile_id
  local profile_path
  local target
  local duplicates
  local targets_json
  local -a targets=()

  [[ -n "$plan" ]] \
    || error "Falta el plan de adopción para el preflight."

  jq_bin="$(command -v jq 2>/dev/null || true)"

  [[ -n "$jq_bin" ]] \
    || error "jq no está disponible."

  "$jq_bin" -e . \
    <<<"$plan" \
    >/dev/null \
    || error "El plan de adopción no contiene JSON válido."

  [[ "$(
    git rev-parse \
      --is-inside-work-tree \
      2>/dev/null \
      || true
  )" == "true" ]] \
    || error "Bootstrap --adopt necesita un checkout Git escribible."

  git_root="$(
    git rev-parse \
      --show-toplevel \
      2>/dev/null \
      || true
  )"

  [[ "$git_root" == "$ROOT" ]] \
    || error "Bootstrap --adopt debe ejecutarse desde el checkout raíz de Korunix."

  for target in \
    "$ROOT" \
    "$ROOT/hosts" \
    "$ROOT/hardware" \
    "$ROOT/users" \
    "$ROOT/catalog"
  do
    [[ -d "$target" ]] \
      || error "Falta el directorio requerido: $target"

    [[ -w "$target" ]] \
      || error "El checkout no es escribible en: $target"
  done

  [[ -z "$(
    git status \
      --porcelain=v1 \
      --untracked-files=all
  )" ]] \
    || error "Bootstrap --adopt necesita un checkout limpio."

  "$jq_bin" -e '
    .localization.needsReview == false

    and (.userAdoption.profiles | length) >= 1
    and .userAdoption.summary.administrators >= 1

    and all(
      .userAdoption.profiles[];

      .target.overwriteAllowed == false

      and .credentials.action
        == "preserve-existing"

      and .credentials.importedSecret
        == false
    )

    and .source.reusesInstalledHardware == true
    and .source.generatesHardware == false

    and .actions.writesRepository == false
    and .actions.modifiesEtcNixos == false
    and .actions.buildsGeneration == false
    and .actions.appliesGeneration == false
  ' <<<"$plan" \
    >/dev/null \
    || error "El plan no cumple las precondiciones de primera adopción."

  host_id="$(
    "$jq_bin" -r \
      '.host.id // empty' \
      <<<"$plan"
  )"

  [[ "$host_id" =~ ^[a-z0-9][a-z0-9-]*$ ]] \
    || error "El plan contiene un identificador de host no válido."

  config_source="$(
    "$jq_bin" -r \
      '.source.configuration // empty' \
      <<<"$plan"
  )"

  hardware_source="$(
    "$jq_bin" -r \
      '.source.hardware // empty' \
      <<<"$plan"
  )"

  defaults_source="$(
    "$jq_bin" -r \
      '.source.productDefaults // empty' \
      <<<"$plan"
  )"

  channels_source="$(
    "$jq_bin" -r \
      '.source.channels // empty' \
      <<<"$plan"
  )"

  [[ "$config_source" == "/etc/nixos/configuration.nix" ]] \
    || error "La fuente de configuración instalada no es la esperada."

  [[ "$hardware_source" == "/etc/nixos/hardware-configuration.nix" ]] \
    || error "La fuente de hardware instalada no es la esperada."

  [[ "$defaults_source" == "predeterminados.nix" ]] \
    || error "La fuente de defaults no es la esperada."

  [[ "$channels_source" == "canales.nix" ]] \
    || error "La fuente de canales no es la esperada."

  [[ -r "$config_source" ]] \
    || error "Ya no puedo leer $config_source."

  [[ -r "$hardware_source" ]] \
    || error "Ya no puedo leer $hardware_source."

  [[ -r "$ROOT/$defaults_source" ]] \
    || error "Ya no puedo leer $defaults_source."

  [[ -r "$ROOT/$channels_source" ]] \
    || error "Ya no puedo leer $channels_source."

  expected="$(
    "$jq_bin" -r \
      '.source.configurationSha256 // empty' \
      <<<"$plan"
  )"

  actual="$(
    sha256sum "$config_source" |
      cut -d' ' -f1
  )"

  [[ -n "$expected" && "$actual" == "$expected" ]] \
    || error "configuration.nix cambió después de calcular el plan."

  expected="$(
    "$jq_bin" -r \
      '.source.hardwareSha256 // empty' \
      <<<"$plan"
  )"

  actual="$(
    sha256sum "$hardware_source" |
      cut -d' ' -f1
  )"

  [[ -n "$expected" && "$actual" == "$expected" ]] \
    || error "hardware-configuration.nix cambió después de calcular el plan."

  expected="$(
    "$jq_bin" -r \
      '.source.productDefaultsSha256 // empty' \
      <<<"$plan"
  )"

  actual="$(
    sha256sum "$ROOT/$defaults_source" |
      cut -d' ' -f1
  )"

  [[ -n "$expected" && "$actual" == "$expected" ]] \
    || error "predeterminados.nix cambió después de calcular el plan."

  expected="$(
    "$jq_bin" -r \
      '.source.channelsSha256 // empty' \
      <<<"$plan"
  )"

  actual="$(
    sha256sum "$ROOT/$channels_source" |
      cut -d' ' -f1
  )"

  [[ -n "$expected" && "$actual" == "$expected" ]] \
    || error "canales.nix cambió después de calcular el plan."

  targets+=(
    "equipos/${host_id}.nix"
    "equipos/${host_id}-detectado.nix"
  )

  while IFS=$'\t' read -r \
    profile_id \
    profile_path
  do
    [[ -n "$profile_id" && -n "$profile_path" ]] \
      || error "El plan contiene un perfil incompleto."

    [[ "$profile_id" =~ ^[a-z_][a-z0-9_-]*$ ]] \
      || error "El plan contiene un ID de persona no válido."

    [[ "$profile_path" == "personas/${profile_id}.nix" ]] \
      || error "El destino de perfil no coincide con su ID."

    targets+=("$profile_path")
  done < <(
    "$jq_bin" -r '
      .userAdoption.profiles[]
      | [
          .id,
          .target.profilePath
        ]
      | @tsv
    ' <<<"$plan"
  )

  duplicates="$(
    printf '%s\n' \
      "${targets[@]}" |
      sort |
      uniq -d
  )"

  [[ -z "$duplicates" ]] \
    || error "El plan contiene destinos duplicados."

  for target in "${targets[@]}"; do
    [[ "$target" != /* ]] \
      || error "El plan contiene un destino absoluto no permitido."

    [[ "$target" != ../* && "$target" != */../* ]] \
      || error "El plan contiene una ruta fuera del checkout."

    [[ ! -e "$ROOT/$target" && ! -L "$ROOT/$target" ]] \
      || error "El destino ya existe y no será sobrescrito: $target"
  done

  targets_json="$(
    printf '%s\n' \
      "${targets[@]}" |
      "$jq_bin" -Rsc '
        split("\n")
        | map(
            select(length > 0)
          )
      '
  )"

  # shellcheck disable=SC2016
  "$jq_bin" -cn \
    --arg hostId "$host_id" \
    --argjson targets "$targets_json" \
    '{
      schemaVersion: 1,
      kind: "korunix-bootstrap-adopt-preflight",
      ok: true,
      hostId: $hostId,
      targets: $targets,
      checks: {
        cleanCheckout: true,
        writableCheckout: true,
        localizationReady: true,
        administratorPresent: true,
        credentialsExternal: true,
        sourceHashesMatch: true,
        destinationsFree: true
      }
    }'
}

bootstrap_adopt_lock_acquire() {
  local flock_bin
  local lock_dir

  flock_bin="$(command -v flock 2>/dev/null || true)"

  [[ -n "$flock_bin" ]] \
    || error "flock no está disponible para proteger la adopción inicial."

  [[ -z "${BOOTSTRAP_LOCK_FD:-}" ]] \
    || error "El proceso ya mantiene el bloqueo de bootstrap."

  lock_dir="${XDG_STATE_HOME:-$HOME/.local/state}/korunix/locks"

  mkdir -p -- "$lock_dir"

  BOOTSTRAP_LOCK_FILE="$lock_dir/bootstrap.lock"

  exec {BOOTSTRAP_LOCK_FD}>"$BOOTSTRAP_LOCK_FILE"

  if ! "$flock_bin" \
      -n \
      "$BOOTSTRAP_LOCK_FD"
  then
    exec {BOOTSTRAP_LOCK_FD}>&-
    BOOTSTRAP_LOCK_FD=""

    error "Ya hay otra adopción inicial de Korunix en curso."
  fi
}

bootstrap_adopt_stage_json() {
  local plan="${1:-}"
  local jq_bin
  local python_bin
  local alejandra_bin
  local nix_bin
  local tar_bin
  local preflight
  local host_id
  local hardware_source
  local stage
  local plan_canonical
  local plan_sha256
  local drv_path
  local nixos_version
  local effective
  local expected_localization
  local effective_localization
  local expected_users
  local effective_users
  local expected_product
  local effective_product
  local shells_json
  local profile
  local account
  local observed_shell
  local effective_program
  local observed_program
  local files_json
  local target
  local sha
  local -a generated=()

  [[ -n "$plan" ]] \
    || error "Falta el plan que debe materializarse en staging."

  jq_bin="$(command -v jq 2>/dev/null || true)"
  python_bin="$(command -v python3 2>/dev/null || true)"
  alejandra_bin="$(command -v alejandra 2>/dev/null || true)"
  nix_bin="$(command -v nix 2>/dev/null || true)"
  tar_bin="$(command -v tar 2>/dev/null || true)"

  [[ -n "$jq_bin" ]] \
    || error "jq no está disponible."

  [[ -n "$python_bin" ]] \
    || error "python3 no está disponible."

  [[ -n "$alejandra_bin" ]] \
    || error "Alejandra no está disponible."

  [[ -n "$nix_bin" ]] \
    || error "Nix no está disponible."

  [[ -n "$tar_bin" ]] \
    || error "tar no está disponible."

  preflight="$(
    bootstrap_adopt_preflight_json \
      "$plan"
  )"

  host_id="$(
    "$jq_bin" -r \
      '.hostId' \
      <<<"$preflight"
  )"

  hardware_source="$(
    "$jq_bin" -r \
      '.source.hardware' \
      <<<"$plan"
  )"

  plan_canonical="$(
    "$jq_bin" -cS . \
      <<<"$plan"
  )"

  plan_sha256="$(
    printf '%s' \
      "$plan_canonical" |
    sha256sum |
    cut -d' ' -f1
  )"

  stage="$(
    mktemp -d \
      "${TMPDIR:-/tmp}/korunix-bootstrap-stage.XXXXXX"
  )"

  if ! (
    "$tar_bin" \
      -C "$ROOT" \
      --exclude='./.git' \
      --exclude='./result' \
      --exclude='./.direnv' \
      -cf - \
      . |
    "$tar_bin" \
      -C "$stage" \
      -xf -
  )
  then
    rm -rf -- "$stage"
    error "No pude crear la copia de staging."
  fi

  mkdir -p \
    "$stage/hosts" \
    "$stage/equipos" \
    "$stage/personas"

  printf '%s\n' \
    "$plan" \
    >"$stage/.korunix-bootstrap-plan.json"

  if ! "$python_bin" \
      - \
      "$stage" \
      "$hardware_source" <<'PY_STAGE'
from __future__ import annotations

import json
from pathlib import Path
import re
import sys
from typing import Any


root = Path(sys.argv[1])
hardware_source = Path(sys.argv[2])

plan = json.loads(
    (root / ".korunix-bootstrap-plan.json").read_text(
        encoding="utf-8"
    )
)


def nix_string(value: str) -> str:
    return json.dumps(
        value,
        ensure_ascii=False,
    )


def nix_value(value: Any, indent: int = 0) -> str:
    prefix = " " * indent

    if value is None:
        return "null"

    if value is True:
        return "true"

    if value is False:
        return "false"

    if isinstance(value, int):
        return str(value)

    if isinstance(value, float):
        return repr(value)

    if isinstance(value, str):
        return nix_string(value)

    if isinstance(value, list):
        if not value:
            return "[]"

        body = "\n".join(
            f"{' ' * (indent + 2)}"
            f"{nix_value(item, indent + 2)}"
            for item in value
        )

        return (
            "[\n"
            + body
            + f"\n{prefix}]"
        )

    if isinstance(value, dict):
        if not value:
            return "{}"

        lines = []

        for key, item in value.items():
            lines.append(
                f"{' ' * (indent + 2)}"
                f"{nix_string(str(key))} = "
                f"{nix_value(item, indent + 2)};"
            )

        return (
            "{\n"
            + "\n".join(lines)
            + f"\n{prefix}}}"
        )

    raise TypeError(
        "Tipo no representable en Nix: "
        f"{type(value).__name__}"
    )


host = plan["host"]
hardware = plan["hardware"]
localization_plan = plan["localization"]
profiles = plan["userAdoption"]["profiles"]

host_id = host["id"]

if not re.fullmatch(
    r"[a-z0-9][a-z0-9-]*",
    host_id,
):
    raise SystemExit(
        f"ERROR: hostId no válido: {host_id!r}"
    )

if localization_plan["needsReview"]:
    raise SystemExit(
        "ERROR: la localización necesita revisión."
    )

if localization_plan["formats"] is None:
    raise SystemExit(
        "ERROR: los formatos instalados no caben "
        "en el modelo actual."
    )

if localization_plan["keyboard"] is None:
    raise SystemExit(
        "ERROR: la instalación no contiene XKB adoptable."
    )

if (
    localization_plan["keyboard"]["console"]
    != localization_plan["consoleKeymap"]
):
    raise SystemExit(
        "ERROR: consoleKeymap no coincide "
        "con keyboard.console."
    )

if not profiles:
    raise SystemExit(
        "ERROR: no existen personas que materializar."
    )

if not any(
    profile["local"]["administrator"]
    for profile in profiles
):
    raise SystemExit(
        "ERROR: el sistema quedaría sin administrador."
    )


for profile in profiles:
    profile_id = profile["id"]
    target = profile["target"]
    portable = profile["portable"]

    if not re.fullmatch(
        r"[a-z_][a-z0-9_-]*",
        profile_id,
    ):
        raise SystemExit(
            f"ERROR: id de persona no válido: {profile_id!r}"
        )

    expected_path = f"personas/{profile_id}.nix"

    if target["profilePath"] != expected_path:
        raise SystemExit(
            "ERROR: destino portable inesperado: "
            f"{target['profilePath']!r}"
        )

    if target["profileExists"]:
        raise SystemExit(
            f"ERROR: {expected_path} ya existía según el plan."
        )

    if target["overwriteAllowed"]:
        raise SystemExit(
            f"ERROR: el plan permitiría sobrescribir {expected_path}."
        )

    profile_path = root / expected_path

    if profile_path.exists() or profile_path.is_symlink():
        raise SystemExit(
            f"ERROR: {expected_path} ya existe en staging."
        )

    portable_data = {
        "accountName": portable["accountName"],
        "fullName": portable["fullName"],
        "inputMethods": portable["inputMethods"],
        "capabilities": portable["capabilities"],
    }

    profile_path.write_text(
        "# Identidad portable adoptada desde una cuenta UNIX existente.\n"
        "# Korunix no inventó idioma, avatar, capacidades ni métodos de entrada.\n"
        + nix_value(portable_data)
        + "\n",
        encoding="utf-8",
    )


user_settings: dict[str, Any] = {}

for profile in profiles:
    profile_id = profile["id"]
    portable = profile["portable"]
    local = profile["local"]

    settings: dict[str, Any] = {
        "homeDirectory": local["homeDirectory"],
        "administrator": bool(
            local["administrator"]
        ),
        "deferredCapabilities": local[
            "deferredCapabilities"
        ],
        "deferredInputMethods": local[
            "deferredInputMethods"
        ],
        "preservedGroups": local[
            "preservedGroups"
        ],
        "githubSshIdentityFile": local[
            "githubSshIdentityFile"
        ],
    }

    if portable["accountName"] != profile_id:
        settings["accountName"] = portable[
            "accountName"
        ]

    user_settings[profile_id] = settings


localization = {
    "systemLanguage": localization_plan[
        "systemLanguage"
    ],
    "region": localization_plan[
        "region"
    ],
    "formats": localization_plan[
        "formats"
    ],
    "timeZone": localization_plan[
        "timeZone"
    ],
    "keyboard": localization_plan[
        "keyboard"
    ],
}


host_data = {
    "system": host["system"],
    "users": user_settings,
    "korunix": {
        "enable": True,
        "hostName": host["name"],
        "stateVersion": host["stateVersion"],
        "channel": host["channel"],
        "localization": localization,
    },
}

host_path = root / "equipos" / f"{host_id}.nix"

if host_path.exists() or host_path.is_symlink():
    raise SystemExit(
        f"ERROR: equipos/{host_id}.nix ya existe en staging."
    )

host_path.write_text(
    "# Host adoptado desde una instalación existente de NixOS.\n"
    "# Solo contiene estado particular de este equipo.\n"
    + nix_value(host_data)
    + "\n",
    encoding="utf-8",
)


hardware_text = hardware_source.read_text(
    encoding="utf-8"
)

marker = "\n{\n"

if hardware_text.count(marker) != 1:
    raise SystemExit(
        "ERROR: forma inesperada de hardware-configuration.nix."
    )

allowed_graphics_fields = (
    "pciAddress",
    "name",
    "vendor",
    "vendorId",
    "deviceId",
    "subsystemVendorId",
    "subsystemDeviceId",
    "driver",
    "primary",
    "kind",
    "nvidiaOpen",
)

graphics = [
    {
        key: device[key]
        for key in allowed_graphics_fields
        if key in device
    }
    for device in hardware["graphicsDevices"]
]

hardware_addition = (
    "  # Hechos físicos añadidos por Korunix durante la adopción.\n"
    "  korunix.hardware.firmware = "
    + nix_string(
        hardware["firmware"]["detected"]
    )
    + ";\n\n"
    "  korunix.hardware.graphics = "
    + nix_value(
        graphics,
        2,
    )
    + ";\n\n"
)

hardware_text = hardware_text.replace(
    marker,
    marker + hardware_addition,
    1,
)

hardware_path = root / "equipos" / f"{host_id}-detectado.nix"

if hardware_path.exists() or hardware_path.is_symlink():
    raise SystemExit(
        f"ERROR: equipos/{host_id}-detectado.nix ya existe en staging."
    )

hardware_path.write_text(
    hardware_text,
    encoding="utf-8",
)
PY_STAGE
  then
    rm -rf -- "$stage"
    error "No pude materializar la adopción dentro del staging."
  fi

  generated+=(
    "equipos/${host_id}.nix"
    "equipos/${host_id}-detectado.nix"
  )

  while IFS= read -r target; do
    [[ -n "$target" ]] \
      || continue

    generated+=("$target")
  done < <(
    "$jq_bin" -r \
      '.userAdoption.profiles[].target.profilePath' \
      <<<"$plan"
  )

  for target in "${generated[@]}"; do
    [[ -f "$stage/$target" && ! -L "$stage/$target" ]] || {
      rm -rf -- "$stage"
      error "El staging no produjo el archivo esperado: $target"
    }
  done

  if ! "$alejandra_bin" \
      "${generated[@]/#/$stage/}" \
      >/dev/null
  then
    rm -rf -- "$stage"
    error "Alejandra rechazó los archivos materializados."
  fi

  if grep -ERq \
      '^[[:space:]]*"?(password|hashedPassword|hashedPasswordFile|initialPassword)"?[[:space:]]*=' \
      "$stage/equipos/${host_id}.nix" \
      "$stage/personas"
  then
    rm -rf -- "$stage"
    error "El staging contiene una credencial declarativa."
  fi

  if ! drv_path="$(
    "$nix_bin" \
      --extra-experimental-features 'nix-command flakes' \
      eval \
      --no-write-lock-file \
      --raw \
      "path:${stage}#nixosConfigurations.${host_id}.config.system.build.toplevel.drvPath"
  )"
  then
    rm -rf -- "$stage"
    error "La configuración materializada no produce una derivación válida."
  fi

  if ! nixos_version="$(
    "$nix_bin" \
      --extra-experimental-features 'nix-command flakes' \
      eval \
      --no-write-lock-file \
      --raw \
      "path:${stage}#nixosConfigurations.${host_id}.config.system.nixos.version"
  )"
  then
    rm -rf -- "$stage"
    error "No pude comprobar la versión NixOS del staging."
  fi

  if ! effective="$(
    "$nix_bin" \
      --extra-experimental-features 'nix-command flakes' \
      eval \
      --no-write-lock-file \
      --json \
      "path:${stage}#nixosConfigurations.${host_id}.config.korunix"
  )"
  then
    rm -rf -- "$stage"
    error "No pude evaluar el modelo Korunix del staging."
  fi

  [[ "$(
    "$jq_bin" -r \
      '.channel' \
      <<<"$effective"
  )" == "$(
    "$jq_bin" -r \
      '.host.channel' \
      <<<"$plan"
  )" ]] || {
    rm -rf -- "$stage"
    error "El staging cambió el canal planificado."
  }

  [[ "$(
    "$jq_bin" -r \
      '.stateVersion' \
      <<<"$effective"
  )" == "$(
    "$jq_bin" -r \
      '.host.stateVersion' \
      <<<"$plan"
  )" ]] || {
    rm -rf -- "$stage"
    error "El staging cambió stateVersion."
  }

  expected_localization="$(
    "$jq_bin" -cS '
      .localization
      | {
          systemLanguage,
          region,
          formats,
          timeZone,
          keyboard
        }
    ' <<<"$plan"
  )"

  effective_localization="$(
    "$jq_bin" -cS \
      '.localization' \
      <<<"$effective"
  )"

  [[ "$expected_localization" == "$effective_localization" ]] || {
    rm -rf -- "$stage"
    error "La localización efectiva no coincide con el plan."
  }

  expected_users="$(
    "$jq_bin" -cS '
      [
        .userAdoption.profiles[].id
      ]
      | sort
    ' <<<"$plan"
  )"

  effective_users="$(
    "$jq_bin" -cS \
      '.users | sort' \
      <<<"$effective"
  )"

  [[ "$expected_users" == "$effective_users" ]] || {
    rm -rf -- "$stage"
    error "Las personas efectivas no coinciden con el plan."
  }

  expected_product="$(
    "$jq_bin" -cS '{
      desktop: .productDefaults.desktop,
      applications: .productDefaults.applications,
      services: .productDefaults.services
    }' <<<"$plan"
  )"

  effective_product="$(
    "$jq_bin" -cS '{
      desktop: {
        primary: .desktop.primary,
        additional: .desktop.additional
      },
      applications,
      services
    }' <<<"$effective"
  )"

  [[ "$expected_product" == "$effective_product" ]] || {
    rm -rf -- "$stage"
    error "El staging duplicó o alteró los defaults de producto."
  }

  # Comparamos el programa de shell, no la ruta del paquete Nix.
  if ! shells_json="$(
    "$nix_bin" \
      --extra-experimental-features 'nix-command flakes' \
      eval \
      --no-write-lock-file \
      --json \
      --apply '
        users:
          let
            shellProgram = shell:
              if shell == null
              then ""
              else if builtins.isAttrs shell
              then
                if shell ? meta && shell.meta ? mainProgram
                then shell.meta.mainProgram
                else if shell ? pname
                then shell.pname
                else if shell ? name
                then shell.name
                else builtins.baseNameOf (toString shell)
              else
                builtins.baseNameOf (toString shell);
          in
            builtins.mapAttrs (
              _: user:
                shellProgram (user.shell or null)
            ) users
      ' \
      "path:${stage}#nixosConfigurations.${host_id}.config.users.users"
  )"
  then
    rm -rf -- "$stage"
    error "No pude comprobar los shells de las cuentas adoptadas."
  fi

  while IFS= read -r profile; do
    account="$(
      "$jq_bin" -r \
        '.portable.accountName' \
        <<<"$profile"
    )"

    observed_shell="$(
      "$jq_bin" -r \
        '.observed.shell' \
        <<<"$profile"
    )"

    effective_program="$(
      "$jq_bin" -r \
        --arg account "$account" \
        ".[\$account] // empty" \
        <<<"$shells_json"
    )"

    [[ -n "$effective_program" ]] || {
      rm -rf -- "$stage"
      error "El staging no contiene la cuenta UNIX ${account}."
    }

    observed_program="${observed_shell##*/}"

    [[ -n "$observed_program" ]] || {
      rm -rf -- "$stage"
      error "No pude interpretar el shell instalado de ${account}."
    }

    [[ "$observed_program" == "$effective_program" ]] || {
      rm -rf -- "$stage"

      error \
        "Bootstrap cambiaría silenciosamente el shell de ${account}: ${observed_program} → ${effective_program}."
    }
  done < <(
    "$jq_bin" -c \
      '.userAdoption.profiles[]' \
      <<<"$plan"
  )

  files_json='[]'

  for target in "${generated[@]}"; do
    sha="$(
      sha256sum "$stage/$target" |
        cut -d' ' -f1
    )"

    # shellcheck disable=SC2016
    files_json="$(
      "$jq_bin" -c \
        --arg path "$target" \
        --arg sha256 "$sha" \
        '. + [{
          path: $path,
          sha256: $sha256
        }]' \
        <<<"$files_json"
    )"
  done

  # shellcheck disable=SC2016
  "$jq_bin" -cn \
    --arg stagePath "$stage" \
    --arg planSha256 "$plan_sha256" \
    --arg hostId "$host_id" \
    --arg nixosVersion "$nixos_version" \
    --arg drvPath "$drv_path" \
    --argjson files "$files_json" \
    '{
      schemaVersion: 1,
      kind: "korunix-bootstrap-adopt-stage",
      stagePath: $stagePath,
      planSha256: $planSha256,
      hostId: $hostId,
      files: $files,
      evaluation: {
        nixosVersion: $nixosVersion,
        drvPath: $drvPath,
        builtGeneration: false,
        appliedGeneration: false
      }
    }'
}

bootstrap_adopt_finalize_json() (
  local plan="${1:-}"
  local stage_result="${2:-}"
  local fail_at="${3:-}"
  local jq_bin
  local nix_bin
  local preflight
  local fresh_plan
  local plan_canonical
  local fresh_canonical
  local plan_sha256
  local stage_plan_sha256
  local host_id
  local stage_host_id
  local stage
  local stage_drv
  local stage_version
  local stage_effective
  local final_drv
  local final_version
  local final_effective
  local expected_targets
  local stage_targets
  local state_root
  local tx_parent
  local tx_dir=""
  local tx_mark
  local checkpoint="inicio"
  local completed=false
  local bootstrap_exit_status=0
  local target
  local expected_sha
  local actual_sha
  local directory
  local basename
  local temporary
  local index
  local result_json
  local -a targets=()
  local -a temporaries=()
  local -a created=()

  [[ -n "$plan" ]] \
    || error "Falta el plan de adopción."

  [[ -n "$stage_result" ]] \
    || error "Falta el resultado del staging."

  case "$fail_at" in
    ""|before-first-mv|after-first-mv|after-all-mv|after-git-add|after-final-eval)
      ;;
    *)
      error "Punto de fallo interno desconocido: $fail_at"
      ;;
  esac

  jq_bin="$(command -v jq 2>/dev/null || true)"
  nix_bin="$(command -v nix 2>/dev/null || true)"

  [[ -n "$jq_bin" ]] \
    || error "jq no está disponible."

  [[ -n "$nix_bin" ]] \
    || error "Nix no está disponible."

  [[ -n "${BOOTSTRAP_LOCK_FD:-}" ]] \
    || error "La finalización necesita mantener el bloqueo exclusivo de bootstrap."

  bootstrap_finalize_expected_sha() {
    local expected_target="$1"

    "$jq_bin" -r \
      --arg target "$expected_target" \
      ".files[] | select(.path == \$target) | .sha256" \
      <<<"$stage_result"
  }

  bootstrap_finalize_write_status() {
    local tx_status="$1"
    local tx_checkpoint="$2"
    local tmp_status

    [[ -n "$tx_dir" && -d "$tx_dir" ]] \
      || return 0

    tmp_status="$tx_dir/.status.json.tmp"

    # shellcheck disable=SC2016
    "$jq_bin" -cn \
      --arg status "$tx_status" \
      --arg checkpoint "$tx_checkpoint" \
      '{
        schemaVersion: 1,
        status: $status,
        checkpoint: $checkpoint
      }' \
      >"$tmp_status"

    mv -f -- \
      "$tmp_status" \
      "$tx_dir/status.json"
  }

  # Esta función es llamada indirectamente por el trap EXIT.
  # shellcheck disable=SC2329
  bootstrap_finalize_rollback() {
    local rollback_status="$1"
    local rollback_target
    local rollback_tmp
    local rollback_expected
    local rollback_actual

    set +e

    # Los destinos eran inexistentes al iniciar la transacción.
    # git reset solo retira las entradas intent-to-add de esta operación.
    if [[ "${#targets[@]}" -gt 0 ]]; then
      git -C "$ROOT" \
        reset \
        -q \
        -- \
        "${targets[@]}" \
        >/dev/null 2>&1 \
        || true
    fi

    # Nunca borrar algo que haya dejado de ser exactamente nuestro candidato.
    for rollback_target in "${created[@]}"; do
      if [[ ! -e "$ROOT/$rollback_target" \
        && ! -L "$ROOT/$rollback_target" ]]
      then
        continue
      fi

      if [[ ! -f "$ROOT/$rollback_target" \
        || -L "$ROOT/$rollback_target" ]]
      then
        if [[ -n "$tx_dir" && -d "$tx_dir" ]]; then
          printf '%s\n' \
            "No se retiró $rollback_target: cambió de tipo durante el rollback." \
            >>"$tx_dir/rollback-warnings.txt" \
            2>/dev/null \
            || true
        fi

        continue
      fi

      rollback_expected="$(
        bootstrap_finalize_expected_sha \
          "$rollback_target" \
          2>/dev/null \
          || true
      )"

      rollback_actual="$(
        sha256sum "$ROOT/$rollback_target" \
          2>/dev/null |
        cut -d' ' -f1
      )"

      if [[ -n "$rollback_expected" \
        && "$rollback_actual" == "$rollback_expected" ]]
      then
        rm -f -- \
          "$ROOT/$rollback_target"
      else
        if [[ -n "$tx_dir" && -d "$tx_dir" ]]; then
          printf '%s\n' \
            "No se retiró $rollback_target: ya no coincide con el candidato de bootstrap." \
            >>"$tx_dir/rollback-warnings.txt" \
            2>/dev/null \
            || true
        fi
      fi
    done

    for rollback_tmp in "${temporaries[@]}"; do
      rm -f -- \
        "$rollback_tmp" \
        || true
    done

    if [[ -n "$stage" && -d "$stage" ]]; then
      rm -rf -- \
        "$stage" \
        || true
    fi

    bootstrap_finalize_write_status \
      "rolled-back" \
      "$checkpoint" \
      >/dev/null 2>&1 \
      || true

    if [[ -n "$tx_dir" && -d "$tx_dir" ]]; then
      printf '%s\n' \
        "$rollback_status" \
        >"$tx_dir/exit-status.txt" \
        2>/dev/null \
        || true
    fi

    set -e
  }

  bootstrap_finalize_failpoint() {
    local point="$1"

    checkpoint="$point"

    if [[ "$fail_at" == "$point" ]]; then
      error "Fallo inyectado de bootstrap en: $point"
    fi
  }

  trap '
    bootstrap_exit_status=$?

    if [[ "$completed" != true ]]; then
      bootstrap_finalize_rollback "$bootstrap_exit_status"
    fi

    exit "$bootstrap_exit_status"
  ' EXIT

  # -----------------------------------------------------------------------
  # Validar plan y staging antes de tocar el checkout.
  # -----------------------------------------------------------------------

  preflight="$(
    bootstrap_adopt_preflight_json \
      "$plan"
  )"

  host_id="$(
    "$jq_bin" -r \
      '.hostId' \
      <<<"$preflight"
  )"

  plan_canonical="$(
    "$jq_bin" -cS . \
      <<<"$plan"
  )"

  plan_sha256="$(
    printf '%s' \
      "$plan_canonical" |
    sha256sum |
    cut -d' ' -f1
  )"

  "$jq_bin" -e '
    .schemaVersion == 1
    and .kind == "korunix-bootstrap-adopt-stage"
    and (.stagePath | type) == "string"
    and (.planSha256 | type) == "string"
    and (.hostId | type) == "string"
    and (.files | type) == "array"
    and (.files | length) >= 3
    and (.evaluation.drvPath | type) == "string"
    and (.evaluation.nixosVersion | type) == "string"
    and .evaluation.builtGeneration == false
    and .evaluation.appliedGeneration == false
  ' <<<"$stage_result" \
    >/dev/null \
    || error "El resultado del staging no cumple su contrato."

  stage="$(
    "$jq_bin" -r \
      '.stagePath' \
      <<<"$stage_result"
  )"

  stage_plan_sha256="$(
    "$jq_bin" -r \
      '.planSha256' \
      <<<"$stage_result"
  )"

  stage_host_id="$(
    "$jq_bin" -r \
      '.hostId' \
      <<<"$stage_result"
  )"

  stage_drv="$(
    "$jq_bin" -r \
      '.evaluation.drvPath' \
      <<<"$stage_result"
  )"

  stage_version="$(
    "$jq_bin" -r \
      '.evaluation.nixosVersion' \
      <<<"$stage_result"
  )"

  [[ -d "$stage" ]] \
    || error "El staging ya no existe."

  [[ -r "$stage/.korunix-bootstrap-plan.json" ]] \
    || error "El staging perdió su plan interno."

  [[ "$stage_plan_sha256" == "$plan_sha256" ]] \
    || error "El staging no corresponde al plan actual."

  [[ "$stage_host_id" == "$host_id" ]] \
    || error "El staging pertenece a otro host."

  [[ "$(
    "$jq_bin" -cS . \
      "$stage/.korunix-bootstrap-plan.json"
  )" == "$plan_canonical" ]] \
    || error "El plan interno del staging cambió."

  # Los destinos se derivan del mismo plan ya validado; no dependemos de que
  # el preflight duplique esa lista en su JSON.
  expected_targets="$(
    {
      printf 'equipos/%s.nix\n' \
        "$host_id"

      printf 'equipos/%s.nix\n' \
        "$host_id"

      "$jq_bin" -r \
        '.userAdoption.profiles[].target.profilePath' \
        <<<"$plan"
    } |
    sort
  )"

  stage_targets="$(
    "$jq_bin" -r \
      '.files[].path' \
      <<<"$stage_result" |
    sort
  )"

  [[ "$expected_targets" == "$stage_targets" ]] \
    || error "Los candidatos del staging no coinciden con el plan."

  mapfile -t targets \
    <<<"$expected_targets"

  for target in "${targets[@]}"; do
    expected_sha="$(
      bootstrap_finalize_expected_sha \
        "$target"
    )"

    [[ -n "$expected_sha" ]] \
      || error "Falta el hash de staging para $target."

    [[ -f "$stage/$target" \
      && ! -L "$stage/$target" ]] \
      || error "Falta el candidato regular $target."

    actual_sha="$(
      sha256sum "$stage/$target" |
        cut -d' ' -f1
    )"

    [[ "$actual_sha" == "$expected_sha" ]] \
      || error "El candidato $target cambió después de evaluarse."
  done

  # -----------------------------------------------------------------------
  # Volver a detectar TODO justo antes de la primera escritura.
  # -----------------------------------------------------------------------

  checkpoint="revalidando-plan"

  fresh_plan="$(
    bootstrap_plan_json
  )"

  fresh_canonical="$(
    "$jq_bin" -cS . \
      <<<"$fresh_plan"
  )"

  [[ "$fresh_canonical" == "$plan_canonical" ]] \
    || error "La instalación cambió después de preparar el staging."

  bootstrap_adopt_preflight_json \
    "$fresh_plan" \
    >/dev/null

  # -----------------------------------------------------------------------
  # Registro persistente antes de tocar equipos/, equipos/ o personas/.
  # -----------------------------------------------------------------------

  checkpoint="creando-transaccion"

  state_root="${XDG_STATE_HOME:-$HOME/.local/state}"
  tx_parent="$state_root/korunix/backups"

  mkdir -p -- \
    "$tx_parent"

  tx_mark="$(date +%Y%m%d-%H%M%S)-$$"
  tx_dir="$tx_parent/bootstrap-adopt-${host_id}-${tx_mark}"

  mkdir -- \
    "$tx_dir"

  printf '%s\n' \
    "$plan" \
    >"$tx_dir/plan.json"

  printf '%s\n' \
    "$stage_result" \
    >"$tx_dir/stage.json"

  "$jq_bin" \
    '.files' \
    <<<"$stage_result" \
    >"$tx_dir/manifest.json"

  mkdir -p \
    "$tx_dir/candidates"

  for target in "${targets[@]}"; do
    directory="${target%/*}"

    mkdir -p -- \
      "$tx_dir/candidates/$directory"

    cp -p -- \
      "$stage/$target" \
      "$tx_dir/candidates/$target"
  done

  bootstrap_finalize_write_status \
    "prepared" \
    "$checkpoint"

  # -----------------------------------------------------------------------
  # Temporales en el mismo directorio de cada destino.
  # -----------------------------------------------------------------------

  checkpoint="preparando-temporales"

  for target in "${targets[@]}"; do
    directory="${target%/*}"
    basename="${target##*/}"

    temporary="$(
      mktemp \
        "$ROOT/$directory/.korunix-bootstrap-${basename}.XXXXXX"
    )"

    cp -p -- \
      "$stage/$target" \
      "$temporary"

    expected_sha="$(
      bootstrap_finalize_expected_sha \
        "$target"
    )"

    actual_sha="$(
      sha256sum "$temporary" |
        cut -d' ' -f1
    )"

    [[ "$actual_sha" == "$expected_sha" ]] || {
      rm -f -- "$temporary"
      error "El temporal de $target no coincide con el staging."
    }

    temporaries+=("$temporary")
  done

  bootstrap_finalize_failpoint \
    "before-first-mv"

  # -----------------------------------------------------------------------
  # Rename individual atómico.
  #
  # -T fuerza un destino exacto.
  # -n impide sobrescribir algo aparecido después del preflight.
  # -----------------------------------------------------------------------

  checkpoint="moviendo-candidatos"

  for index in "${!targets[@]}"; do
    target="${targets[$index]}"
    temporary="${temporaries[$index]}"

    mv \
      -T \
      -n \
      -- \
      "$temporary" \
      "$ROOT/$target"

    # GNU mv -n puede devolver éxito aunque decida no mover.
    # La existencia del temporal permite detectar ese caso inequívocamente.
    if [[ -e "$temporary" || -L "$temporary" ]]; then
      error "El destino apareció durante la transacción y no será sobrescrito: $target"
    fi

    [[ -f "$ROOT/$target" \
      && ! -L "$ROOT/$target" ]] \
      || error "No se materializó correctamente $target."

    created+=("$target")

    expected_sha="$(
      bootstrap_finalize_expected_sha \
        "$target"
    )"

    actual_sha="$(
      sha256sum "$ROOT/$target" |
        cut -d' ' -f1
    )"

    [[ "$actual_sha" == "$expected_sha" ]] \
      || error "El archivo final $target no coincide con el candidato."

    if [[ "$index" -eq 0 ]]; then
      bootstrap_finalize_failpoint \
        "after-first-mv"
    fi
  done

  bootstrap_finalize_failpoint \
    "after-all-mv"

  # -----------------------------------------------------------------------
  # Hacer visibles las rutas al flake Git sin stagear su contenido.
  # -----------------------------------------------------------------------

  checkpoint="intent-to-add"

  git -C "$ROOT" \
    add \
    -N \
    -- \
    "${targets[@]}"

  git -C "$ROOT" \
    diff \
    --cached \
    --quiet \
    -- \
    "${targets[@]}" \
    || error "Bootstrap stageó contenido; solo se permite intent-to-add."

  for target in "${targets[@]}"; do
    git -C "$ROOT" \
      ls-files \
      --error-unmatch \
      "$target" \
      >/dev/null \
      || error "Git no puede ver $target mediante intent-to-add."
  done

  bootstrap_finalize_failpoint \
    "after-git-add"

  # -----------------------------------------------------------------------
  # Reevaluar el checkout Git final.
  #
  # No se exige que path:<staging> y la fuente Git produzcan el mismo drvPath:
  # sus identidades de fuente pueden ser distintas. Se compara la configuración
  # efectiva de Korunix y la versión NixOS.
  # -----------------------------------------------------------------------

  checkpoint="evaluacion-final"

  if ! stage_effective="$(
    "$nix_bin" \
      --extra-experimental-features 'nix-command flakes' \
      eval \
      --no-write-lock-file \
      --json \
      "path:${stage}#nixosConfigurations.${host_id}.config.korunix"
  )"
  then
    error "No pude reevaluar el contrato Korunix del staging."
  fi

  if ! final_drv="$(
    "$nix_bin" \
      --extra-experimental-features 'nix-command flakes' \
      eval \
      --no-write-lock-file \
      --raw \
      "$ROOT#nixosConfigurations.${host_id}.config.system.build.toplevel.drvPath"
  )"
  then
    error "El checkout final no evalúa como flake Git."
  fi

  if ! final_version="$(
    "$nix_bin" \
      --extra-experimental-features 'nix-command flakes' \
      eval \
      --no-write-lock-file \
      --raw \
      "$ROOT#nixosConfigurations.${host_id}.config.system.nixos.version"
  )"
  then
    error "No pude comprobar la versión NixOS final."
  fi

  if ! final_effective="$(
    "$nix_bin" \
      --extra-experimental-features 'nix-command flakes' \
      eval \
      --no-write-lock-file \
      --json \
      "$ROOT#nixosConfigurations.${host_id}.config.korunix"
  )"
  then
    error "No pude evaluar el contrato Korunix final."
  fi

  [[ "$final_version" == "$stage_version" ]] \
    || error "La versión NixOS final difiere del staging."

  [[ "$(
    "$jq_bin" -cS . \
      <<<"$stage_effective"
  )" == "$(
    "$jq_bin" -cS . \
      <<<"$final_effective"
  )" ]] \
    || error "El contrato Korunix final difiere del staging."

  for target in "${targets[@]}"; do
    expected_sha="$(
      bootstrap_finalize_expected_sha \
        "$target"
    )"

    actual_sha="$(
      sha256sum "$ROOT/$target" |
        cut -d' ' -f1
    )"

    [[ "$actual_sha" == "$expected_sha" ]] \
      || error "El archivo $target cambió durante la evaluación final."
  done

  git -C "$ROOT" \
    diff \
    --cached \
    --quiet \
    -- \
    "${targets[@]}" \
    || error "La evaluación final dejó contenido staged."

  bootstrap_finalize_failpoint \
    "after-final-eval"

  # -----------------------------------------------------------------------
  # Éxito.
  # -----------------------------------------------------------------------

  checkpoint="completada"

  bootstrap_finalize_write_status \
    "completed" \
    "$checkpoint"

  rm -rf -- \
    "$stage"

  # shellcheck disable=SC2016
  result_json="$(
    "$jq_bin" -cn \
      --arg transactionPath "$tx_dir" \
      --arg hostId "$host_id" \
      --arg planSha256 "$plan_sha256" \
      --arg stagingDrvPath "$stage_drv" \
      --arg finalDrvPath "$final_drv" \
      --arg nixosVersion "$final_version" \
      --argjson files "$(
        "$jq_bin" -c \
          '.files' \
          <<<"$stage_result"
      )" \
      '{
        schemaVersion: 1,
        kind: "korunix-bootstrap-adopt-finalize",
        status: "completed",
        transactionPath: $transactionPath,
        hostId: $hostId,
        planSha256: $planSha256,
        files: $files,
        evaluation: {
          nixosVersion: $nixosVersion,
          stagingDrvPath: $stagingDrvPath,
          finalDrvPath: $finalDrvPath,
          builtGeneration: false,
          appliedGeneration: false
        },
        git: {
          intentToAdd: true,
          stagedContent: false
        }
      }'
  )"

  completed=true
  trap - EXIT

  printf '%s\n' \
    "$result_json"
)

mostrar_bootstrap_plan() {
  local modo="${1:-}"
  local jq_bin
  local plan

  case "$modo" in
    ""|--json)
      ;;
    *)
      error "Uso: scripts/korunix bootstrap --plan [--json]."
      ;;
  esac

  jq_bin="$(command -v jq 2>/dev/null || true)"
  [[ -n "$jq_bin" ]] || error "jq no está disponible."

  plan="$(bootstrap_plan_json)"

  if [[ "$modo" == "--json" ]]; then
    printf '%s\n' "$plan"
    return
  fi

  echo "=== Plan de adopción inicial ==="
  echo "Equipo: $("$jq_bin" -r '.host.name' <<<"$plan")"
  echo "Identificador Korunix: $("$jq_bin" -r '.host.id' <<<"$plan")"
  echo "Arquitectura: $("$jq_bin" -r '.host.system' <<<"$plan")"
  echo "Firmware: $("$jq_bin" -r '.hardware.firmware.detected' <<<"$plan")"
  echo "Canal inicial: $("$jq_bin" -r '.host.channel' <<<"$plan")"
  echo "stateVersion: $("$jq_bin" -r '.host.stateVersion' <<<"$plan")"
  echo "Zona horaria: $("$jq_bin" -r '.localization.timeZone' <<<"$plan")"
  echo "Locale: $("$jq_bin" -r '.localization.locale' <<<"$plan")"
  echo "Región: $("$jq_bin" -r '.localization.region' <<<"$plan")"
  echo "Teclado de consola: $("$jq_bin" -r '.localization.consoleKeymap // "pendiente"' <<<"$plan")"
  echo "Teclado XKB: $("$jq_bin" -r 'if .localization.keyboard == null then "pendiente" elif .localization.keyboard.variant == "" then .localization.keyboard.layout else .localization.keyboard.layout + " (" + .localization.keyboard.variant + ")" end' <<<"$plan")"
  echo "Revisión de localización: $("$jq_bin" -r 'if .localization.needsReview then "sí" else "no" end' <<<"$plan")"
  echo "Personas detectadas: $("$jq_bin" -r '.users | length' <<<"$plan")"
  echo "GPU detectadas: $("$jq_bin" -r '.hardware.graphicsDevices | length' <<<"$plan")"
  echo "Escritorio inicial: $("$jq_bin" -r '.productDefaults.desktop.primary' <<<"$plan")"
  echo "Aplicaciones iniciales: $("$jq_bin" -r '.productDefaults.applications | length' <<<"$plan")"
  echo "Avahi inicial: $("$jq_bin" -r '.productDefaults.services.avahi' <<<"$plan")"
  echo "SSH inicial: $("$jq_bin" -r '.productDefaults.services.ssh' <<<"$plan")"

  echo
  echo "Base de hardware:"
  echo "  /etc/nixos/hardware-configuration.nix"

  echo
  echo "✓ Se reutilizará el hardware de la instalación"
  echo "✓ No se modificará /etc/nixos"
  echo "✓ No se construirá ninguna generación"
  echo "✓ No se aplicará ninguna generación"
}

bootstrap_adopt_publico() {
  local modo="${1:-}"
  local jq_bin
  local plan
  local stage_result
  local final_result
  local host_id

  case "$modo" in
    ""|--yes)
      ;;
    *)
      error "Uso: scripts/korunix bootstrap --adopt [--yes]."
      ;;
  esac

  jq_bin="$(command -v jq 2>/dev/null || true)"

  [[ -n "$jq_bin" ]] \
    || error "jq no está disponible."

  # El lock cubre detección, confirmación, staging y finalización.
  bootstrap_adopt_lock_acquire

  plan="$(
    bootstrap_plan_json
  )"

  bootstrap_adopt_preflight_json \
    "$plan" \
    >/dev/null

  host_id="$(
    "$jq_bin" -r \
      '.host.id' \
      <<<"$plan"
  )"

  echo "=== Primera adopción de Korunix ==="
  echo "Equipo: $("$jq_bin" -r '.host.name' <<<"$plan")"
  echo "Identificador: $host_id"
  echo "Arquitectura: $("$jq_bin" -r '.host.system' <<<"$plan")"
  echo "Canal inicial: $("$jq_bin" -r '.host.channel' <<<"$plan")"
  echo "NixOS stateVersion: $("$jq_bin" -r '.host.stateVersion' <<<"$plan")"
  echo "Zona horaria: $("$jq_bin" -r '.localization.timeZone' <<<"$plan")"
  echo "Personas: $("$jq_bin" -r '.userAdoption.profiles | length' <<<"$plan")"
  echo "GPU detectadas: $("$jq_bin" -r '.hardware.graphicsDevices | length' <<<"$plan")"

  echo
  echo "Korunix preparará:"

  printf '  • equipos/%s.nix\n' \
    "$host_id"

  printf '  • equipos/%s.nix\n' \
    "$host_id"

  "$jq_bin" -r \
    '.userAdoption.profiles[].target.profilePath
     | "  • " + .' \
    <<<"$plan"

  echo
  echo "La operación:"
  echo "  • reutiliza /etc/nixos/hardware-configuration.nix"
  echo "  • conserva la contraseña actual fuera de Korunix"
  echo "  • no modifica /etc/nixos"
  echo "  • no construye una generación"
  echo "  • no aplica una generación"
  echo "  • no crea commits"
  echo "  • no hace push"

  if [[ "$modo" != "--yes" ]]; then
    echo

    confirmar \
      "¿Preparar Korunix con este plan?" \
      || return 0
  else
    echo
    echo "✓ Confirmación previa indicada mediante --yes"
  fi

  echo
  echo "Preparando candidatos y comprobando la configuración..."

  stage_result="$(
    bootstrap_adopt_stage_json \
      "$plan"
  )"

  final_result="$(
    bootstrap_adopt_finalize_json \
      "$plan" \
      "$stage_result"
  )"

  echo
  echo "=== Adopción declarativa preparada ==="

  "$jq_bin" -r \
    '.files[].path
     | "✓ " + .' \
    <<<"$final_result"

  echo
  echo "Transacción:"
  echo "  $("$jq_bin" -r '.transactionPath' <<<"$final_result")"

  echo
  echo "✓ El checkout final fue evaluado"
  echo "✓ Los archivos permanecen sin contenido staged"
  echo "✓ No se construyó ninguna generación"
  echo "✓ No se aplicó ninguna generación"
  echo
  echo "Korunix ya puede administrar declarativamente este equipo."
}

gestionar_bootstrap() {
  local accion="${1:-}"

  case "$accion" in
    --plan)
      case "$#" in
        1)
          mostrar_bootstrap_plan
          ;;
        2)
          [[ "${2:-}" == "--json" ]] \
            || error "Uso: scripts/korunix bootstrap --plan [--json]."

          mostrar_bootstrap_plan \
            --json
          ;;
        *)
          error "Uso: scripts/korunix bootstrap --plan [--json]."
          ;;
      esac
      ;;

    --adopt)
      case "$#" in
        1)
          bootstrap_adopt_publico
          ;;
        2)
          [[ "${2:-}" == "--yes" ]] \
            || error "Uso: scripts/korunix bootstrap --adopt [--yes]."

          bootstrap_adopt_publico \
            --yes
          ;;
        *)
          error "Uso: scripts/korunix bootstrap --adopt [--yes]."
          ;;
      esac
      ;;

    -h|--help)
      [[ "$#" -eq 1 ]] \
        || error "Uso: scripts/korunix bootstrap [--plan [--json] | --adopt [--yes]]."

      cat <<'BOOTSTRAP_USAGE'
Uso:
  scripts/korunix bootstrap --plan
      Inspeccionar una instalación existente de NixOS y mostrar cómo Korunix la
      adoptaría, sin escribir archivos ni construir el sistema.

  scripts/korunix bootstrap --plan --json
      Exponer el mismo plan como contrato estructurado.

  scripts/korunix bootstrap --adopt
      Preparar la primera configuración Korunix a partir del NixOS ya instalado.
      Muestra el plan y solicita confirmación antes de escribir en el repositorio.

  scripts/korunix bootstrap --adopt --yes
      Ejecutar la misma adopción sin pregunta interactiva. Conserva todas las
      validaciones, hashes, bloqueo exclusivo, staging y rollback.

Bootstrap reutiliza /etc/nixos/hardware-configuration.nix cuando existe.
No regenera hardware y no modifica /etc/nixos.

Adoptar solo prepara la configuración declarativa:
no ejecuta nix build, no ejecuta nixos-rebuild y no aplica una generación.
Tampoco crea commits ni hace push.
BOOTSTRAP_USAGE
      ;;

    *)
      error "Uso: scripts/korunix bootstrap [--plan [--json] | --adopt [--yes]]."
      ;;
  esac
}

mostrar_hardware() {
  local modo="${1:-}"
  local jq_bin
  local datos
  local tipo
  local tipo_humano
  local memoria

  case "$modo" in
    "")
      ;;
    --json)
      hardware_detectado_json
      return
      ;;
    *)
      error "Uso: scripts/korunix hardware [--json]."
      ;;
  esac

  jq_bin="$(command -v jq 2>/dev/null || true)"

  [[ -n "$jq_bin" ]] \
    || error "jq no está disponible. Aplica primero la generación que integra la capa de hardware."

  datos="$(hardware_detectado_json)"
  tipo="$("$jq_bin" -r '.machine.type' <<<"$datos")"

  case "$tipo" in
    desktop)
      tipo_humano="Sobremesa"
      ;;
    laptop)
      tipo_humano="Portátil"
      ;;
    all-in-one)
      tipo_humano="Todo en uno"
      ;;
    server)
      tipo_humano="Servidor"
      ;;
    *)
      tipo_humano="Tipo no determinado"
      ;;
  esac

  memoria="$(
    "$jq_bin" -r '.memory.bytes' <<<"$datos" \
      | awk '{ printf "%.1f GiB", $1 / 1073741824 }'
  )"

  echo "=== Hardware detectado ==="
  echo "Host Korunix: $HOST"
  echo "Tipo de equipo: $tipo_humano"
  echo "Fabricante: $("$jq_bin" -r '.machine.vendor' <<<"$datos")"
  echo "Modelo: $("$jq_bin" -r '.machine.model' <<<"$datos")"

  echo
  echo "=== Plataforma ==="
  echo "Arquitectura: $("$jq_bin" -r '.platform.detected' <<<"$datos")"

  case "$("$jq_bin" -r '.firmware.detected' <<<"$datos")" in
    uefi)
      echo "Firmware: UEFI"
      ;;
    bios)
      echo "Firmware: BIOS / Legacy"
      ;;
  esac

  if "$jq_bin" -e '.virtualization.virtualized' <<<"$datos" >/dev/null; then
    echo "Entorno: virtualizado ($("$jq_bin" -r '.virtualization.kind' <<<"$datos"))"
  else
    echo "Entorno: máquina física"
  fi

  echo
  echo "=== Procesador y memoria ==="
  echo "CPU: $("$jq_bin" -r '.cpu.model' <<<"$datos")"
  echo "Procesadores lógicos: $("$jq_bin" -r '.cpu.logicalProcessors' <<<"$datos")"
  echo "Microcódigo: $("$jq_bin" -r '.cpu.microcode' <<<"$datos")"
  echo "Memoria: $memoria"

  echo
  echo "=== Gráficos ==="

  if [[ "$("$jq_bin" -r '.graphics | length' <<<"$datos")" -eq 0 ]]; then
    echo "No se pudo identificar un adaptador gráfico."
  else
    "$jq_bin" -r '.graphics[] | "• " + .' <<<"$datos"
  fi

  if [[ "$("$jq_bin" -r '.graphicsDrivers | length' <<<"$datos")" -gt 0 ]]; then
    echo "Controladores cargados: $("$jq_bin" -r '.graphicsDrivers | join(", ")' <<<"$datos")"
  fi

  echo
  echo "=== Almacenamiento ==="

  "$jq_bin" -r '
    .storage.blockdevices[]?
    | select(.type == "disk")
    | (
        "• "
        + .name
        + ": "
        + (((.size / 1073741824 * 10 | round) / 10) | tostring)
        + " GiB · "
        + ((.model // "sin modelo") | gsub("\\s+$"; ""))
        + " · "
        + (.tran // "bus desconocido")
      )
  ' <<<"$datos"

  echo
  echo "=== Red ==="

  if [[ "$("$jq_bin" -r '.network | length' <<<"$datos")" -eq 0 ]]; then
    echo "No se identificaron adaptadores PCI de red."
  else
    "$jq_bin" -r '.network[] | "• " + .' <<<"$datos"
  fi

  echo
  echo "=== Coherencia con Korunix ==="

  if "$jq_bin" -e '.platform.matches' <<<"$datos" >/dev/null; then
    echo "✓ la arquitectura detectada coincide con la declarada"
  else
    echo "AVISO: la arquitectura detectada y la declarada no coinciden"
    echo "Detectada: $("$jq_bin" -r '.platform.detected' <<<"$datos")"
    echo "Declarada: $("$jq_bin" -r '.platform.declared' <<<"$datos")"
  fi

  if "$jq_bin" -e '.firmware.matches' <<<"$datos" >/dev/null; then
    echo "✓ el firmware detectado coincide con el adoptado"
  else
    echo "AVISO: el firmware detectado y el adoptado no coinciden"
    echo "Detectado: $("$jq_bin" -r '.firmware.detected' <<<"$datos")"
    echo "Adoptado: $("$jq_bin" -r '.firmware.declared' <<<"$datos")"
  fi

  echo
  echo "Detección local. No se consultó Internet ni se modificó el sistema."
}

mostrar_arranque() {
  local modo="BIOS / Legacy"
  local estado_boot=""
  local cargador=""
  local secure="desconocido"

  if [[ -d /sys/firmware/efi ]]; then
    modo="UEFI"
  fi

  if command -v bootctl >/dev/null 2>&1; then
    estado_boot="$(bootctl status --no-pager 2>/dev/null || true)"

    cargador="$(
      awk '
        /^[[:space:]]*Product:/ {
          sub(/^[[:space:]]*Product:[[:space:]]*/, "")
          print
          exit
        }
      ' <<<"$estado_boot"
    )"

    secure="$(
      awk '
        /^[[:space:]]*Secure Boot:/ {
          sub(/^[[:space:]]*Secure Boot:[[:space:]]*/, "")
          print
          exit
        }
      ' <<<"$estado_boot"
    )"
  fi

  echo
  echo "=== Arranque y firmware ==="
  echo "Firmware: $modo"
  echo "Cargador actual: ${cargador:-desconocido}"

  case "$secure" in
    enabled*)
      echo "Arranque seguro: activado"
      ;;
    disabled*)
      echo "Arranque seguro: desactivado"
      ;;
    *)
      echo "Arranque seguro: $secure"
      ;;
  esac

  if command -v fwupdmgr >/dev/null 2>&1; then
    echo "Actualizaciones de firmware: integradas"
  else
    echo "Actualizaciones de firmware: todavía no integradas en el sistema en uso"
  fi
}

estado() {
  local actual
  local predeterminada
  local generacion_actual
  local generacion_default

  actual="$(ruta_actual)"
  predeterminada="$(ruta_predeterminada)"
  generacion_actual="$(generacion_de_ruta "$actual")"
  generacion_default="$(generacion_predeterminada)"

  echo "=== Repositorio ==="
  git status --short --branch

  echo
  echo "=== Equipo ==="
  echo "Host Korunix: $HOST"

  mostrar_arranque

  echo
  echo "=== Sistema ==="
  echo "Punto actual (ID): ${generacion_actual:-desconocido}"
  echo "Punto predeterminado (ID): ${generacion_default:-desconocido}"
  echo "Sistema en uso: ${actual:-desconocido}"
  echo "Sistema predeterminado: ${predeterminada:-desconocido}"

  if [[ -n "$actual" && -n "$predeterminada" && "$actual" != "$predeterminada" ]]; then
    echo
    echo "AVISO: el sistema en uso y el preparado para el próximo arranque son distintos."
    echo "No se cambió la sesión actual."
  fi

  echo
  echo "=== Puntos de recuperación recientes ==="
  mostrar_generaciones 5

  echo
  echo "Estado consultado localmente. No se buscó nada en Internet."
}

construir_candidato() {
  local candidato

  echo "Construyendo la generación candidata de ${HOST}..." >&2

  candidato="$(
    nix build \
      ".#nixosConfigurations.${HOST}.config.system.build.toplevel" \
      --no-link \
      --print-out-paths \
      --show-trace \
      | tail -n 1
  )"

  [[ -n "$candidato" ]] \
    || error "Nix no devolvió la ruta de la generación candidata."

  printf "%s\n" "$candidato"
}

mostrar_diferencias() {
  local anterior="$1"
  local candidato="$2"

  echo
  echo "=== Diferencias de paquetes y cierres ==="

  if [[ -z "$anterior" || ! -e "$anterior" ]]; then
    aviso "No pude encontrar el sistema actualmente en uso para compararlo."
    return
  fi

  if ! nix store diff-closures "$anterior" "$candidato"; then
    aviso "Nix no pudo producir el resumen de diferencias de closures."
  fi
}


mostrar_activacion_seca() {
  local candidato="$1"

  echo
  echo "=== Cambios de servicios y activación ==="

  if [[ ! -x "$candidato/bin/switch-to-configuration" ]]; then
    error "La generación candidata no contiene switch-to-configuration."
  fi

  echo "NixOS necesita permiso administrativo para calcular el cambio real de servicios."
  echo "Esta autorización no activa la generación ni modifica el sistema."

  # dry-activate necesita observar el estado real de systemd como root. Se
  # obtiene la autorización una vez y se reutiliza si después se decide aplicar.
  sudo -v

  if ! sudo "$candidato/bin/switch-to-configuration" dry-activate; then
    error "No se pudo calcular de forma segura el plan de activación."
  fi
}

mostrar_reinicio() {
  local anterior="$1"
  local candidato="$2"
  local kernel_anterior
  local kernel_nuevo

  echo
  echo "=== Reinicio ==="

  kernel_anterior="$(readlink -f "$anterior/kernel" 2>/dev/null || true)"
  kernel_nuevo="$(readlink -f "$candidato/kernel" 2>/dev/null || true)"

  if [[ -n "$kernel_anterior" && -n "$kernel_nuevo" ]]; then
    if [[ "$kernel_anterior" != "$kernel_nuevo" ]]; then
      echo "El kernel cambia. Conviene reiniciar después de aplicar."
    else
      echo "No detecto un cambio de kernel."
    fi
  else
    echo "No pude determinar si cambia el kernel."
  fi
}

# ---------------------------------------------------------------------------
# C.1 · Ciclo de cambios
#
# preview, build y apply comparten este motor. La salida humana y la salida
# estructurada nacen de los mismos datos; la GUI no necesita interpretar
# mensajes destinados a personas.
# ---------------------------------------------------------------------------

CICLO_ACTUAL=""
CICLO_CANDIDATO=""
CICLO_DIFERENCIAS=""
CICLO_ACTIVACION=""
CICLO_IMPACTO_JSON=""

ciclo_cambio_lineas_json() {
  local texto="${1:-}"
  local jq_bin

  jq_bin="$(command -v jq 2>/dev/null || true)"

  [[ -n "$jq_bin" ]] \
    || error "jq no está disponible."

  printf '%s' "$texto" \
    | "$jq_bin" -Rs \
      'split("\n") | map(select(length > 0))'
}

ciclo_cambio_impacto_json() {
  local actual="$1"
  local candidato="$2"
  local jq_bin
  local kernel_actual=""
  local kernel_nuevo=""
  local reinicio_conocido=false
  local reinicio_requerido=false
  local reinicio_json="null"
  local escritorio_raw=""
  local escritorio=""
  local ejecutable_relativo=""
  local ejecutable_actual=""
  local ejecutable_nuevo=""
  local sesion_conocida=false
  local logout_requerido=false
  local logout_json="null"
  local clasificacion="unknown"

  jq_bin="$(command -v jq 2>/dev/null || true)"

  [[ -n "$jq_bin" ]] \
    || error "jq no está disponible."

  if [[ -n "$actual" \
    && -e "$actual/kernel" \
    && -e "$candidato/kernel" ]]
  then
    kernel_actual="$(
      readlink -f \
        "$actual/kernel" \
        2>/dev/null \
        || true
    )"

    kernel_nuevo="$(
      readlink -f \
        "$candidato/kernel" \
        2>/dev/null \
        || true
    )"

    if [[ -n "$kernel_actual" \
      && -n "$kernel_nuevo" ]]
    then
      reinicio_conocido=true

      if [[ "$kernel_actual" != "$kernel_nuevo" ]]; then
        reinicio_requerido=true
      fi

      reinicio_json="$reinicio_requerido"
    fi
  fi

  escritorio_raw="${XDG_CURRENT_DESKTOP:-}"

  if [[ -z "$escritorio_raw" ]]; then
    escritorio_raw="${XDG_SESSION_DESKTOP:-}"
  fi

  escritorio="$(
    printf '%s' "$escritorio_raw" \
      | tr '[:upper:]' '[:lower:]'
  )"

  case "$escritorio" in
    *niri*)
      ejecutable_relativo="sw/bin/niri"
      ;;
    *hyprland*)
      ejecutable_relativo="sw/bin/Hyprland"
      ;;
    *gnome*)
      ejecutable_relativo="sw/bin/gnome-shell"
      ;;
    *plasma*|*kde*)
      ejecutable_relativo="sw/bin/kwin_wayland"
      ;;
    *cinnamon*)
      ejecutable_relativo="sw/bin/cinnamon"
      ;;
  esac

  if [[ -n "$actual" \
    && -n "$ejecutable_relativo" \
    && -e "$actual/$ejecutable_relativo" ]]
  then
    ejecutable_actual="$(
      readlink -f \
        "$actual/$ejecutable_relativo" \
        2>/dev/null \
        || true
    )"

    if [[ -n "$ejecutable_actual" ]]; then
      sesion_conocida=true

      if [[ -e "$candidato/$ejecutable_relativo" ]]; then
        ejecutable_nuevo="$(
          readlink -f \
            "$candidato/$ejecutable_relativo" \
            2>/dev/null \
            || true
        )"

        if [[ -z "$ejecutable_nuevo" \
          || "$ejecutable_actual" != "$ejecutable_nuevo" ]]
        then
          logout_requerido=true
        fi
      else
        logout_requerido=true
      fi

      logout_json="$logout_requerido"
    fi
  fi

  if [[ "$reinicio_conocido" == true \
    && "$reinicio_requerido" == true ]]
  then
    clasificacion="reboot"
  elif [[ "$sesion_conocida" == true \
    && "$logout_requerido" == true ]]
  then
    clasificacion="logout"
  elif [[ "$reinicio_conocido" == true \
    && "$sesion_conocida" == true ]]
  then
    clasificacion="immediate"
  fi

  # Las variables siguientes pertenecen al programa jq.
  # shellcheck disable=SC2016
  "$jq_bin" -cn \
    --arg classification "$clasificacion" \
    --arg kernelCurrent "$kernel_actual" \
    --arg kernelCandidate "$kernel_nuevo" \
    --argjson rebootKnown "$reinicio_conocido" \
    --argjson rebootRequired "$reinicio_json" \
    --arg desktop "$escritorio_raw" \
    --arg executable "$ejecutable_relativo" \
    --arg sessionCurrent "$ejecutable_actual" \
    --arg sessionCandidate "$ejecutable_nuevo" \
    --argjson logoutKnown "$sesion_conocida" \
    --argjson logoutRequired "$logout_json" \
    '{
      classification: $classification,
      reboot: {
        known: $rebootKnown,
        required: $rebootRequired,
        source: "kernel",
        current: ($kernelCurrent | if . == "" then null else . end),
        candidate: ($kernelCandidate | if . == "" then null else . end)
      },
      logout: {
        known: $logoutKnown,
        required: $logoutRequired,
        source: "active-session-executable",
        desktop: ($desktop | if . == "" then null else . end),
        executable: ($executable | if . == "" then null else . end),
        current: ($sessionCurrent | if . == "" then null else . end),
        candidate: ($sessionCandidate | if . == "" then null else . end)
      }
    }'
}

ciclo_cambio_diferencias_texto() {
  local anterior="$1"
  local candidato="$2"
  local salida=""

  if [[ -z "$anterior" \
    || ! -e "$anterior" ]]
  then
    echo "No pude encontrar el sistema actualmente en uso para compararlo."
    return 0
  fi

  if ! salida="$(
    nix store diff-closures \
      "$anterior" \
      "$candidato" \
      2>&1
  )"
  then
    [[ -z "$salida" ]] \
      || printf '%s\n' "$salida"

    echo "Nix no pudo producir el resumen de diferencias de closures."
    return 0
  fi

  [[ -z "$salida" ]] \
    || printf '%s\n' "$salida"
}

ciclo_cambio_activacion_texto() {
  local candidato="$1"
  local salida=""

  [[ -x "$candidato/bin/switch-to-configuration" ]] \
    || error "La generación candidata no contiene switch-to-configuration."

  sudo -v

  if ! salida="$(
    sudo \
      "$candidato/bin/switch-to-configuration" \
      dry-activate \
      2>&1
  )"
  then
    [[ -z "$salida" ]] \
      || printf '%s\n' "$salida" >&2

    error "No se pudo calcular de forma segura el plan de activación."
  fi

  [[ -z "$salida" ]] \
    || printf '%s\n' "$salida"
}

ciclo_cambio_preparar() {
  local alcance="${1:-}"

  case "$alcance" in
    build|preview)
      ;;
    *)
      error "Alcance interno desconocido del ciclo de cambios: $alcance"
      ;;
  esac

  CICLO_ACTUAL="$(ruta_actual)"
  CICLO_CANDIDATO="$(construir_candidato)"
  CICLO_DIFERENCIAS=""
  CICLO_ACTIVACION=""

  if [[ "$alcance" == "preview" ]]; then
    CICLO_DIFERENCIAS="$(
      ciclo_cambio_diferencias_texto \
        "$CICLO_ACTUAL" \
        "$CICLO_CANDIDATO"
    )"

    CICLO_ACTIVACION="$(
      ciclo_cambio_activacion_texto \
        "$CICLO_CANDIDATO"
    )"
  fi

  CICLO_IMPACTO_JSON="$(
    ciclo_cambio_impacto_json \
      "$CICLO_ACTUAL" \
      "$CICLO_CANDIDATO"
  )"
}

ciclo_cambio_json() {
  local accion="$1"
  local validado="$2"
  local previsualizado="$3"
  local confirmado="$4"
  local aplicado="$5"
  local verificado="$6"
  local jq_bin
  local diferencias_json
  local activacion_json
  local version_actual=""
  local version_candidata=""
  local estado="prepared"

  jq_bin="$(command -v jq 2>/dev/null || true)"

  [[ -n "$jq_bin" ]] \
    || error "jq no está disponible."

  diferencias_json="$(
    ciclo_cambio_lineas_json \
      "$CICLO_DIFERENCIAS"
  )"

  activacion_json="$(
    ciclo_cambio_lineas_json \
      "$CICLO_ACTIVACION"
  )"

  if [[ -n "$CICLO_ACTUAL" \
    && -r "$CICLO_ACTUAL/nixos-version" ]]
  then
    version_actual="$(
      cat "$CICLO_ACTUAL/nixos-version"
    )"
  fi

  if [[ -r "$CICLO_CANDIDATO/nixos-version" ]]; then
    version_candidata="$(
      cat "$CICLO_CANDIDATO/nixos-version"
    )"
  fi

  if [[ "$aplicado" == true ]]; then
    estado="applied"
  fi

  # Las variables siguientes pertenecen al programa jq.
  # shellcheck disable=SC2016
  "$jq_bin" -cn \
    --arg action "$accion" \
    --arg hostId "$HOST" \
    --arg state "$estado" \
    --arg currentSystem "$CICLO_ACTUAL" \
    --arg currentVersion "$version_actual" \
    --arg candidateSystem "$CICLO_CANDIDATO" \
    --arg candidateVersion "$version_candidata" \
    --argjson validated "$validado" \
    --argjson previewed "$previsualizado" \
    --argjson confirmed "$confirmado" \
    --argjson applied "$aplicado" \
    --argjson verified "$verificado" \
    --argjson impact "$CICLO_IMPACTO_JSON" \
    --argjson closureDiff "$diferencias_json" \
    --argjson activationPlan "$activacion_json" \
    '{
      schemaVersion: 1,
      kind: "korunix-change-cycle",
      action: $action,
      hostId: $hostId,
      state: $state,
      current: {
        systemPath: ($currentSystem | if . == "" then null else . end),
        nixosVersion: ($currentVersion | if . == "" then null else . end)
      },
      candidate: {
        systemPath: $candidateSystem,
        nixosVersion: ($candidateVersion | if . == "" then null else . end)
      },
      phases: {
        validated: $validated,
        built: true,
        previewed: $previewed,
        confirmed: (
          if $action == "apply"
          then $confirmed
          else null
          end
        ),
        applied: $applied,
        verified: (
          if $applied
          then $verified
          else null
          end
        )
      },
      impact: $impact,
      details: {
        closureDiff: $closureDiff,
        activationPlan: $activationPlan
      },
      safety: {
        writesRepository: false,
        buildsGeneration: true,
        appliesGeneration: $applied,
        runningSystemChanged: $applied
      }
    }'
}

mostrar_ciclo_cambio_humano() {
  local jq_bin
  local clasificacion
  local reinicio
  local logout

  jq_bin="$(command -v jq 2>/dev/null || true)"

  [[ -n "$jq_bin" ]] \
    || error "jq no está disponible."

  echo
  echo "=== Generación candidata ==="
  echo "$CICLO_CANDIDATO"

  echo
  echo "=== Diferencias de paquetes y cierres ==="

  if [[ -n "$CICLO_DIFERENCIAS" ]]; then
    printf '%s\n' \
      "$CICLO_DIFERENCIAS"
  else
    echo "No se observaron diferencias en el resumen disponible."
  fi

  echo
  echo "=== Cambios de servicios y activación ==="

  if [[ -n "$CICLO_ACTIVACION" ]]; then
    printf '%s\n' \
      "$CICLO_ACTIVACION"
  else
    echo "No se informaron cambios de activación."
  fi

  clasificacion="$(
    "$jq_bin" -r \
      '.classification' \
      <<<"$CICLO_IMPACTO_JSON"
  )"

  reinicio="$(
    "$jq_bin" -r \
      '.reboot.required // false' \
      <<<"$CICLO_IMPACTO_JSON"
  )"

  logout="$(
    "$jq_bin" -r \
      '.logout.required // false' \
      <<<"$CICLO_IMPACTO_JSON"
  )"

  echo
  echo "=== Impacto después de aplicar ==="

  case "$clasificacion" in
    reboot)
      echo "Será necesario reiniciar el equipo para usar completamente el cambio."
      ;;
    logout)
      echo "Será necesario cerrar la sesión gráfica y volver a entrar."
      ;;
    immediate)
      echo "No se prevé reinicio ni cierre de sesión para completar el cambio."
      ;;
    unknown)
      echo "Korunix no puede determinar con seguridad si hará falta cerrar sesión."
      echo "No supondrá que el efecto es inmediato."
      ;;
    *)
      error "Clasificación de impacto desconocida: $clasificacion"
      ;;
  esac

  if [[ "$reinicio" == true \
    && "$logout" == true ]]
  then
    echo "El reinicio también sustituirá la sesión gráfica actual."
  fi
}

previsualizar() {
  local modo="${1:-}"

  [[ "$#" -le 1 ]] \
    || error "Uso: scripts/korunix preview [--json]."

  case "$modo" in
    ""|--json)
      ;;
    *)
      error "Uso: scripts/korunix preview [--json]."
      ;;
  esac

  ciclo_cambio_preparar preview

  if [[ "$modo" == "--json" ]]; then
    ciclo_cambio_json \
      preview \
      false \
      true \
      false \
      false \
      false
    return
  fi

  mostrar_ciclo_cambio_humano

  echo
  echo "✓ PREVISUALIZACIÓN COMPLETA"
  echo "No se aplicó ninguna generación."
}

construir() {
  local modo="${1:-}"

  [[ "$#" -le 1 ]] \
    || error "Uso: scripts/korunix build [--json]."

  case "$modo" in
    ""|--json)
      ;;
    *)
      error "Uso: scripts/korunix build [--json]."
      ;;
  esac

  ciclo_cambio_preparar build

  if [[ "$modo" == "--json" ]]; then
    ciclo_cambio_json \
      build \
      false \
      false \
      false \
      false \
      false
    return
  fi

  echo
  echo "✓ CONSTRUCCIÓN COMPLETA"
  echo "$CICLO_CANDIDATO"
}

verificar_sistema() {
  local esperado="${1:-}"
  local actual
  local predeterminado

  actual="$(ruta_actual)"
  predeterminado="$(ruta_predeterminada)"

  echo
  echo "=== Verificación posterior ==="
  echo "Sistema en uso: $actual"
  echo "Sistema predeterminado: $predeterminado"

  if [[ -n "$esperado" && "$actual" != "$esperado" ]]; then
    aviso "La generación en uso no coincide con la que esperaba Korunix."
  fi

  echo
  echo "=== Servicios de sistema fallidos ==="
  systemctl --failed --no-pager || true

  echo
  echo "=== Servicios de usuario fallidos ==="
  systemctl --user --failed --no-pager || true
}

preparar_usuario_actual_despues_de_aplicar() {
  local load_state

  echo
  echo "=== Preferencias personales ==="

  load_state="$(
    systemctl --user show korunix-user-prepare.service \
      -p LoadState \
      --value \
      2>/dev/null \
      || true
  )"

  if [[ "$load_state" != "loaded" ]]; then
    aviso "No pude actualizar ahora las preferencias personales de esta sesión."
    echo "Korunix las preparará en el próximo inicio de sesión."
    return 0
  fi

  if ! systemctl --user start korunix-user-prepare.service; then
    aviso "El sistema ya fue aplicado, pero la preparación personal no pudo ejecutarse ahora."
    echo "Korunix volverá a intentarlo en el próximo inicio de sesión."
    return 0
  fi

  echo "✓ Preferencias personales actualizadas para la sesión actual"
}

aplicar() {
  local formato="human"
  local confirmado_externo=false
  local confirmado=false
  local verificado=false
  local argumento

  for argumento in "$@"; do
    case "$argumento" in
      --yes)
        [[ "$confirmado_externo" == false ]] \
          || error "Uso: scripts/korunix apply [--yes] [--json]."

        confirmado_externo=true
        ;;
      --json)
        [[ "$formato" == "human" ]] \
          || error "Uso: scripts/korunix apply [--yes] [--json]."

        formato="json"
        ;;
      *)
        error "Uso: scripts/korunix apply [--yes] [--json]."
        ;;
    esac
  done

  if [[ "$formato" == "json" \
    && "$confirmado_externo" != true ]]
  then
    error "apply --json necesita --yes porque una salida de máquina no puede solicitar confirmación interactiva."
  fi

  if [[ "$formato" == "json" ]]; then
    echo "Korunix comprobará, construirá y previsualizará antes de aplicar." >&2
    validar >&2
  else
    echo "Korunix comprobará, construirá y previsualizará antes de aplicar."
    validar
  fi

  ciclo_cambio_preparar preview

  if [[ "$formato" == "human" ]]; then
    mostrar_ciclo_cambio_humano

    echo
    echo "Hasta aquí no se modificó el sistema."
  fi

  if [[ "$confirmado_externo" == true ]]; then
    confirmado=true

    if [[ "$formato" == "human" ]]; then
      echo
      echo "✓ Confirmación previa indicada mediante --yes"
    fi
  else
    confirmar "¿Aplicar esta generación ahora?" \
      || return 0

    confirmado=true
  fi

  if [[ "$formato" == "human" ]]; then
    echo
    echo "La autorización administrativa obtenida durante la previsualización se reutilizará ahora."

    sudo nixos-rebuild \
      switch \
      --flake "${ROOT}#${HOST}"
  else
    echo "Aplicando la generación confirmada..." >&2

    sudo nixos-rebuild \
      switch \
      --flake "${ROOT}#${HOST}" \
      >&2
  fi

  if [[ "$(ruta_actual)" == "$CICLO_CANDIDATO" ]]; then
    verificado=true
  fi

  if [[ "$formato" == "json" ]]; then
    verificar_sistema \
      "$CICLO_CANDIDATO" \
      >&2

    preparar_usuario_actual_despues_de_aplicar \
      >&2

    ciclo_cambio_json \
      apply \
      true \
      true \
      "$confirmado" \
      true \
      "$verificado"

    return
  fi

  verificar_sistema \
    "$CICLO_CANDIDATO"

  preparar_usuario_actual_despues_de_aplicar

  echo
  echo "✓ GENERACIÓN APLICADA"
}

# ---------------------------------------------------------------------------
# C.2 · Actualizaciones y migraciones
#
# Actualizar fuentes modifica flake.lock, pero nunca activa el sistema.
# El impacto efectivo de la candidata se calcula posteriormente mediante C.1.
# ---------------------------------------------------------------------------

ACTUALIZACION_ACTIVA=false
ACTUALIZACION_BACKUP=""

actualizacion_entradas_json() {
  local jq_bin
  local scope="selected"
  local disponibles
  local entrada
  local targets_json
  local items="[]"
  local item
  local referencia
  local nodo
  local original
  local locked
  local solicitadas=("$@")

  jq_bin="$(command -v jq 2>/dev/null || true)"
  [[ -n "$jq_bin" ]] || error "jq no está disponible."

  disponibles="$(
    "$jq_bin" -r \
      '.nodes.root.inputs | keys[]' \
      "$ROOT/flake.lock"
  )"

  if [[ "${#solicitadas[@]}" -eq 0 ]]; then
    scope="all"

    targets_json="$(
      printf '%s\n' "$disponibles" |
        "$jq_bin" -Rsc \
          'split("\n")
           | map(select(length > 0))
           | unique'
    )"
  else
    for entrada in "${solicitadas[@]}"; do
      grep -Fxq \
        "$entrada" \
        <<<"$disponibles" \
        || error "Entrada del flake desconocida: $entrada"
    done

    targets_json="$(
      printf '%s\n' \
        "${solicitadas[@]}" |
        "$jq_bin" -Rsc \
          'split("\n")
           | map(select(length > 0))
           | unique'
    )"
  fi

  while IFS= read -r entrada; do
    [[ -n "$entrada" ]] || continue

    # $entrada pertenece al filtro jq.
    # shellcheck disable=SC2016
    referencia="$(
      "$jq_bin" -c \
        --arg entrada "$entrada" \
        '.nodes.root.inputs[$entrada] // null' \
        "$ROOT/flake.lock"
    )"

    # $entrada pertenece al filtro jq.
    # shellcheck disable=SC2016
    nodo="$(
      "$jq_bin" -r \
        --arg entrada "$entrada" \
        '.nodes.root.inputs[$entrada]
         | if type == "string"
           then .
           else empty
           end' \
        "$ROOT/flake.lock"
    )"

    if [[ -n "$nodo" ]]; then
      # $nodo pertenece al filtro jq.
      # shellcheck disable=SC2016
      original="$(
        "$jq_bin" -c \
          --arg nodo "$nodo" \
          '.nodes[$nodo].original // null' \
          "$ROOT/flake.lock"
      )"

      # $nodo pertenece al filtro jq.
      # shellcheck disable=SC2016
      locked="$(
        "$jq_bin" -c \
          --arg nodo "$nodo" \
          '.nodes[$nodo].locked // null' \
          "$ROOT/flake.lock"
      )"
    else
      original="null"
      locked="null"
    fi

    # Variables pertenecientes al filtro jq.
    # shellcheck disable=SC2016
    item="$(
      "$jq_bin" -cn \
        --arg name "$entrada" \
        --arg node "$nodo" \
        --argjson reference "$referencia" \
        --argjson original "$original" \
        --argjson locked "$locked" \
        '{
          name: $name,
          reference: $reference,
          node: (
            $node
            | if . == "" then null else . end
          ),
          original: $original,
          locked: $locked
        }'
    )"

    # Variables pertenecientes al filtro jq.
    # shellcheck disable=SC2016
    items="$(
      "$jq_bin" -cn \
        --argjson items "$items" \
        --argjson item "$item" \
        '$items + [$item]'
    )"
  done < <(
    "$jq_bin" -r \
      '.[]' \
      <<<"$targets_json"
  )

  # Variables pertenecientes al filtro jq.
  # shellcheck disable=SC2016
  "$jq_bin" -cn \
    --arg scope "$scope" \
    --argjson targets "$targets_json" \
    --argjson items "$items" \
    '{
      scope: $scope,
      targets: $targets,
      items: $items
    }'
}

actualizacion_plan_json() {
  local jq_bin
  local entradas
  local canal=""
  local state_version=""

  jq_bin="$(command -v jq 2>/dev/null || true)"
  [[ -n "$jq_bin" ]] || error "jq no está disponible."

  entradas="$(
    actualizacion_entradas_json "$@"
  )"

  canal="$(
    canal_declarado \
      2>/dev/null \
      || true
  )"

  state_version="$(
    nix eval \
      ".#nixosConfigurations.${HOST}.config.system.stateVersion" \
      --raw \
      --no-write-lock-file \
      2>/dev/null \
      || true
  )"

  # Variables pertenecientes al filtro jq.
  # shellcheck disable=SC2016
  "$jq_bin" -cn \
    --arg hostId "$HOST" \
    --arg channel "$canal" \
    --arg stateVersion "$state_version" \
    --argjson inputs "$entradas" \
    '{
      schemaVersion: 1,
      kind: "korunix-update-plan",
      hostId: $hostId,
      scope: $inputs.scope,
      targets: $inputs.targets,
      current: $inputs.items,
      channel: {
        current: (
          $channel
          | if . == "" then null else . end
        ),
        supported: [
          "stable",
          "unstable"
        ]
      },
      migration: {
        stateVersion: (
          $stateVersion
          | if . == "" then null else . end
        ),
        changesStateVersion: false,
        systemMigrationsOnActivation: true,
        userPreparationOnApply: true
      },
      impact: {
        knownBeforeBuild: false,
        resolvedBy: "scripts/korunix preview --json"
      },
      recovery: {
        lockBackupBeforeUpdate: true,
        systemGenerationAfterApply: true,
        managedBy: "scripts/korunix rollback"
      },
      actions: {
        planWritesRepository: false,
        updateWritesRepository: true,
        modifiesFlakeLock: true,
        buildsGeneration: false,
        appliesGeneration: false
      },
      next: {
        preview: "scripts/korunix preview --json",
        apply: "scripts/korunix apply"
      }
    }'
}

mostrar_plan_actualizacion() {
  local plan="$1"
  local jq_bin

  jq_bin="$(command -v jq 2>/dev/null || true)"
  [[ -n "$jq_bin" ]] || error "jq no está disponible."

  echo "=== Plan de actualización ==="
  echo "Equipo: $HOST"

  echo
  echo "Fuentes:"

  "$jq_bin" -r \
    '.current[]
     | "  • " + .name
       + ": "
       + (
           .locked.rev
           // .locked.ref
           // .locked.url
           // "estado actual"
         )' \
    <<<"$plan"

  echo
  echo "Canal actual: $("$jq_bin" -r '.channel.current // "desconocido"' <<<"$plan")"
  echo "stateVersion: $("$jq_bin" -r '.migration.stateVersion // "desconocida"' <<<"$plan")"

  echo
  echo "Actualizar fuentes no cambia stateVersion."
  echo "Esta operación modifica flake.lock, pero no construye ni aplica NixOS."
  echo "Después, preview calcula si hará falta reiniciar o cerrar sesión."
}

actualizacion_resultado_json() {
  local anterior="$1"
  local nuevo="$2"
  local plan="$3"
  local respaldo="$4"
  local jq_bin
  local sha_antes
  local sha_despues

  jq_bin="$(command -v jq 2>/dev/null || true)"
  [[ -n "$jq_bin" ]] || error "jq no está disponible."

  sha_antes="$(
    sha256sum "$anterior" |
      cut -d' ' -f1
  )"

  sha_despues="$(
    sha256sum "$nuevo" |
      cut -d' ' -f1
  )"

  # Variables pertenecientes al filtro jq.
  # shellcheck disable=SC2016
  "$jq_bin" -cn \
    --slurpfile before "$anterior" \
    --slurpfile after "$nuevo" \
    --argjson plan "$plan" \
    --arg backup "$respaldo" \
    --arg beforeSha256 "$sha_antes" \
    --arg afterSha256 "$sha_despues" \
    '
      def input($doc; $name):
        ($doc.nodes.root.inputs[$name] // null) as $reference
        | (
            if ($reference | type) == "string"
            then $reference
            else null
            end
          ) as $node
        | {
            name: $name,
            reference: $reference,
            node: $node,
            original: (
              if $node == null
              then null
              else ($doc.nodes[$node].original // null)
              end
            ),
            locked: (
              if $node == null
              then null
              else ($doc.nodes[$node].locked // null)
              end
            )
          };

      [
        $plan.targets[] as $name
        | input($before[0]; $name) as $old
        | input($after[0]; $name) as $new
        | {
            name: $name,
            before: $old,
            after: $new,
            changed: ($old != $new)
          }
      ] as $inputs

      | {
          schemaVersion: 1,
          kind: "korunix-update-result",
          hostId: $plan.hostId,
          changed: ($beforeSha256 != $afterSha256),
          changedInputs: [
            $inputs[]
            | select(.changed)
            | .name
          ],
          inputs: $inputs,
          lock: {
            beforeSha256: $beforeSha256,
            afterSha256: $afterSha256,
            backup: $backup
          },
          channel: $plan.channel,
          migration: $plan.migration,
          impact: $plan.impact,
          recovery: $plan.recovery,
          actions: {
            writesRepository: true,
            modifiedFlakeLock: ($beforeSha256 != $afterSha256),
            buildsGeneration: false,
            appliesGeneration: false
          },
          next: $plan.next
        }
    '
}

actualizacion_restaurar_pendiente() {
  if [[ "$ACTUALIZACION_ACTIVA" == true \
    && -n "$ACTUALIZACION_BACKUP" \
    && -r "$ACTUALIZACION_BACKUP/flake.lock" ]]
  then
    cp -p \
      "$ACTUALIZACION_BACKUP/flake.lock" \
      "$ROOT/flake.lock"

    ACTUALIZACION_ACTIVA=false
  fi
}

actualizar() {
  local formato="human"
  local modo="execute"
  local argumento
  local entradas=()
  local plan
  local marca
  local respaldo
  local resultado
  local state_root=""

  for argumento in "$@"; do
    case "$argumento" in
      --plan)
        [[ "$modo" == "execute" ]] \
          || error "Uso: scripts/korunix update [entradas...] [--plan] [--json]."

        modo="plan"
        ;;
      --json)
        [[ "$formato" == "human" ]] \
          || error "Uso: scripts/korunix update [entradas...] [--plan] [--json]."

        formato="json"
        ;;
      -h|--help)
        cat <<'UPDATE_USAGE'
Uso:
  scripts/korunix update
  scripts/korunix update noctalia
  scripts/korunix update nixpkgs noctalia
  scripts/korunix update --plan
  scripts/korunix update --plan --json
  scripts/korunix update noctalia --plan --json
  scripts/korunix update --json

El plan no escribe nada.

La actualización modifica únicamente flake.lock, conserva un respaldo y valida
el resultado. No construye ni aplica una generación. stateVersion permanece
independiente de la actualización de fuentes.
UPDATE_USAGE
        return
        ;;
      -*)
        error "Opción de update desconocida: $argumento"
        ;;
      *)
        entradas+=("$argumento")
        ;;
    esac
  done

  plan="$(
    actualizacion_plan_json \
      "${entradas[@]}"
  )"

  if [[ "$modo" == "plan" ]]; then
    if [[ "$formato" == "json" ]]; then
      printf '%s\n' "$plan"
    else
      mostrar_plan_actualizacion "$plan"
    fi

    return
  fi

  if ! git diff --quiet -- flake.lock \
    || ! git diff --cached --quiet -- flake.lock
  then
    error "flake.lock ya tiene cambios locales. Guárdalos o reviértelos antes de actualizar."
  fi

  if [[ "$formato" == "human" ]]; then
    mostrar_plan_actualizacion "$plan"
    echo
  else
    echo "Preparando actualización de fuentes..." >&2
  fi

  state_root="${XDG_STATE_HOME:-}"

  if [[ -z "$state_root" ]]; then
    state_root="$HOME/.local/state"
  fi

  marca="$(date +%Y%m%d-%H%M%S)-$$"

  respaldo="$state_root/korunix/backups/update-${HOST}-${marca}"

  mkdir -p "$respaldo"

  cp -p \
    flake.lock \
    "$respaldo/flake.lock"

  ACTUALIZACION_BACKUP="$respaldo"
  ACTUALIZACION_ACTIVA=true

  trap 'actualizacion_restaurar_pendiente' EXIT
  trap 'actualizacion_restaurar_pendiente; exit 130' INT
  trap 'actualizacion_restaurar_pendiente; exit 143' TERM
  trap 'actualizacion_restaurar_pendiente; exit 129' HUP

  if [[ "${#entradas[@]}" -eq 0 ]]; then
    if [[ "$formato" == "json" ]]; then
      nix flake update >&2 \
        || {
          actualizacion_restaurar_pendiente
          trap - EXIT INT TERM HUP
          error "La actualización falló; flake.lock fue restaurado."
        }
    else
      nix flake update \
        || {
          actualizacion_restaurar_pendiente
          trap - EXIT INT TERM HUP
          error "La actualización falló; flake.lock fue restaurado."
        }
    fi
  else
    if [[ "$formato" == "json" ]]; then
      nix flake update \
        "${entradas[@]}" \
        >&2 \
        || {
          actualizacion_restaurar_pendiente
          trap - EXIT INT TERM HUP
          error "La actualización selectiva falló; flake.lock fue restaurado."
        }
    else
      nix flake update \
        "${entradas[@]}" \
        || {
          actualizacion_restaurar_pendiente
          trap - EXIT INT TERM HUP
          error "La actualización selectiva falló; flake.lock fue restaurado."
        }
    fi
  fi

  if [[ "$formato" == "json" ]]; then
    if ! validar >&2; then
      actualizacion_restaurar_pendiente
      trap - EXIT INT TERM HUP
      error "La actualización no pasó la validación; flake.lock fue restaurado."
    fi
  else
    if ! validar; then
      actualizacion_restaurar_pendiente
      trap - EXIT INT TERM HUP
      error "La actualización no pasó la validación; flake.lock fue restaurado."
    fi
  fi

  resultado="$(
    actualizacion_resultado_json \
      "$respaldo/flake.lock" \
      flake.lock \
      "$plan" \
      "$respaldo"
  )"

  ACTUALIZACION_ACTIVA=false
  trap - EXIT INT TERM HUP

  if [[ "$formato" == "json" ]]; then
    printf '%s\n' "$resultado"
    return
  fi

  echo
  echo "=== Cambios de flake.lock ==="
  git diff --stat -- flake.lock

  echo
  echo "Fuentes modificadas:"

  if [[ "$(jq -r '.changed' <<<"$resultado")" == true ]]; then
    jq -r \
      '.changedInputs[]
       | "  • " + .' \
      <<<"$resultado"
  else
    echo "  ninguna"
  fi

  echo
  echo "✓ ACTUALIZACIÓN PREPARADA"
  echo "flake.lock pasó la validación."
  echo "El sistema todavía no fue construido ni aplicado."
  echo "stateVersion no fue modificado."
  echo "Usa scripts/korunix preview para calcular el impacto real."
  echo "Respaldo: $respaldo"
}

# ---------------------------------------------------------------------------
# C.3 · Recuperación y rollback
#
# La recuperación segura no cambia la sesión actual ni sustituye
# permanentemente la generación predeterminada. Programa una generación
# existente para un único arranque mediante el cargador correspondiente.
# ---------------------------------------------------------------------------

recuperacion_bootloader() {
  if [[ -d /sys/firmware/efi ]]; then
    printf '%s\n' \
      "systemd-boot"
  else
    printf '%s\n' \
      "grub"
  fi
}

recuperacion_generaciones_json() {
  local jq_bin
  local actual
  local actual_id=""
  local predeterminada
  local generacion
  local ruta
  local version
  local item
  local items="[]"
  local generaciones=()

  jq_bin="$(command -v jq 2>/dev/null || true)"
  [[ -n "$jq_bin" ]] \
    || error "jq no está disponible."

  actual="$(ruta_actual)"
  predeterminada="$(generacion_predeterminada)"

  if [[ -n "$actual" ]]; then
    actual_id="$(
      generacion_de_ruta "$actual"
    )"
  fi

  mapfile -t generaciones < <(
    numeros_generaciones
  )

  for generacion in "${generaciones[@]}"; do
    ruta="$(
      ruta_generacion "$generacion"
    )"

    [[ -n "$ruta" ]] \
      || continue

    version=""

    if [[ -r "$ruta/nixos-version" ]]; then
      version="$(
        cat "$ruta/nixos-version"
      )"
    fi

    # Variables pertenecientes al filtro jq.
    # shellcheck disable=SC2016
    item="$(
      "$jq_bin" -cn \
        --argjson id "$generacion" \
        --arg path "$ruta" \
        --arg version "$version" \
        --arg currentId "$actual_id" \
        --arg defaultId "$predeterminada" \
        '{
          id: $id,
          systemPath: $path,
          nixosVersion: (
            $version
            | if . == "" then null else . end
          ),
          current: (
            if $currentId == ""
            then false
            else (
              $id
              == ($currentId | tonumber)
            )
            end
          ),
          default: (
            if $defaultId == ""
            then false
            else (
              $id
              == ($defaultId | tonumber)
            )
            end
          )
        }'
    )"

    # Variables pertenecientes al filtro jq.
    # shellcheck disable=SC2016
    items="$(
      "$jq_bin" -cn \
        --argjson items "$items" \
        --argjson item "$item" \
        '$items + [$item]'
    )"
  done

  # Variables pertenecientes al filtro jq.
  # shellcheck disable=SC2016
  "$jq_bin" -cn \
    --arg hostId "$HOST" \
    --arg bootloader "$(recuperacion_bootloader)" \
    --arg currentSystem "$actual" \
    --arg defaultGeneration "$predeterminada" \
    --argjson generations "$items" \
    '{
      schemaVersion: 1,
      kind: "korunix-recovery-list",
      hostId: $hostId,
      bootloader: $bootloader,
      currentSystem: (
        $currentSystem
        | if . == "" then null else . end
      ),
      defaultGeneration: (
        $defaultGeneration
        | if . == ""
          then null
          else tonumber
          end
      ),
      generations: $generations
    }'
}

recuperacion_plan_json() {
  local generacion="$1"
  local jq_bin
  local lista
  local objetivo
  local bootloader

  [[ "$generacion" =~ ^[0-9]+$ ]] \
    || error "Indica un ID numérico de generación."

  jq_bin="$(command -v jq 2>/dev/null || true)"
  [[ -n "$jq_bin" ]] \
    || error "jq no está disponible."

  lista="$(
    recuperacion_generaciones_json
  )"

  # $generacion pertenece al filtro jq.
  # shellcheck disable=SC2016
  objetivo="$(
    "$jq_bin" -c \
      --arg generacion "$generacion" \
      '
        .generations[]
        | select(
            .id
            == ($generacion | tonumber)
          )
      ' \
      <<<"$lista"
  )"

  [[ -n "$objetivo" ]] \
    || error "El punto de recuperación ${generacion} no existe."

  bootloader="$(
    "$jq_bin" -r \
      '.bootloader' \
      <<<"$lista"
  )"

  # Variables pertenecientes al filtro jq.
  # shellcheck disable=SC2016
  "$jq_bin" -cn \
    --arg hostId "$HOST" \
    --arg bootloader "$bootloader" \
    --argjson target "$objetivo" \
    --argjson list "$lista" \
    '{
      schemaVersion: 1,
      kind: "korunix-recovery-plan",
      hostId: $hostId,
      bootloader: $bootloader,
      mode: "one-shot-next-boot",
      current: {
        systemPath: $list.currentSystem,
        generation: (
          [
            $list.generations[]
            | select(.current)
            | .id
          ][0] // null
        )
      },
      defaultGeneration: $list.defaultGeneration,
      target: $target,
      effects: {
        runningSystemChanged: false,
        defaultGenerationChanged: false,
        nextBootChanged: true,
        rebootRequiredToUseTarget: true
      },
      privilege: {
        requiredToSchedule: true
      },
      safety: {
        targetMustAlreadyExist: true,
        oneShotOnly: true,
        returnsToDefaultAfterBoot: true
      }
    }'
}

mostrar_plan_recuperacion() {
  local plan="$1"
  local jq_bin

  jq_bin="$(command -v jq 2>/dev/null || true)"
  [[ -n "$jq_bin" ]] \
    || error "jq no está disponible."

  echo "=== Recuperación segura ==="
  echo "Equipo: $HOST"
  echo "Cargador: $("$jq_bin" -r '.bootloader' <<<"$plan")"
  echo "Punto actual: $("$jq_bin" -r '.current.generation // "desconocido"' <<<"$plan")"
  echo "Punto predeterminado: $("$jq_bin" -r '.defaultGeneration // "desconocido"' <<<"$plan")"
  echo "Punto elegido: $("$jq_bin" -r '.target.id' <<<"$plan")"
  echo "Sistema elegido: $("$jq_bin" -r '.target.systemPath' <<<"$plan")"

  echo
  echo "Esta sesión no cambiará."
  echo "La generación predeterminada tampoco cambiará."
  echo "El punto elegido se usará solo en el próximo arranque."
  echo "Después se volverá al arranque predeterminado normal."
}

recuperacion_resultado_json() {
  local plan="$1"
  local entrada="$2"
  local jq_bin

  jq_bin="$(command -v jq 2>/dev/null || true)"
  [[ -n "$jq_bin" ]] \
    || error "jq no está disponible."

  # Variables pertenecientes al filtro jq.
  # shellcheck disable=SC2016
  "$jq_bin" -cn \
    --argjson plan "$plan" \
    --arg bootEntry "$entrada" \
    '{
      schemaVersion: 1,
      kind: "korunix-recovery-result",
      hostId: $plan.hostId,
      bootloader: $plan.bootloader,
      mode: $plan.mode,
      target: $plan.target,
      bootEntry: $bootEntry,
      scheduled: true,
      verified: true,
      verification: {
        method: (
          if $plan.bootloader == "grub"
          then "grubenv-next-entry"
          else "bootloader-command-exit-status"
          end
        )
      },
      effects: $plan.effects,
      safety: $plan.safety
    }'
}

grub_entrada_desde_config() {
  local generacion="$1"
  local config
  local submenu
  local entrada
  local base

  [[ "$generacion" =~ ^[0-9]+$ ]] \
    || error "Generación GRUB inválida: $generacion"

  config="$(cat)"

  submenu="$(
    sed -nE \
      's/^[[:space:]]*submenu "([^"]+ - All configurations)".*/\1/p' \
      <<<"$config" |
      head -n 1
  )"

  [[ -n "$submenu" ]] \
    || error "No encontré el submenú de generaciones de NixOS en GRUB."

  entrada="$(
    sed -nE \
      "s/^[[:space:]]*menuentry \"([^\"]* - Configuration ${generacion} \\([^\"]*)\".*/\\1/p" \
      <<<"$config" |
      head -n 1
  )"

  [[ -n "$entrada" ]] \
    || error "GRUB no contiene una entrada para la generación ${generacion}."

  if [[ "$entrada" == *" - Default" ]]; then
    base="${entrada% - Default}"

    printf '%s>%s>%s\n' \
      "$submenu" \
      "$base" \
      "$entrada"
  else
    printf '%s>%s\n' \
      "$submenu" \
      "$entrada"
  fi
}

recuperacion_archivo_grub() {
  printf '%s\n' \
    "${KORUNIX_GRUB_CONFIG:-/boot/grub/grub.cfg}"
}

recuperacion_programar_systemd_boot() {
  local generacion="$1"
  local entrada

  command -v bootctl >/dev/null 2>&1 \
    || error "bootctl no está disponible."

  echo "Comprobando systemd-boot..." >&2

  sudo -v

  sudo bootctl is-installed >/dev/null 2>&1 \
    || error "systemd-boot no está instalado en la ESP."

  entrada="$(
    entrada_boot_para_generacion \
      "$generacion"
  )"

  [[ -n "$entrada" ]] \
    || error "No existe una entrada systemd-boot para la generación ${generacion}."

  sudo bootctl set-oneshot \
    "$entrada"

  printf '%s\n' \
    "$entrada"
}

recuperacion_programar_grub() {
  local generacion="$1"
  local config
  local boot_dir
  local grubenv
  local contenido
  local entrada
  local siguiente

  command -v grub-reboot >/dev/null 2>&1 \
    || error "grub-reboot no está disponible."

  command -v grub-editenv >/dev/null 2>&1 \
    || error "grub-editenv no está disponible."

  config="$(
    recuperacion_archivo_grub
  )"

  case "$config" in
    */grub/grub.cfg)
      boot_dir="${config%/grub/grub.cfg}"
      ;;
    *)
      error "Ruta de grub.cfg no compatible: $config"
      ;;
  esac

  grubenv="$boot_dir/grub/grubenv"

  echo "Comprobando GRUB..." >&2

  sudo -v

  sudo test -r "$config" \
    || error "No puedo leer la configuración de GRUB: $config"

  contenido="$(
    sudo cat "$config"
  )"

  entrada="$(
    grub_entrada_desde_config \
      "$generacion" \
      <<<"$contenido"
  )"

  sudo grub-reboot \
    --boot-directory="$boot_dir" \
    "$entrada"

  siguiente="$(
    sudo grub-editenv \
      "$grubenv" \
      list |
      sed -n \
        's/^next_entry=//p' |
      head -n 1
  )"

  [[ "$siguiente" == "$entrada" ]] \
    || error "GRUB no confirmó la entrada de arranque único."

  printf '%s\n' \
    "$entrada"
}

entrada_boot_para_generacion() {
  local generacion="$1"

  sudo bootctl list --no-pager 2>/dev/null \
    | awk -v generacion="$generacion" '
        /^[[:space:]]*id:/ {
          linea = $0
          sub(/^[[:space:]]*id:[[:space:]]*/, "", linea)
          id = linea
        }

        /^[[:space:]]*version:/ {
          linea = $0
          sub(/^[[:space:]]*version:[[:space:]]*/, "", linea)

          if (linea ~ ("^Generation " generacion "([[:space:]]|$)")) {
            print id
            exit
          }
        }
      '
}

rollback_generacion() {
  local accion="schedule"
  local formato="human"
  local modo="execute"
  local confirmado=false
  local generacion=""
  local argumento
  local plan
  local bootloader
  local entrada
  local resultado

  for argumento in "$@"; do
    case "$argumento" in
      --list)
        [[ "$accion" == "schedule" \
          && -z "$generacion" ]] \
          || error "Uso: scripts/korunix rollback --list [--json]."

        accion="list"
        ;;
      --plan)
        [[ "$modo" == "execute" ]] \
          || error "Uso: scripts/korunix rollback <id> --plan [--json]."

        modo="plan"
        ;;
      --yes)
        confirmado=true
        ;;
      --json)
        [[ "$formato" == "human" ]] \
          || error "Uso inválido: --json está repetido."

        formato="json"
        ;;
      -h|--help)
        cat <<'ROLLBACK_USAGE'
Uso:
  scripts/korunix rollback --list
  scripts/korunix rollback --list --json
  scripts/korunix rollback <id> --plan
  scripts/korunix rollback <id> --plan --json
  scripts/korunix rollback <id>
  scripts/korunix rollback <id> --yes
  scripts/korunix rollback <id> --yes --json

La recuperación segura programa una generación existente únicamente para el
próximo arranque. No cambia la sesión actual ni sustituye permanentemente la
generación predeterminada.

En UEFI Korunix usa systemd-boot.
En BIOS/Legacy Korunix usa GRUB.
ROLLBACK_USAGE
        return
        ;;
      -*)
        error "Opción de rollback desconocida: $argumento"
        ;;
      *)
        [[ "$argumento" =~ ^[0-9]+$ ]] \
          || error "ID de generación inválido: $argumento"

        [[ -z "$generacion" ]] \
          || error "Solo se puede elegir una generación."

        generacion="$argumento"
        ;;
    esac
  done

  if [[ "$accion" == "list" ]]; then
    [[ "$modo" == "execute" \
      && "$confirmado" == false \
      && -z "$generacion" ]] \
      || error "Uso: scripts/korunix rollback --list [--json]."

    if [[ "$formato" == "json" ]]; then
      recuperacion_generaciones_json
    else
      mostrar_generaciones
    fi

    return
  fi

  [[ -n "$generacion" ]] \
    || error "Indica una generación o usa rollback --list."

  if [[ "$modo" == "plan" \
    && "$confirmado" == true ]]
  then
    error "--yes no se utiliza junto con --plan."
  fi

  if [[ "$modo" == "execute" \
    && "$formato" == "json" \
    && "$confirmado" == false ]]
  then
    error "rollback --json necesita --yes porque no puede solicitar confirmación interactiva."
  fi

  plan="$(
    recuperacion_plan_json \
      "$generacion"
  )"

  if [[ "$modo" == "plan" ]]; then
    if [[ "$formato" == "json" ]]; then
      printf '%s\n' \
        "$plan"
    else
      mostrar_plan_recuperacion \
        "$plan"
    fi

    return
  fi

  if [[ "$formato" == "human" ]]; then
    mostrar_plan_recuperacion \
      "$plan"

    echo
  fi

  if [[ "$confirmado" == false ]]; then
    confirmar \
      "¿Usar el punto ${generacion} una vez en el próximo arranque?" \
      || return 0
  elif [[ "$formato" == "human" ]]; then
    echo "✓ Confirmación previa indicada mediante --yes"
  fi

  bootloader="$(
    jq -r \
      '.bootloader' \
      <<<"$plan"
  )"

  if [[ "$formato" == "json" ]]; then
    echo "Programando recuperación de un solo arranque..." >&2
  fi

  recuperacion_guardar_proteccion \
    "$generacion" \
    "$bootloader"

  case "$bootloader" in
    systemd-boot)
      entrada="$(
        recuperacion_programar_systemd_boot \
          "$generacion"
      )"
      ;;
    grub)
      entrada="$(
        recuperacion_programar_grub \
          "$generacion"
      )"
      ;;
    *)
      error "Cargador de recuperación desconocido: $bootloader"
      ;;
  esac

  resultado="$(
    recuperacion_resultado_json \
      "$plan" \
      "$entrada"
  )"

  if [[ "$formato" == "json" ]]; then
    printf '%s\n' \
      "$resultado"
    return
  fi

  echo
  echo "✓ RECUPERACIÓN PROGRAMADA"
  echo "Generación: $generacion"
  echo "Cargador: $bootloader"
  echo "Entrada: $entrada"
  echo "Se usará una sola vez en el próximo arranque."
  echo "La generación predeterminada no fue reemplazada."
}

# ---------------------------------------------------------------------------
# C.4 · Limpieza y almacenamiento
# ---------------------------------------------------------------------------

recuperacion_estado_directorio() {
  local state_root=""

  state_root="${XDG_STATE_HOME:-}"

  if [[ -z "$state_root" ]]; then
    state_root="$HOME/.local/state"
  fi

  printf '%s\n' \
    "$state_root/korunix/recovery"
}

recuperacion_guardar_proteccion() {
  local generacion="$1"
  local bootloader="$2"
  local directorio
  local temporal
  local boot_id
  local jq_bin

  [[ "$generacion" =~ ^[0-9]+$ ]] \
    || error "No puedo proteger una generación de recuperación inválida."

  jq_bin="$(command -v jq 2>/dev/null || true)"

  [[ -n "$jq_bin" ]] \
    || error "jq no está disponible."

  boot_id="$(
    cat /proc/sys/kernel/random/boot_id 2>/dev/null || true
  )"

  [[ -n "$boot_id" ]] \
    || error "No pude identificar el arranque actual."

  directorio="$(
    recuperacion_estado_directorio
  )"

  mkdir -p "$directorio"

  temporal="$(
    mktemp "$directorio/next-boot.json.XXXXXX"
  )"

  chmod 600 "$temporal"

  # Variables internas de jq.
  # shellcheck disable=SC2016
  if ! "$jq_bin" -n \
    --argjson generation "$generacion" \
    --arg bootloader "$bootloader" \
    --arg bootId "$boot_id" \
    '{
      schemaVersion: 1,
      kind: "korunix-recovery-protection",
      generation: $generation,
      bootloader: $bootloader,
      scheduledFromBootId: $bootId
    }' \
    >"$temporal"
  then
    rm -f "$temporal"
    error "No pude registrar la protección de recuperación."
  fi

  mv -f \
    "$temporal" \
    "$directorio/next-boot.json"
}

limpieza_generacion_recuperacion_programada() {
  local archivo
  local actual_boot
  local marker_boot
  local generacion
  local jq_bin

  jq_bin="$(command -v jq 2>/dev/null || true)"
  [[ -n "$jq_bin" ]] || return 0

  archivo="$(
    recuperacion_estado_directorio
  )/next-boot.json"

  [[ -r "$archivo" ]] || return 0

  actual_boot="$(
    cat /proc/sys/kernel/random/boot_id 2>/dev/null || true
  )"

  marker_boot="$(
    "$jq_bin" -r \
      '.scheduledFromBootId // empty' \
      "$archivo" \
      2>/dev/null \
      || true
  )"

  [[ -n "$actual_boot" \
    && "$marker_boot" == "$actual_boot" ]] \
    || return 0

  generacion="$(
    "$jq_bin" -r \
      '.generation // empty' \
      "$archivo" \
      2>/dev/null \
      || true
  )"

  [[ "$generacion" =~ ^[0-9]+$ ]] \
    || return 0

  [[ -e "${SYSTEM_PROFILE}-${generacion}-link" ]] \
    || return 0

  printf '%s\n' "$generacion"
}

operacion_progreso() {
  local formato="$1"
  local operacion="$2"
  local porcentaje="$3"
  local etapa="$4"
  local mensaje="$5"
  local jq_bin

  if [[ "$formato" == "json" ]]; then
    jq_bin="$(command -v jq 2>/dev/null || true)"
    [[ -n "$jq_bin" ]] || error "jq no está disponible."

    # Variables internas de jq.
    # shellcheck disable=SC2016
    "$jq_bin" -cn \
      --arg operation "$operacion" \
      --argjson percent "$porcentaje" \
      --arg stage "$etapa" \
      --arg message "$mensaje" \
      '{
        schemaVersion: 1,
        kind: "korunix-operation-progress",
        operation: $operation,
        percent: $percent,
        stage: $stage,
        message: $message
      }' \
      >&2
  else
    printf '[%3d%%] %s\n' \
      "$porcentaje" \
      "$mensaje"
  fi
}

limpieza_plan_json() {
  local modo="$1"
  local jq_bin
  local actual
  local generacion_actual
  local predeterminada
  local recuperacion
  local conservar_json
  local borrar_json
  local politica

  jq_bin="$(command -v jq 2>/dev/null || true)"
  [[ -n "$jq_bin" ]] || error "jq no está disponible."

  preparar_plan_limpieza "$modo"

  actual="$(ruta_actual)"
  generacion_actual="$(generacion_de_ruta "$actual")"
  predeterminada="$(generacion_predeterminada)"

  recuperacion="$(
    limpieza_generacion_recuperacion_programada
  )"

  conservar_json="$(
    printf '%s\n' \
      "${CONSERVAR_GENERACIONES[@]}" |
      "$jq_bin" -Rsc \
        'split("\n")
         | map(select(length > 0) | tonumber)'
  )"

  borrar_json="$(
    printf '%s\n' \
      "${BORRAR_GENERACIONES[@]}" |
      "$jq_bin" -Rsc \
        'split("\n")
         | map(select(length > 0) | tonumber)'
  )"

  case "$modo" in
    tres)
      politica="normal"
      ;;
    todas)
      politica="aggressive"
      ;;
    *)
      error "Modo de limpieza desconocido: $modo"
      ;;
  esac

  # Variables internas de jq.
  # shellcheck disable=SC2016
  "$jq_bin" -cn \
    --arg hostId "$HOST" \
    --arg policy "$politica" \
    --arg current "$generacion_actual" \
    --arg defaultGeneration "$predeterminada" \
    --arg scheduledRecovery "$recuperacion" \
    --argjson keep "$conservar_json" \
    --argjson delete "$borrar_json" \
    '{
      schemaVersion: 1,
      kind: "korunix-clean-plan",
      hostId: $hostId,
      policy: $policy,
      protected: {
        current: (
          if $current == ""
          then null
          else ($current | tonumber)
          end
        ),
        default: (
          if $defaultGeneration == ""
          then null
          else ($defaultGeneration | tonumber)
          end
        ),
        scheduledRecovery: (
          if $scheduledRecovery == ""
          then null
          else ($scheduledRecovery | tonumber)
          end
        )
      },
      keep: $keep,
      delete: $delete,
      cleanup: {
        garbageCollect: true,
        optimiseStore: true
      },
      progress: {
        approximateStageProgress: true,
        exactPendingBytes: false
      },
      actions: {
        planWritesSystem: false,
        executionNeedsPrivilege: true
      }
    }'
}

mostrar_plan_limpieza_humano() {
  local plan="$1"

  echo "=== Plan de limpieza ==="
  echo "Política: $(jq -r '.policy' <<<"$plan")"

  echo
  echo "Se conservarán:"

  jq -r \
    '.keep[] | "  • generación " + tostring' \
    <<<"$plan"

  echo
  echo "Se retirarían:"

  if [[ "$(jq -r '.delete | length' <<<"$plan")" -eq 0 ]]; then
    echo "  ninguna"
  else
    jq -r \
      '.delete[] | "  • generación " + tostring' \
      <<<"$plan"
  fi

  echo
  echo "La activa y la predeterminada están siempre protegidas."

  if [[ "$(
    jq -r \
      '.protected.scheduledRecovery // empty' \
      <<<"$plan"
  )" != "" ]]
  then
    echo "También está protegida la recuperación preparada para el próximo arranque."
  fi
}

limpieza_resultado_json() {
  local plan="$1"
  local mantenimiento="${2:-true}"

  case "$mantenimiento" in
    true|false)
      ;;
    *)
      error "Estado interno de mantenimiento inválido."
      ;;
  esac

  # Variables internas de jq.
  # shellcheck disable=SC2016
  jq -cn \
    --argjson plan "$plan" \
    --argjson maintenance "$mantenimiento" \
    '{
      schemaVersion: 1,
      kind: "korunix-clean-result",
      policy: $plan.policy,
      protected: $plan.protected,
      deleted: (
        if $maintenance
        then $plan.delete
        else []
        end
      ),
      completed: true,
      nothingToDo: (($plan.delete | length) == 0),
      garbageCollected: $maintenance,
      storeOptimised: $maintenance
    }'
}

limpieza_privilegiada() {
  local formato="$1"

  shift

  if [[ "$formato" == "json" ]]; then
    sudo "$@" >&2
  else
    sudo "$@"
  fi
}

almacenamiento_lista_json() {
  local datos

  datos="$(
    lsblk \
      -J \
      -p \
      -o PATH,TYPE,RM,HOTPLUG,TRAN,SIZE,MODEL,MOUNTPOINTS
  )"

  # $disk es una variable interna de jq.
  # shellcheck disable=SC2016
  jq -c '
    def truthy:
      . == true
      or . == 1
      or . == "1";

    def nodes:
      .,
      (.children[]? | nodes);

    [
      .blockdevices[]?
      | select(.type == "disk")
      | . as $disk
      | {
          device: .path,
          size: .size,
          model: (
            .model
            | if . == null
              then null
              else gsub("[[:space:]]+$"; "")
              end
          ),
          transport: .tran,
          removable: (
            (.rm | truthy)
            or (.hotplug | truthy)
            or .tran == "usb"
            or .tran == "mmc"
          ),
          mountPoints: (
            [
              $disk
              | nodes
              | .mountpoints[]?
              | select(
                  type == "string"
                  and length > 0
                )
            ]
            | unique
          )
        }
    ]
    | {
        schemaVersion: 1,
        kind: "korunix-storage-list",
        devices: .
      }
  ' <<<"$datos"
}

almacenamiento_disco_padre() {
  local dispositivo="$1"
  local tipo
  local disco

  tipo="$(
    lsblk -dnro TYPE -- "$dispositivo" |
      head -n 1
  )"

  [[ -n "$tipo" ]] \
    || error "No existe el dispositivo de bloques: $dispositivo"

  if [[ "$tipo" == "disk" ]]; then
    printf '%s\n' "$dispositivo"
    return
  fi

  disco="$(
    lsblk \
      -s \
      -nro PATH,TYPE \
      -- \
      "$dispositivo" |
      awk '
        $2 == "disk" {
          print $1
          exit
        }
      '
  )"

  [[ -n "$disco" ]] \
    || error "No pude determinar el disco físico de $dispositivo."

  printf '%s\n' "$disco"
}

almacenamiento_plan_json() {
  local dispositivo="$1"
  local pesado="$2"
  local seleccionado
  local tipo
  local disco
  local rm_flag=""
  local hotplug=""
  local transporte=""
  local removable=false
  local system_disk=false
  local mounts

  case "$pesado" in
    true|false)
      ;;
    *)
      error "Modo de transferencia pesada inválido."
      ;;
  esac

  seleccionado="$(
    readlink \
      -f \
      -- \
      "$dispositivo" \
      2>/dev/null \
      || printf '%s\n' "$dispositivo"
  )"

  tipo="$(
    lsblk -dnro TYPE -- "$seleccionado" |
      head -n 1
  )"

  [[ -n "$tipo" ]] \
    || error "No existe el dispositivo: $dispositivo"

  disco="$(
    almacenamiento_disco_padre \
      "$seleccionado"
  )"

  read -r \
    rm_flag \
    hotplug \
    transporte \
    < <(
      lsblk \
        -dnro RM,HOTPLUG,TRAN \
        -- \
        "$disco" |
        head -n 1
    )

  if [[ "$rm_flag" == "1" \
    || "$hotplug" == "1" \
    || "$transporte" == "usb" \
    || "$transporte" == "mmc" ]]
  then
    removable=true
  fi

  # $node es una variable interna de jq.
  # shellcheck disable=SC2016
  mounts="$(
    lsblk \
      -J \
      -p \
      -o PATH,MOUNTPOINTS \
      -- \
      "$disco" |
      jq -c '
        [
          ..
          | objects
          | select(
              has("path")
              and has("mountpoints")
            )
          | . as $node
          | (.mountpoints // [])[]?
          | select(
              type == "string"
              and length > 0
            )
          | {
              device: $node.path,
              mountPoint: .
            }
        ]
        | unique_by(
            .device + "\u0000" + .mountPoint
          )
        | sort_by(.mountPoint | length)
        | reverse
      '
  )"

  if jq -e '
    any(
      .[];
      .mountPoint == "/"
      or .mountPoint == "/nix"
      or .mountPoint == "/boot"
      or .mountPoint == "/boot/efi"
    )
  ' <<<"$mounts" \
    >/dev/null
  then
    system_disk=true
  fi

  [[ "$removable" == true ]] \
    || error "Korunix solo permite expulsar unidades extraíbles o hotplug."

  [[ "$system_disk" == false ]] \
    || error "Korunix nunca expulsará un disco que contenga el sistema en ejecución."

  # Variables internas de jq.
  # shellcheck disable=SC2016
  jq -cn \
    --arg hostId "$HOST" \
    --arg selected "$seleccionado" \
    --arg disk "$disco" \
    --arg transport "$transporte" \
    --argjson heavy "$pesado" \
    --argjson mounts "$mounts" \
    '{
      schemaVersion: 1,
      kind: "korunix-storage-eject-plan",
      hostId: $hostId,
      selectedDevice: $selected,
      disk: $disk,
      transport: (
        $transport
        | if . == "" then null else . end
      ),
      removable: true,
      systemDisk: false,
      mounts: $mounts,
      heavyTransferMode: $heavy,
      writeback: {
        globalSync: false,
        strategy: (
          if $heavy
          then "syncfs-per-filesystem"
          else "udisks-unmount-flush"
          end
        )
      },
      progress: {
        approximateStageProgress: true,
        exactPendingBytes: false
      },
      actions: {
        planWritesSystem: false,
        unmountsFilesystems: true,
        powersOffDevice: true,
        usesGlobalSync: false
      }
    }'
}

mostrar_plan_almacenamiento_humano() {
  local plan="$1"

  echo "=== Expulsión segura ==="
  echo "Disco: $(jq -r '.disk' <<<"$plan")"
  echo "Transporte: $(jq -r '.transport // "desconocido"' <<<"$plan")"

  echo
  echo "Sistemas de archivos montados:"

  if [[ "$(jq -r '.mounts | length' <<<"$plan")" -eq 0 ]]; then
    echo "  ninguno"
  else
    jq -r \
      '.mounts[]
       | "  • " + .device + " → " + .mountPoint' \
      <<<"$plan"
  fi

  echo

  if [[ "$(jq -r '.heavyTransferMode' <<<"$plan")" == true ]]; then
    echo "Modo de transferencia pesada: activado."
    echo "Korunix sincronizará cada sistema de archivos por separado."
  else
    echo "Modo normal: UDisks gestionará el vaciado asociado al desmontaje."
  fi

  echo "No se ejecutará un sync global."
}

almacenamiento_progreso() {
  local formato="$1"
  local porcentaje="$2"
  local etapa="$3"
  local mensaje="$4"

  operacion_progreso \
    "$formato" \
    "storage-eject" \
    "$porcentaje" \
    "$etapa" \
    "$mensaje"
}

almacenamiento_resultado_json() {
  local plan="$1"

  # $plan es una variable interna de jq.
  # shellcheck disable=SC2016
  jq -cn \
    --argjson plan "$plan" \
    '{
      schemaVersion: 1,
      kind: "korunix-storage-eject-result",
      disk: $plan.disk,
      heavyTransferMode: $plan.heavyTransferMode,
      unmounted: $plan.mounts,
      poweredOff: true,
      safeToDisconnect: true,
      writeback: $plan.writeback
    }'
}

almacenamiento_expulsar() {
  local dispositivo="$1"

  shift

  local formato="human"
  local modo="execute"
  local confirmado=false
  local pesado=false
  local argumento
  local plan
  local disco
  local mount_point
  local block_device
  local cantidad
  local indice
  local porcentaje
  local elementos=()
  local resultado

  [[ -n "$dispositivo" ]] \
    || error "Indica el dispositivo que quieres expulsar."

  for argumento in "$@"; do
    case "$argumento" in
      --plan)
        [[ "$modo" == "execute" ]] \
          || error "--plan está repetido."

        modo="plan"
        ;;
      --heavy)
        pesado=true
        ;;
      --yes)
        [[ "$confirmado" == false ]] \
          || error "--yes está repetido."

        confirmado=true
        ;;
      --json)
        [[ "$formato" == "human" ]] \
          || error "--json está repetido."

        formato="json"
        ;;
      *)
        error "Opción de almacenamiento desconocida: $argumento"
        ;;
    esac
  done

  if [[ "$modo" == "plan" \
    && "$confirmado" == true ]]
  then
    error "--yes no se utiliza junto con --plan."
  fi

  if [[ "$modo" == "execute" \
    && "$formato" == "json" \
    && "$confirmado" == false ]]
  then
    error "La expulsión JSON necesita --yes porque no puede solicitar confirmación interactiva."
  fi

  plan="$(
    almacenamiento_plan_json \
      "$dispositivo" \
      "$pesado"
  )"

  if [[ "$modo" == "plan" ]]; then
    if [[ "$formato" == "json" ]]; then
      printf '%s\n' "$plan"
    else
      mostrar_plan_almacenamiento_humano "$plan"
    fi

    return
  fi

  if [[ "$formato" == "human" ]]; then
    mostrar_plan_almacenamiento_humano "$plan"
    echo
  fi

  if [[ "$confirmado" == false ]]; then
    confirmar \
      "¿Expulsar esta unidad de forma segura?" \
      || return 0
  elif [[ "$formato" == "human" ]]; then
    echo "✓ Confirmación previa indicada mediante --yes"
  fi

  command -v udisksctl >/dev/null 2>&1 \
    || error "udisksctl no está disponible."

  disco="$(jq -r '.disk' <<<"$plan")"

  almacenamiento_progreso \
    "$formato" 5 identified \
    "Unidad identificada y validada"

  if [[ "$pesado" == true ]]; then
    mapfile -t elementos < <(
      jq -r '.mounts[].mountPoint' <<<"$plan"
    )

    cantidad="${#elementos[@]}"
    indice=0

    for mount_point in "${elementos[@]}"; do
      indice=$((indice + 1))
      porcentaje=$((20 + (indice * 30 / cantidad)))

      almacenamiento_progreso \
        "$formato" \
        "$porcentaje" \
        writeback \
        "Vaciando escrituras pendientes de $mount_point"

      sync -f "$mount_point"
    done
  else
    almacenamiento_progreso \
      "$formato" \
      20 \
      writeback \
      "El desmontaje seguro vaciará las escrituras pendientes"
  fi

  mapfile -t elementos < <(
    jq -r \
      '.mounts | map(.device) | unique[]' \
      <<<"$plan"
  )

  cantidad="${#elementos[@]}"
  indice=0

  for block_device in "${elementos[@]}"; do
    indice=$((indice + 1))
    porcentaje=$((60 + (indice * 20 / cantidad)))

    almacenamiento_progreso \
      "$formato" \
      "$porcentaje" \
      unmount \
      "Desmontando $block_device"

    if [[ "$formato" == "json" ]]; then
      udisksctl unmount -b "$block_device" >&2
    else
      udisksctl unmount -b "$block_device"
    fi
  done

  almacenamiento_progreso \
    "$formato" 90 power-off \
    "Apagando la unidad"

  if [[ "$formato" == "json" ]]; then
    udisksctl power-off -b "$disco" >&2
  else
    udisksctl power-off -b "$disco"
  fi

  almacenamiento_progreso \
    "$formato" 100 safe \
    "La unidad ya se puede desconectar"

  resultado="$(
    almacenamiento_resultado_json "$plan"
  )"

  if [[ "$formato" == "json" ]]; then
    printf '%s\n' "$resultado"
  else
    echo
    echo "✓ UNIDAD EXPULSADA DE FORMA SEGURA"
    echo "Ya puedes desconectarla físicamente."
  fi
}

gestionar_almacenamiento() {
  local accion="${1:-}"
  local dispositivo

  case "$accion" in
    --list)
      shift

      case "${1:-}" in
        "")
          almacenamiento_lista_json |
            jq -r '
              if (.devices | length) == 0
              then "No se detectaron unidades."
              else
                .devices[]
                | "• "
                  + .device
                  + " · "
                  + (.size // "?")
                  + " · "
                  + (.model // "sin modelo")
              end
            '
          ;;
        --json)
          [[ "$#" -eq 1 ]] \
            || error "Uso: storage --list [--json]."

          almacenamiento_lista_json
          ;;
        *)
          error "Uso: storage --list [--json]."
          ;;
      esac
      ;;
    eject)
      shift

      [[ "$#" -ge 1 ]] \
        || error "Uso: storage eject <dispositivo> [--plan] [--heavy] [--yes] [--json]."

      dispositivo="$1"
      shift

      almacenamiento_expulsar \
        "$dispositivo" \
        "$@"
      ;;
    -h|--help|"")
      cat <<'STORAGE_USAGE'
Uso:
  scripts/korunix storage --list
  scripts/korunix storage --list --json
  scripts/korunix storage eject <dispositivo> --plan
  scripts/korunix storage eject <dispositivo> --plan --json
  scripts/korunix storage eject <dispositivo>
  scripts/korunix storage eject <dispositivo> --heavy
  scripts/korunix storage eject <dispositivo> --yes --json

--heavy vacía explícitamente cada sistema de archivos antes de desmontar.
Korunix nunca ejecuta sync global.
STORAGE_USAGE
      ;;
    *)
      error "Acción de almacenamiento desconocida: $accion"
      ;;
  esac
}

preparar_plan_limpieza() {
  local modo="$1"
  local actual
  local generacion_actual
  local predeterminada
  local recuperacion
  local generacion
  local inicio
  local generaciones=()
  local -A protegidas=()

  BORRAR_GENERACIONES=()
  CONSERVAR_GENERACIONES=()

  actual="$(ruta_actual)"
  generacion_actual="$(generacion_de_ruta "$actual")"
  predeterminada="$(generacion_predeterminada)"

  recuperacion="$(
    limpieza_generacion_recuperacion_programada
  )"

  [[ -n "$generacion_actual" ]] \
    || error "La generación actual no aparece en el perfil. Korunix no limpiará nada."

  [[ -n "$predeterminada" ]] \
    || error "No pude determinar la generación predeterminada. Korunix no limpiará nada."

  mapfile -t generaciones < <(
    numeros_generaciones
  )

  protegidas["$generacion_actual"]=1
  protegidas["$predeterminada"]=1

  if [[ "$recuperacion" =~ ^[0-9]+$ ]]; then
    protegidas["$recuperacion"]=1
  fi

  case "$modo" in
    tres)
      inicio=$((${#generaciones[@]} - 3))
      (( inicio < 0 )) && inicio=0

      for generacion in "${generaciones[@]:$inicio}"; do
        protegidas["$generacion"]=1
      done
      ;;
    todas)
      ;;
    *)
      error "Modo de limpieza desconocido: $modo"
      ;;
  esac

  for generacion in "${generaciones[@]}"; do
    if [[ -n "${protegidas[$generacion]:-}" ]]; then
      CONSERVAR_GENERACIONES+=("$generacion")
    else
      BORRAR_GENERACIONES+=("$generacion")
    fi
  done
}

mostrar_plan_limpieza() {
  local modo="$1"
  local formato="${2:-}"
  local plan

  case "$formato" in
    ""|--json)
      ;;
    *)
      error "Uso: clean-preview [--json] o clean-all-preview [--json]."
      ;;
  esac

  plan="$(limpieza_plan_json "$modo")"

  if [[ "$formato" == "--json" ]]; then
    printf '%s\n' "$plan"
  else
    mostrar_plan_limpieza_humano "$plan"
  fi
}

limpiar() {
  local modo="$1"

  shift

  local formato="human"
  local confirmado=false
  local argumento
  local plan
  local resultado
  local generacion
  local palabra
  local borrar=()

  for argumento in "$@"; do
    case "$argumento" in
      --yes)
        [[ "$confirmado" == false ]] \
          || error "--yes está repetido."

        confirmado=true
        ;;
      --json)
        [[ "$formato" == "human" ]] \
          || error "--json está repetido."

        formato="json"
        ;;
      *)
        error "Opción de limpieza desconocida: $argumento"
        ;;
    esac
  done

  if [[ "$formato" == "json" \
    && "$confirmado" == false ]]
  then
    error "La limpieza JSON necesita --yes porque no puede solicitar confirmación interactiva."
  fi

  plan="$(limpieza_plan_json "$modo")"

  mapfile -t borrar < <(
    jq -r '.delete[]' <<<"$plan"
  )

  if [[ "$formato" == "human" ]]; then
    mostrar_plan_limpieza_humano "$plan"
  fi

  if [[ "${#borrar[@]}" -eq 0 ]]; then
    if [[ "$formato" == "json" ]]; then
      limpieza_resultado_json "$plan" false
    else
      echo
      echo "✓ No hay nada que limpiar."
    fi

    return
  fi

  if [[ "$confirmado" == false ]]; then
    echo

    if [[ "$modo" == "todas" ]]; then
      [[ -t 0 ]] \
        || error "clean-all necesita confirmación interactiva."

      echo "Esta limpieza conserva únicamente las generaciones protegidas."
      printf 'Escribe BORRAR para continuar: '
      read -r palabra

      if [[ "$palabra" != "BORRAR" ]]; then
        echo "Operación cancelada."
        return
      fi
    else
      confirmar \
        "¿Retirar esas generaciones?" \
        || return 0
    fi
  elif [[ "$formato" == "human" ]]; then
    echo
    echo "✓ Confirmación previa indicada mediante --yes"
  fi

  operacion_progreso \
    "$formato" clean 5 authorization \
    "Preparando autorización administrativa"

  limpieza_privilegiada "$formato" -v

  operacion_progreso \
    "$formato" clean 20 generations \
    "Retirando generaciones seleccionadas"

  for generacion in "${borrar[@]}"; do
    limpieza_privilegiada \
      "$formato" \
      nix-env \
      --profile "$SYSTEM_PROFILE" \
      --delete-generations "$generacion"
  done

  operacion_progreso \
    "$formato" clean 65 garbage-collection \
    "Recogiendo objetos sin referencias"

  limpieza_privilegiada \
    "$formato" \
    nix-collect-garbage

  operacion_progreso \
    "$formato" clean 90 store-optimisation \
    "Optimizando el almacén de Nix"

  limpieza_privilegiada \
    "$formato" \
    nix \
    store \
    optimise

  operacion_progreso \
    "$formato" clean 100 complete \
    "Limpieza terminada"

  resultado="$(
    limpieza_resultado_json "$plan" true
  )"

  if [[ "$formato" == "json" ]]; then
    printf '%s\n' "$resultado"
  else
    echo
    echo "✓ LIMPIEZA TERMINADA"
    mostrar_generaciones
  fi
}

canal_valido() {
  case "$1" in
    stable|unstable)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

canal_humano() {
  case "$1" in
    stable)
      printf '%s\n' "Estable"
      ;;
    unstable)
      printf '%s\n' "Inestable"
      ;;
    *)
      printf '%s\n' "$1"
      ;;
  esac
}

archivo_host_canal() {
  printf '%s/equipos/%s.nix\n' "$ROOT" "$HOST"
}

canal_declarado() {
  local archivo
  local canal

  archivo="$(archivo_host_canal)"

  [[ -f "$archivo" ]] \
    || error "No existe equipos/${HOST}.nix."

  canal="$(
    sed -n -E \
      's/^[[:space:]]*channel = "(stable|unstable)";$/\1/p' \
      "$archivo"
  )"

  [[ "$(printf '%s\n' "$canal" | grep -c .)" -eq 1 ]] \
    || error "equipos/${HOST}.nix debe declarar exactamente un canal."

  printf '%s\n' "$canal"
}

valor_catalogo_canal() {
  local canal="$1"
  local clave="$2"
  local jq_bin

  jq_bin="$(command -v jq 2>/dev/null || true)"
  [[ -n "$jq_bin" ]] || error "jq no está disponible."

  # $canal y $clave pertenecen a jq; Bash no debe expandirlos.
  # shellcheck disable=SC2016
  canales_json |
    "$jq_bin" -r \
      --arg canal "$canal" \
      --arg clave "$clave" \
      '.channels[$canal][$clave] // empty'
}

mostrar_canal_actual() {
  local canal
  local etiqueta
  local descripcion
  local nixpkgs_ref
  local aagl_ref
  local version

  canal="$(canal_declarado)"

  etiqueta="$(valor_catalogo_canal "$canal" label)"
  descripcion="$(valor_catalogo_canal "$canal" description)"
  nixpkgs_ref="$(valor_catalogo_canal "$canal" nixpkgs_ref)"
  aagl_ref="$(valor_catalogo_canal "$canal" aagl_ref)"

  [[ -n "$etiqueta" ]] || etiqueta="$(canal_humano "$canal")"

  version="$(
    nix eval \
      ".#nixosConfigurations.${HOST}.config.system.nixos.version" \
      --raw \
      2>/dev/null \
      || true
  )"

  echo "=== Canal de actualizaciones ==="
  echo "Equipo: $HOST"
  echo "Canal actual: $etiqueta"

  [[ -n "$descripcion" ]] \
    && echo "$descripcion"

  [[ -n "$version" ]] \
    && echo "NixOS efectivo: $version"

  [[ -n "$nixpkgs_ref" ]] \
    && echo "Nixpkgs: $nixpkgs_ref"

  [[ -n "$aagl_ref" ]] \
    && echo "AAGL: $aagl_ref"

  echo
  echo "system.stateVersion no cambia al cambiar de canal."
}

escribir_canal_host() {
  local canal="$1"
  local archivo
  local temporal

  canal_valido "$canal" \
    || error "Canal desconocido: $canal"

  archivo="$(archivo_host_canal)"
  temporal="$(mktemp "${archivo}.canal.XXXXXX")"

  if ! awk \
    -v channel="$canal" \
    '
      BEGIN {
        count = 0
      }

      {
        line = $0

        if ($0 ~ /^[[:space:]]+channel = "(stable|unstable)";$/) {
          sub(/channel = "(stable|unstable)";/, "channel = \"" channel "\";", line)

          count++
        }

        print line
      }

      END {
        if (count != 1) {
          exit 42
        }
      }
    ' \
    "$archivo" >"$temporal"
  then
    rm -f -- "$temporal"
    error "No pude actualizar de forma inequívoca el canal de ${HOST}."
  fi

  chmod --reference="$archivo" "$temporal"
  mv -f -- "$temporal" "$archivo"
}

restaurar_canal_temporal() {
  if [[ -n "${CANAL_TEMP_HOST:-}" \
    && -n "${CANAL_TEMP_BACKUP:-}" \
    && -f "$CANAL_TEMP_BACKUP" ]]
  then
    cp -p -- "$CANAL_TEMP_BACKUP" "$CANAL_TEMP_HOST" || true
    rm -f -- "$CANAL_TEMP_BACKUP" || true
  fi

  CANAL_TEMP_HOST=""
  CANAL_TEMP_BACKUP=""
}

evaluar_canal_objetivo() {
  local objetivo="$1"
  local actual
  local archivo
  local errores

  canal_valido "$objetivo" \
    || error "Canal desconocido: $objetivo"

  actual="$(canal_declarado)"
  archivo="$(archivo_host_canal)"

  if [[ "$objetivo" != "$actual" ]]; then
    CANAL_TEMP_HOST="$archivo"
    CANAL_TEMP_BACKUP="$(mktemp "${archivo}.evaluacion.XXXXXX")"

    cp -p -- "$archivo" "$CANAL_TEMP_BACKUP"

    trap 'restaurar_canal_temporal' EXIT
    trap 'restaurar_canal_temporal; exit 130' INT
    trap 'restaurar_canal_temporal; exit 143' TERM
    trap 'restaurar_canal_temporal; exit 129' HUP

    escribir_canal_host "$objetivo"
  fi

  errores="$(mktemp)"

  if ! CANAL_PLAN_VERSION="$(
    nix eval \
      ".#nixosConfigurations.${HOST}.config.system.nixos.version" \
      --raw \
      2>"$errores"
  )"
  then
    cat "$errores" >&2
    rm -f -- "$errores"

    restaurar_canal_temporal
    trap - EXIT INT TERM HUP

    error "El host no evalúa correctamente con $(canal_humano "$objetivo")."
  fi

  : >"$errores"

  if ! CANAL_PLAN_DRV="$(
    nix eval \
      ".#nixosConfigurations.${HOST}.config.system.build.toplevel.drvPath" \
      --raw \
      2>"$errores"
  )"
  then
    cat "$errores" >&2
    rm -f -- "$errores"

    restaurar_canal_temporal
    trap - EXIT INT TERM HUP

    error "No pude evaluar la derivación con $(canal_humano "$objetivo")."
  fi

  rm -f -- "$errores"

  if [[ "$objetivo" != "$actual" ]]; then
    restaurar_canal_temporal
    trap - EXIT INT TERM HUP

    [[ "$(canal_declarado)" == "$actual" ]] \
      || error "La evaluación temporal no restauró el canal original."
  fi
}

mostrar_plan_canal() {
  local objetivo="$1"
  local actual
  local etiqueta_actual
  local etiqueta_objetivo
  local descripcion
  local nixpkgs_ref
  local aagl_ref

  canal_valido "$objetivo" \
    || error "Canal desconocido: $objetivo"

  actual="$(canal_declarado)"

  etiqueta_actual="$(canal_humano "$actual")"
  etiqueta_objetivo="$(canal_humano "$objetivo")"

  descripcion="$(valor_catalogo_canal "$objetivo" description)"
  nixpkgs_ref="$(valor_catalogo_canal "$objetivo" nixpkgs_ref)"
  aagl_ref="$(valor_catalogo_canal "$objetivo" aagl_ref)"

  echo "=== Plan de cambio de canal ==="
  echo "Equipo: $HOST"
  echo "Actual: $etiqueta_actual"
  echo "Objetivo: $etiqueta_objetivo"

  [[ -n "$descripcion" ]] \
    && echo "$descripcion"

  echo
  echo "Fuentes que utilizaría:"

  [[ -n "$nixpkgs_ref" ]] \
    && echo "  Nixpkgs: $nixpkgs_ref"

  [[ -n "$aagl_ref" ]] \
    && echo "  AAGL: $aagl_ref"

  echo
  echo "Evaluando el sistema sin aplicar ninguna generación..."

  evaluar_canal_objetivo "$objetivo"

  echo "✓ Evaluación correcta"
  echo "NixOS resultante: $CANAL_PLAN_VERSION"
  echo "Derivación: $CANAL_PLAN_DRV"

  if [[ "$objetivo" == "$actual" ]]; then
    echo
    echo "No hay cambio: ese canal ya está declarado."
  else
    echo
    echo "Este plan no modificó equipos/${HOST}.nix."
    echo "No se construyó ni aplicó ninguna generación."
  fi
}

cambiar_canal() {
  local objetivo="$1"
  local modo="${2:-}"
  local actual
  local respaldo
  local marca

  canal_valido "$objetivo" \
    || error "Canal desconocido: $objetivo"

  case "$modo" in
    ""|--yes)
      ;;
    --plan)
      mostrar_plan_canal "$objetivo"
      return
      ;;
    *)
      error "Uso: scripts/korunix channel <stable|unstable> [--plan|--yes]."
      ;;
  esac

  actual="$(canal_declarado)"

  mostrar_plan_canal "$objetivo"

  if [[ "$objetivo" == "$actual" ]]; then
    return
  fi

  if [[ "$modo" != "--yes" ]]; then
    [[ -t 0 ]] \
      || error "El cambio de canal necesita confirmación interactiva o --yes."

    echo

    confirmar \
      "¿Cambiar ${HOST} de $(canal_humano "$actual") a $(canal_humano "$objetivo")?" \
      || return 0
  fi

  marca="$(date +%Y%m%d-%H%M%S)-$$"
  respaldo="${XDG_STATE_HOME:-$HOME/.local/state}/korunix/backups/canal-${HOST}-${actual}-a-${objetivo}-${marca}"

  mkdir -p "$respaldo/hosts"
  cp -p -- "$(archivo_host_canal)" "$respaldo/equipos/${HOST}.nix"

  escribir_canal_host "$objetivo"

  echo
  echo "Validando la nueva declaración..."

  if validar; then
    echo
    echo "========================================"
    echo " CANAL PREPARADO"
    echo "========================================"
    echo "Equipo: $HOST"
    echo "Canal: $(canal_humano "$objetivo")"
    echo "✓ La declaración cambió"
    echo "✓ La configuración evalúa correctamente"
    echo "✓ flake.lock no necesita reescribirse"
    echo "✓ No se aplicó ninguna generación"
    echo
    echo "Para revisar el cambio antes de aplicarlo:"
    echo "  scripts/korunix preview"
    echo
    echo "Para aplicarlo posteriormente:"
    echo "  scripts/korunix apply"
    echo
    echo "Respaldo: $respaldo"
    return
  fi

  echo >&2
  echo "ERROR: la nueva declaración no superó la validación." >&2
  echo "Restaurando el canal anterior..." >&2

  cp -p -- \
    "$respaldo/equipos/${HOST}.nix" \
    "$(archivo_host_canal)"

  echo "✓ Canal anterior restaurado" >&2

  error "El cambio de canal fue revertido antes de aplicar."
}

mostrar_canal_actual_json() {
  local canal
  local etiqueta
  local descripcion
  local nixpkgs_ref
  local aagl_ref
  local efectivo
  local version
  local state_version
  local stable_label
  local stable_description
  local stable_label_en
  local stable_description_en
  local stable_label_hu
  local stable_description_hu
  local stable_nixpkgs
  local stable_aagl
  local unstable_label
  local unstable_description
  local unstable_label_en
  local unstable_description_en
  local unstable_label_hu
  local unstable_description_hu
  local unstable_nixpkgs
  local unstable_aagl
  local jq_bin

  canal="$(canal_declarado)"
  etiqueta="$(valor_catalogo_canal "$canal" label)"
  descripcion="$(valor_catalogo_canal "$canal" description)"
  nixpkgs_ref="$(valor_catalogo_canal "$canal" nixpkgs_ref)"
  aagl_ref="$(valor_catalogo_canal "$canal" aagl_ref)"

  efectivo="$(
    nix eval \
      ".#nixosConfigurations.${HOST}.config.korunix.channel" \
      --raw
  )"

  version="$(
    nix eval \
      ".#nixosConfigurations.${HOST}.config.system.nixos.version" \
      --raw
  )"

  state_version="$(
    nix eval \
      ".#nixosConfigurations.${HOST}.config.system.stateVersion" \
      --raw
  )"

  stable_label="$(valor_catalogo_canal stable label)"
  stable_description="$(valor_catalogo_canal stable description)"
  stable_label_en="$(valor_catalogo_canal stable label_en)"
  stable_description_en="$(valor_catalogo_canal stable description_en)"
  stable_label_hu="$(valor_catalogo_canal stable label_hu)"
  stable_description_hu="$(valor_catalogo_canal stable description_hu)"
  stable_nixpkgs="$(valor_catalogo_canal stable nixpkgs_ref)"
  stable_aagl="$(valor_catalogo_canal stable aagl_ref)"

  unstable_label="$(valor_catalogo_canal unstable label)"
  unstable_description="$(valor_catalogo_canal unstable description)"
  unstable_label_en="$(valor_catalogo_canal unstable label_en)"
  unstable_description_en="$(valor_catalogo_canal unstable description_en)"
  unstable_label_hu="$(valor_catalogo_canal unstable label_hu)"
  unstable_description_hu="$(valor_catalogo_canal unstable description_hu)"
  unstable_nixpkgs="$(valor_catalogo_canal unstable nixpkgs_ref)"
  unstable_aagl="$(valor_catalogo_canal unstable aagl_ref)"

  jq_bin="$(command -v jq 2>/dev/null || true)"

  [[ -n "$jq_bin" ]] \
    || error "jq no está disponible para producir el modelo JSON de canales."

  # Las variables $hostId, $declared, etc. pertenecen a jq, no a Bash.
  # shellcheck disable=SC2016
  "$jq_bin" -n \
    --arg hostId "$HOST" \
    --arg declared "$canal" \
    --arg effective "$efectivo" \
    --arg label "$etiqueta" \
    --arg description "$descripcion" \
    --arg nixosVersion "$version" \
    --arg stateVersion "$state_version" \
    --arg nixpkgs "$nixpkgs_ref" \
    --arg aagl "$aagl_ref" \
    --arg stableLabel "$stable_label" \
    --arg stableDescription "$stable_description" \
    --arg stableLabelEn "$stable_label_en" \
    --arg stableDescriptionEn "$stable_description_en" \
    --arg stableLabelHu "$stable_label_hu" \
    --arg stableDescriptionHu "$stable_description_hu" \
    --arg stableNixpkgs "$stable_nixpkgs" \
    --arg stableAagl "$stable_aagl" \
    --arg unstableLabel "$unstable_label" \
    --arg unstableDescription "$unstable_description" \
    --arg unstableLabelEn "$unstable_label_en" \
    --arg unstableDescriptionEn "$unstable_description_en" \
    --arg unstableLabelHu "$unstable_label_hu" \
    --arg unstableDescriptionHu "$unstable_description_hu" \
    --arg unstableNixpkgs "$unstable_nixpkgs" \
    --arg unstableAagl "$unstable_aagl" \
    '{
      schemaVersion: 1,
      hostId: $hostId,
      declared: $declared,
      effective: $effective,
      label: $label,
      description: $description,
      nixosVersion: $nixosVersion,
      stateVersion: $stateVersion,
      stateVersionIndependent: true,
      sources: {
        nixpkgs: $nixpkgs,
        aagl: $aagl
      },
      options: [
        {
          id: "stable",
          labels: {
            es: $stableLabel,
            en: $stableLabelEn,
            hu: $stableLabelHu
          },
          descriptions: {
            es: $stableDescription,
            en: $stableDescriptionEn,
            hu: $stableDescriptionHu
          },
          sources: {
            nixpkgs: $stableNixpkgs,
            aagl: $stableAagl
          }
        },
        {
          id: "unstable",
          labels: {
            es: $unstableLabel,
            en: $unstableLabelEn,
            hu: $unstableLabelHu
          },
          descriptions: {
            es: $unstableDescription,
            en: $unstableDescriptionEn,
            hu: $unstableDescriptionHu
          },
          sources: {
            nixpkgs: $unstableNixpkgs,
            aagl: $unstableAagl
          }
        }
      ]
    }'
}

mostrar_plan_canal_json() {
  local objetivo="$1"
  local actual
  local etiqueta
  local descripcion
  local nixpkgs_ref
  local aagl_ref
  local changed
  local jq_bin

  canal_valido "$objetivo" \
    || error "Canal desconocido: $objetivo"

  actual="$(canal_declarado)"
  etiqueta="$(canal_humano "$objetivo")"
  descripcion="$(valor_catalogo_canal "$objetivo" description)"
  nixpkgs_ref="$(valor_catalogo_canal "$objetivo" nixpkgs_ref)"
  aagl_ref="$(valor_catalogo_canal "$objetivo" aagl_ref)"

  evaluar_canal_objetivo "$objetivo"

  if [[ "$objetivo" == "$actual" ]]; then
    changed=false
  else
    changed=true
  fi

  jq_bin="$(command -v jq 2>/dev/null || true)"

  [[ -n "$jq_bin" ]] \
    || error "jq no está disponible para producir el plan JSON de canales."

  # Las variables $current, $target, etc. pertenecen a jq, no a Bash.
  # shellcheck disable=SC2016
  "$jq_bin" -n \
    --arg hostId "$HOST" \
    --arg current "$actual" \
    --arg target "$objetivo" \
    --arg targetLabel "$etiqueta" \
    --arg description "$descripcion" \
    --arg nixosVersion "$CANAL_PLAN_VERSION" \
    --arg drvPath "$CANAL_PLAN_DRV" \
    --arg nixpkgs "$nixpkgs_ref" \
    --arg aagl "$aagl_ref" \
    --argjson changed "$changed" \
    '{
      schemaVersion: 1,
      hostId: $hostId,
      current: $current,
      target: $target,
      targetLabel: $targetLabel,
      description: $description,
      changed: $changed,
      valid: true,
      nixosVersion: $nixosVersion,
      drvPath: $drvPath,
      sources: {
        nixpkgs: $nixpkgs,
        aagl: $aagl
      },
      modifiesHost: false,
      buildsGeneration: false,
      appliesGeneration: false
    }'
}

gestionar_canal() {
  local accion="${1:-}"
  local extra="${2:-}"
  local formato="${3:-}"

  case "$accion" in
    "")
      mostrar_canal_actual
      ;;

    --json)
      [[ "$#" -eq 1 ]] \
        || error "Uso: scripts/korunix channel --json."

      mostrar_canal_actual_json
      ;;

    stable|unstable)
      [[ "$#" -le 3 ]] \
        || error "Uso: scripts/korunix channel <stable|unstable> [--plan [--json]|--yes]."

      if [[ "$extra" == "--plan" && "$formato" == "--json" ]]; then
        mostrar_plan_canal_json "$accion"
        return
      fi

      [[ -z "$formato" ]] \
        || error "Solo --plan admite una salida --json."

      cambiar_canal "$accion" "$extra"
      ;;

    -h|--help)
      cat <<'CHANNEL_USAGE'
Uso:
  scripts/korunix channel
      Mostrar el canal actual y sus fuentes.

  scripts/korunix channel stable --plan
  scripts/korunix channel unstable --plan
      Evaluar otro canal sin modificar el host ni aplicar una generación.

  scripts/korunix channel stable
  scripts/korunix channel unstable
      Mostrar el plan, pedir confirmación y cambiar únicamente la declaración.

  scripts/korunix channel stable --yes
  scripts/korunix channel unstable --yes
      Igual que el cambio anterior, pero la confirmación ya fue realizada por
      una interfaz superior como la GUI de Korunix.

Cambiar el canal nunca modifica system.stateVersion y nunca aplica
automáticamente una generación.
CHANNEL_USAGE
      ;;

    *)
      error "Uso: scripts/korunix channel [--json | stable|unstable [--plan|--yes]]."
      ;;
  esac
}


case "${1:-}" in
  bootstrap)
    shift
    gestionar_bootstrap "$@"
    ;;

  users)
    KORUNIX_HOST="$HOST" "$ROOT/scripts/users" "${@:2}"
    ;;

  hardware)
    mostrar_hardware "${2:-}"
    ;;

  localization)
    KORUNIX_HOST="$HOST" "$ROOT/scripts/localization" "${@:2}"
    ;;

  channel)
    shift
    gestionar_canal "$@"
    ;;

  status)
    estado
    ;;

  structure)
    estructura
    ;;

  validate)
    validar
    ;;

  format)
    formatear
    ;;

  recovery|generations)
    mostrar_generaciones
    ;;

  preview)
    shift
    previsualizar "$@"
    ;;

  build)
    shift
    construir "$@"
    ;;

  apply)
    shift
    aplicar "$@"
    ;;

  update)
    shift
    actualizar "$@"
    ;;

  rollback)
    shift
    rollback_generacion "$@"
    ;;

  privileges)
    shift
    case "${1:-}" in
      "")
        privilegios_json | jq .
        ;;
      --json)
        [[ "$#" -eq 1 ]] || error "Uso: privileges [--json]."
        privilegios_json
        ;;
      *)
        error "Uso: privileges [--json]."
        ;;
    esac
    ;;

  media)
    shift
    gestionar_media "$@"
    ;;

  firmware)
    shift
    gestionar_firmware "$@"
    ;;

  storage)
    shift
    gestionar_almacenamiento "$@"
    ;;

  clean-preview)
    shift
    mostrar_plan_limpieza tres "$@"
    ;;

  clean-all-preview)
    shift
    mostrar_plan_limpieza todas "$@"
    ;;

  clean)
    shift
    limpiar tres "$@"
    ;;

  clean-all)
    shift
    limpiar todas "$@"
    ;;

  "")
    cat <<'USAGE'
Korunix

Primera adopción:
  scripts/korunix bootstrap --plan
      Inspeccionar el NixOS instalado antes de crear un host Korunix.

  scripts/korunix bootstrap --plan --json
      Exponer el mismo plan como contrato estructurado.

  scripts/korunix bootstrap --adopt
      Preparar Korunix desde la instalación existente después de confirmar el plan.

  scripts/korunix bootstrap --adopt --yes
      Preparar la misma adopción cuando la confirmación ya se realizó externamente.

Estado y comprobación:
  scripts/korunix users
      Mostrar las personas reales, perfiles Korunix y estado de adopción.

  scripts/korunix users --json
      Exponer el mismo modelo de identidad en JSON para la GUI futura.

  scripts/korunix users adopt <cuenta>
      Preparar declarativamente una cuenta existente sin tocar su contraseña.

  scripts/korunix users create
      Preparar interactivamente una cuenta nueva y su rol.

  scripts/korunix users password <cuenta>
      Entregar el cambio de contraseña directamente a passwd sin guardar secretos.

  scripts/korunix users export <id>
      Exportar una identidad portable con avatar, preferencias y capacidades.

  scripts/korunix users inspect <archivo>
      Inspeccionar un perfil portable sin modificar el equipo.

  scripts/korunix users plan <archivo>
      Calcular en JSON cómo se integraría ese perfil en este equipo.

  scripts/korunix users import <archivo>
      Preparar la importación después de mostrar y confirmar el plan.

  scripts/korunix hardware
      Detectar localmente el hardware y comprobar que los hechos adoptados por
      Korunix siguen coincidiendo con la máquina real.

  scripts/korunix hardware --json
      Exponer el mismo modelo de hardware en JSON para interfaces y automatización.

  scripts/korunix localization
      Mostrar idioma, región, formatos, zona horaria y teclado de este equipo.

  scripts/korunix localization --json
      Exponer el modelo de localización y sus contradicciones para la GUI futura.

  scripts/korunix channel
      Mostrar el canal actual, la versión efectiva y las fuentes asociadas.

  scripts/korunix channel --json
      Exponer el mismo estado como datos estructurados para interfaces.

  scripts/korunix channel stable --plan
      Evaluar Estable sin modificar el host ni aplicar ninguna generación.

  scripts/korunix channel stable
      Mostrar el plan, confirmar y cambiar únicamente la declaración del host.

  scripts/korunix channel stable --yes
      Realizar el mismo cambio cuando una interfaz superior ya confirmó la acción.

  scripts/korunix status
      Ver el estado local del repositorio y del sistema sin usar Internet.

  scripts/korunix recovery
      Mostrar los puntos de recuperación disponibles y su estado.

  scripts/korunix generations
      Alias técnico de recovery para compatibilidad con el flujo anterior.

  scripts/korunix validate
      Comprobar estructura, Git, flake y todos los hosts sin aplicar.

Preparar y aplicar:
  scripts/korunix preview
      Construir y enseñar qué cambiaría sin activar nada. La inspección real de
      servicios pide autorización administrativa, pero no modifica el sistema.

  scripts/korunix preview --json
      Exponer la misma previsualización como contrato estructurado.

  scripts/korunix build
      Construir la generación completa sin activarla.

  scripts/korunix build --json
      Construir y devolver la generación candidata como contrato estructurado.

  scripts/korunix apply
      Validar, construir, previsualizar, confirmar, aplicar y verificar.

  scripts/korunix apply --yes
      Ejecutar el mismo ciclo cuando una interfaz superior ya confirmó.

  scripts/korunix apply --yes --json
      Aplicar tras confirmación externa y devolver el resultado estructurado.

Actualizaciones:
  scripts/korunix update --plan
      Explicar qué fuentes se actualizarían sin escribir nada.

  scripts/korunix update --plan --json
      Exponer el mismo plan como contrato estructurado para la GUI.

  scripts/korunix update
      Actualizar todas las fuentes, respaldar flake.lock y validar.

  scripts/korunix update noctalia
      Actualizar únicamente una entrada concreta.

  scripts/korunix update nixpkgs noctalia
      Actualizar varias entradas concretas.

  scripts/korunix update --json
      Preparar la actualización y devolver el resultado estructurado.

Recuperación:
  scripts/korunix rollback --list
      Mostrar las generaciones disponibles.

  scripts/korunix rollback --list --json
      Exponer las generaciones como contrato estructurado.

  scripts/korunix rollback <id> --plan
      Explicar el arranque de recuperación sin programarlo.

  scripts/korunix rollback <id> --plan --json
      Exponer el mismo plan para la GUI.

  scripts/korunix rollback <id>
      Confirmar y usar esa generación una vez en el próximo arranque.

  scripts/korunix rollback <id> --yes --json
      Programar el arranque ya confirmado por una interfaz superior.

Limpieza:
  scripts/korunix clean-preview
  scripts/korunix clean-preview --json
  scripts/korunix clean
  scripts/korunix clean --yes --json
  scripts/korunix clean-all-preview
  scripts/korunix clean-all-preview --json
  scripts/korunix clean-all
  scripts/korunix clean-all --yes --json

Almacenamiento extraíble:
  scripts/korunix storage --list
  scripts/korunix storage --list --json
  scripts/korunix storage eject <dispositivo> --plan
  scripts/korunix storage eject <dispositivo> --plan --json
  scripts/korunix storage eject <dispositivo>
  scripts/korunix storage eject <dispositivo> --heavy
  scripts/korunix storage eject <dispositivo> --yes --json

Firmware:
  scripts/korunix firmware devices --json
  scripts/korunix firmware updates --json
  scripts/korunix firmware refresh --plan --json
  scripts/korunix firmware refresh --yes --json
  scripts/korunix firmware update <device-id> --plan --json
  scripts/korunix firmware update <device-id> --yes --json

Privilegios:
  scripts/korunix privileges --json
      Exponer la frontera administrativa que deben consumir CLI y GUI.

Multimedia:
  scripts/korunix media status --json
      Estado común de audio y cámaras para CLI y GUI.

  scripts/korunix media audio list --json
      Salidas, entradas, volumen, silencio, perfiles y puertos.

  scripts/korunix media audio test-output <sink-id> --yes --json
      Probar una salida concreta sin hacerla predeterminada.

  scripts/korunix media mic meter <source-id> --yes --json
      Emitir muestras de nivel de un micrófono durante una prueba explícita.

  scripts/korunix media mic test <source-id> --yes --json
      Grabar, reproducir y eliminar una muestra temporal.

  scripts/korunix media camera list --json
      Inventario V4L2 con resoluciones y FPS anunciados.

  scripts/korunix media camera preview <device> --plan --json
      Plan de previsualización sin abrir la cámara.

Si existen varios hosts y el nombre actual no coincide con uno de ellos:
  KORUNIX_HOST=mi-equipo scripts/korunix status
USAGE
    ;;

  *)
    error "Acción desconocida: $1"
    ;;
esac
