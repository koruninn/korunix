#!/usr/bin/env bash
set -euo pipefail
# KORUNIX-COMPAT-WRAPPER

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"

if [[ -n "${KORUNIX_MOTOR_BIN:-}" && -x "${KORUNIX_MOTOR_BIN}" ]]; then
  exec "${KORUNIX_MOTOR_BIN}" "$@"
fi

if [[ -x "$ROOT/target/debug/korunix" ]]; then
  exec "$ROOT/target/debug/korunix" "$@"
fi

if command -v cargo >/dev/null 2>&1; then
  cd "$ROOT"
  exec cargo run --quiet --locked --bin korunix -- "$@"
fi

printf 'ERROR: no encuentro el motor Rust de Korunix.\n' >&2
exit 1
