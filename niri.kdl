// Niri usa Noctalia para launcher, controles, bloqueo y capturas.
// Alacritty es la terminal y Nautilus abre los archivos.

// Estas partes dependen del equipo y de configuracion.toml.
include optional=true "/etc/korunix/niri-output.kdl"
include optional=true "/etc/korunix/niri-input.kdl"

input {
    touchpad {
        tap
        natural-scroll
    }

    warp-mouse-to-focus
    focus-follows-mouse
}

hotkey-overlay {
    skip-at-startup
}

prefer-no-csd

binds {
    // Noctalia.
    Mod+Space { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+S { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
    Mod+Comma { spawn "noctalia" "msg" "settings-toggle"; }
    Mod+L { spawn "noctalia" "msg" "session" "lock"; }

    // Print selecciona una región.
    Print { spawn "noctalia" "msg" "screenshot-region"; }

    // Ctrl+Print captura el monitor en uso.
    Ctrl+Print { spawn "noctalia" "msg" "screenshot-fullscreen"; }

    // Shift+Print guarda todos los monitores en una sola captura.
    Shift+Print { spawn "noctalia" "msg" "screenshot-fullscreen" "all"; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioMute allow-when-locked=true { spawn "noctalia" "msg" "volume-mute"; }
    XF86AudioMicMute allow-when-locked=true { spawn "noctalia" "msg" "mic-mute"; }

    XF86AudioPlay allow-when-locked=true { spawn "noctalia" "msg" "media" "toggle"; }
    XF86AudioStop allow-when-locked=true { spawn "noctalia" "msg" "media" "stop"; }
    XF86AudioPrev allow-when-locked=true { spawn "noctalia" "msg" "media" "previous"; }
    XF86AudioNext allow-when-locked=true { spawn "noctalia" "msg" "media" "next"; }

    XF86MonBrightnessUp allow-when-locked=true { spawn "noctalia" "msg" "brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "noctalia" "msg" "brightness-down"; }

    Mod+T { spawn "alacritty"; }
    Mod+E { spawn "nautilus"; }

    Mod+O repeat=false { toggle-overview; }
    Mod+Q repeat=false { close-window; }

    Mod+Left { focus-column-left; }
    Mod+Down { focus-window-down; }
    Mod+Up { focus-window-up; }
    Mod+Right { focus-column-right; }

    Mod+Ctrl+Left { move-column-left; }
    Mod+Ctrl+Down { move-window-down; }
    Mod+Ctrl+Up { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }

    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up { focus-workspace-up; }

    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up { move-column-to-workspace-up; }

    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+V { toggle-window-floating; }
    Mod+R { switch-preset-column-width; }

    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    Mod+Shift+E { quit; }
    Ctrl+Alt+Delete { quit; }
}
